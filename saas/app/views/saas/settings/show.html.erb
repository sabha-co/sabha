<% content_for :title, "Settings" %>

<% if @workspace_access_denied %>
  <div role="alert" class="settings-banner">
    <div class="settings-banner__inner">
      You no longer have access to that workspace.
    </div>
  </div>
<% end %>

<div class="saas-settings settings-layout">
  <%# Workspaces Section %>
  <div class="panel">
    <section class="settings__section">
      <header>
        <h2 class="divider">Your Workspaces</h2>
      </header>

      <% if @workspace_memberships.any? %>
        <div class="flex flex-column gap-half">
          <% @workspace_memberships.each do |membership| %>
            <% workspace = membership.workspace %>

            <%= link_to settings_path(script_name: workspace.slug),
                  class: "flex align-center justify-space-between pad-block-half pad-inline gap txt-undecorated" do %>
              <div class="flex align-center gap">
                <div class="workspace-initial" style="<%= workspace_gradient_style(workspace) unless workspace.has_logo? %>">
                  <% if workspace.has_logo? %>
                    <%= image_tag workspace_logo_url(workspace), alt: "", class: "workspace-initial__logo" %>
                  <% else %>
                    <%= workspace.name.first.upcase %>
                  <% end %>
                </div>
                <div class="flex flex-column">
                  <strong><%= workspace.name %></strong>
                  <span class="txt-small txt-muted"><%= workspace_role_label(membership) %></span>
                </div>
              </div>
              <%= icon_tag "arrow-right", class: "txt-muted" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="txt-small txt-muted">Start by creating your first workspace.</p>
      <% end %>

      <div class="flex justify-center">
        <%= link_to new_workspace_path, class: "btn btn--reversed" do %>
          <%= icon_tag "add" %>
          <span>Create workspace</span>
        <% end %>
      </div>
    </section>
  </div>

  <%# Account Section %>
  <div class="panel">
    <div class="flex flex-column gap">
      <section class="settings__section">
        <header>
          <h2 class="divider">Account</h2>
        </header>

        <p class="txt-small txt-muted">
          <%= current_global_identity.email_address %>
        </p>

        <div class="flex justify-center">
          <%= link_to session_path, data: { turbo_method: :delete }, class: "btn txt-small" do %>
            Sign out
          <% end %>
        </div>
      </section>

      <%= form_with model: @global_identity, url: settings_path, method: :patch, class: "flex flex-column gap", html: { autocomplete: "off" } do |form| %>
        <section class="settings__section">
          <header>
            <h2 class="divider">Change email</h2>
          </header>

          <% if @global_identity.errors[:email_address].any? %>
            <p class="txt-small txt-negative"><%= @global_identity.errors[:email_address].first %></p>
          <% end %>

          <label class="flex align-center gap input input--actor">
            <%= form.email_field :email_address, required: true, class: "input", placeholder: "your.email@example.com", autocomplete: "email" %>
          </label>

          <p class="txt-small txt-muted">
            Changing your email will require re-verification.
          </p>

          <div class="flex justify-center">
            <%= form.button class: "btn", type: "submit" do %>
              Save changes
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</div>
