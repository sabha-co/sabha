<%# locals: (membership:, pairing_request:) %>
<%# A self-hosted workspace: its row opens its own site, and its actions sit in the ⋯ menu %>
<% remote_workspace = membership.remote_workspace %>
<% paired_by_me = remote_workspace.paired_by?(current_global_identity) %>

<div class="flex align-center justify-space-between pad-block-half pad-inline gap">
  <%= link_to remote_workspace.origin, class: "flex align-center gap txt-undecorated min-width", data: { turbo: false } do %>
    <%= render "saas/remote_workspaces/logo", remote_workspace: remote_workspace %>
    <div class="flex flex-column min-width">
      <strong><%= remote_workspace.name %></strong>
      <span class="txt-small txt-muted">Self-hosted · <%= remote_workspace.address %></span>

      <% if membership.consented? || remote_workspace.pairing_active? || remote_workspace.unreachable? || membership.hidden? %>
        <span class="list-tags">
          <% if membership.consented? %>
            <span class="list-tag list-tag--positive">You sign in with sabha.co</span>
          <% elsif remote_workspace.pairing_active? %>
            <span class="list-tag list-tag--positive">Continue with sabha.co</span>
          <% end %>
          <% if remote_workspace.unreachable? %><span class="list-tag list-tag--negative">Unreachable</span><% end %>
          <% if membership.hidden? %><span class="list-tag">Hidden</span><% end %>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="flex align-center gap-half flex-item-no-shrink">
    <% if pairing_request %>
      <%= link_to "Verify", remote_workspace_pairing_request_path(pairing_request), class: "btn txt-small",
            "aria-label": "Verify #{remote_workspace.name} is running with its secret" %>
    <% end %>

    <%= tag.details class: "position-relative", data: {
      controller: "popup", popup_orientation_top_class: "is-near-bottom",
      action: "keydown.esc->popup#close toggle->popup#toggle click@document->popup#closeOnClickOutside"
    } do %>
      <summary class="btn action-btn options-btn">
        <%= icon_tag "menu-dots-horizontal" %>
        <span class="for-screen-reader"><%= remote_workspace.name %> options</span>
      </summary>

      <div class="popup-menu list-menu border shadow" data-popup-target="menu">
        <%= button_to membership.hidden? ? "Show in sidebar" : "Hide from sidebar", remote_workspace_membership_path(membership),
              method: :patch, params: { remote_workspace_membership: { hidden: !membership.hidden? } },
              class: "btn action-btn full-width" %>

        <% if membership.consented? %>
          <%= button_to "Stop signing in with sabha.co", remote_workspace_membership_consent_path(membership),
                method: :delete, class: "btn action-btn full-width" %>
        <% end %>

        <% if paired_by_me %>
          <%= button_to "Get a new secret", remote_workspace_pairing_requests_path, params: { remote_workspace_id: remote_workspace.id },
                class: "btn action-btn full-width" %>
          <%= button_to "Disconnect from sabha.co", remote_workspace_pairing_path(remote_workspace),
                method: :delete, class: "btn action-btn full-width txt-negative",
                data: { turbo_confirm: "Turn off Continue with sabha.co for everyone on #{remote_workspace.name}? They'll sign in there the usual way." } %>
        <% elsif !remote_workspace.pairing_active? && !pairing_request %>
          <%= button_to "Set up Continue with sabha.co", remote_workspace_pairing_requests_path, params: { remote_workspace_id: remote_workspace.id },
                class: "btn action-btn full-width" %>
        <% end %>

        <%= button_to "Remove from list", remote_workspace_membership_path(membership),
              method: :delete, class: "btn action-btn full-width txt-negative" %>
      </div>
    <% end %>
  </div>
</div>
