<% content_for :title, "Export workspace database" %>

<div class="saas-settings panel center" style="view-transition-name: workspace-export;">
  <div class="flex flex-column gap">
    <section class="settings__section">
      <header>
        <h2 class="divider">Export workspace database</h2>
      </header>

      <% if Current.workspace.recently_exported? %>
        <p class="txt-small txt-muted">
          An export of <strong><%= Current.workspace.name %></strong> is on its way to your email. The download link is good for 24 hours once it lands.
        </p>
      <% else %>
        <p class="txt-small txt-muted">
          We'll prepare a gzipped SQLite snapshot of <strong><%= Current.workspace.name %></strong> and email a download link to <strong><%= Current.user.email_address %></strong>. Drop the file into a self-hosted Sabha install to take your data with you.
        </p>

        <div class="flex justify-center">
          <%= button_to "Email me a download link", settings_export_path, method: :post, class: "btn" %>
        </div>

        <p class="txt-small txt-muted">
          The link expires 24 hours after the email is sent. Files aren't included in the export, and members will need to sign in again via email on the self-hosted instance.
        </p>
      <% end %>
    </section>
  </div>
</div>

<div class="flex justify-center pad-block">
  <%= link_to settings_path, class: "btn txt-small" do %>
    <%= icon_tag "arrow-left" %> Back to settings
  <% end %>
</div>
