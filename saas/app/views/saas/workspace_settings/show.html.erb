<% content_for :title, "Workspace settings" %>

<div class="<%= Current.user.administrator? ? "settings-layout" : "panel center" %>" style="view-transition-name: workspace-settings;">
  <% if Current.user.administrator? %>
    <%# Admin: two-column layout %>
    <div class="panel">
      <div class="flex flex-column gap">
        <fieldset class="flex flex-column gap pad">
          <legend class="txt-large txt-align-center"><strong><%= @workspace.name %></strong></legend>

          <p class="txt-small txt-muted txt-align-center">
            <%= pluralize(@member_count, "member") %>
            <span class="txt-muted">&middot;</span>
            <%= Current.user.role.capitalize %>
          </p>
        </fieldset>

        <% account = Current.account %>
        <fieldset class="flex flex-column gap pad">
          <legend class="txt-medium txt-align-center"><strong>Storage</strong></legend>

          <div class="flex flex-column gap-half">
            <div style="background: var(--color-surface-alt); border-radius: 4px; height: 8px; overflow: hidden;">
              <div style="background: <%= account.exceeding_storage_limit? ? 'var(--color-negative)' : account.nearing_storage_limit? ? 'var(--color-warning)' : 'var(--color-accent)' %>; height: 100%; width: <%= account.storage_percentage_used %>%; transition: width 0.3s;"></div>
            </div>
            <p class="txt-small txt-muted txt-align-center">
              <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(Storage::WORKSPACE_LIMIT) %> used
            </p>
            <% if account.exceeding_storage_limit? %>
              <p class="txt-small txt-negative txt-align-center">
                Storage limit reached. File uploads are disabled.
              </p>
              <p class="txt-small txt-muted txt-align-center">
                <a href="https://cloud.sabha.co" target="_blank" class="txt-underlined">Sabha Cloud</a> gives you a dedicated server with no storage limits.
              </p>
            <% elsif account.nearing_storage_limit? %>
              <p class="txt-small txt-warning txt-align-center">
                Approaching storage limit.
              </p>
              <p class="txt-small txt-muted txt-align-center">
                <a href="https://cloud.sabha.co" target="_blank" class="txt-underlined">Sabha Cloud</a> gives you a dedicated server with no storage limits.
              </p>
            <% end %>
          </div>
        </fieldset>

        <% unless Current.account.storage_stressed? %>
          <fieldset class="flex flex-column gap pad">
            <legend class="txt-medium txt-align-center"><strong>Your data</strong></legend>

            <p class="txt-small txt-muted">
              You can always take out workspace data using <%= link_to "Export", settings_export_path, class: "txt-underlined" %>.
            </p>

            <p class="txt-small txt-muted">
              Workspaces on sabha.co run on shared infrastructure. We do our best, but we cannot guarantee backups or uptime.
              For a dedicated server with continuous backups, custom domain, and managed updates, see
              <a href="https://cloud.sabha.co" target="_blank" class="txt-underlined">Sabha Cloud</a>.
            </p>
          </fieldset>
        <% end %>
      </div>
    </div>

    <div class="panel">
      <div class="flex flex-column gap">
        <%= render "saas/workspace_settings/leave_workspace",
              workspace: @workspace,
              is_last_admin: @is_last_admin,
              legend_class: "txt-large",
              legend_text: "Membership" %>

        <fieldset class="flex flex-column gap pad" data-controller="confirm-delete">
          <legend class="txt-medium txt-align-center txt-negative"><strong>Delete workspace</strong></legend>

          <p class="txt-small txt-muted">
            Permanently delete this workspace and all its data. This cannot be undone.
          </p>

          <%= form_with url: settings_path, method: :delete, class: "flex flex-column gap",
                  data: { turbo_confirm: "Are you sure? This will permanently delete the workspace and all its data." } do |form| %>
            <label class="flex flex-column gap-half">
              <span class="txt-small">Type <strong><%= @workspace.name %></strong> to confirm:</span>
              <%= form.text_field :confirmation, class: "input txt-align-center",
                    autocomplete: "off",
                    data: {
                      confirm_delete_target: "input",
                      expected: @workspace.name,
                      action: "input->confirm-delete#checkMatch"
                    } %>
            </label>

            <div class="flex justify-center">
              <%= form.button class: "btn btn--negative", type: "submit", disabled: true,
                    data: { confirm_delete_target: "button" } do %>
                Delete workspace permanently
              <% end %>
            </div>
          <% end %>
        </fieldset>
      </div>
    </div>

  <% else %>
    <%# Non-admin: single panel %>
    <div class="flex flex-column gap">
      <fieldset class="flex flex-column gap pad">
        <legend class="txt-large txt-align-center"><strong><%= @workspace.name %></strong></legend>

        <p class="txt-small txt-muted txt-align-center">
          <%= pluralize(@member_count, "member") %>
          <span class="txt-muted">&middot;</span>
          <%= Current.user.role.capitalize %>
        </p>
      </fieldset>

      <fieldset class="flex flex-column gap pad">
        <legend class="txt-medium txt-align-center"><strong>Your data</strong></legend>

        <p class="txt-small txt-muted">
          Workspaces on sabha.co run on shared infrastructure. We do our best, but we cannot guarantee backups or uptime.
          For a dedicated server with continuous backups, custom domain, and managed updates, see
          <a href="https://cloud.sabha.co" target="_blank" class="txt-underlined">Sabha Cloud</a>.
        </p>
      </fieldset>

      <%= render "saas/workspace_settings/leave_workspace",
            workspace: @workspace,
            is_last_admin: false,
            legend_class: "txt-medium",
            legend_text: "Leave workspace" %>
    </div>
  <% end %>
</div>

<div class="flex justify-center pad-block">
  <%= link_to settings_path(script_name: ""), class: "btn txt-small" do %>
    <%= icon_tag "arrow-left" %> Back to settings
  <% end %>
</div>
