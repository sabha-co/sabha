<% content_for :title, "Enter code" %>
<% content_for :back_nav do %>
  <%= link_to "← Back", root_path, class: "txt-medium txt-muted txt-undecorated" %>
<% end %>

<section class="auth-card <%= "shake" if flash[:alert] %>">
  <header class="auth-card__header">
    <%= link_to root_path, class: "auth-card__logo" do %>
      <%= image_tag "logos/app-icon.png", alt: Branding.app_name %>
    <% end %>
    <div>
      <h1 class="auth-card__title">Check your email</h1>
      <p class="auth-card__blurb">We sent a code to <strong><%= @auth_code_email || "your email" %></strong>. It expires in 15 minutes and works once.</p>
    </div>
  </header>

  <%= render "sessions/flash_messages" %>

  <%= form_with url: auth_code_path, html: { autocomplete: "off" } do |form| %>
    <%= render "sessions/code_field", form: form, show_translation: false %>
    <%= render "sessions/submit_button", form: form, label: "Verify" %>
  <% end %>

  <p class="auth-card__note">
    Didn't receive it? <%= link_to "Try again", new_session_path %>
  </p>
</section>
