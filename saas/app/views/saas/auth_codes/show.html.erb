<% content_for :title, "Enter code" %>

<section class="txt-align-center">
  <div class="panel panel--centered <%= "shake" if flash[:alert] %>">
    <div class="flex justify-center mb-6">
      <%= link_to root_path do %>
        <%= image_tag "logos/app-icon.png", alt: Branding.saas_app_name, class: "w-24 h-auto rounded-lg" %>
      <% end %>
    </div>

    <%= form_with url: auth_code_path, class: "flex flex-column gap", html: { autocomplete: "off" } do |form| %>
      <fieldset class="flex flex-column gap center-block upad">
        <legend class="txt-large txt-align-center"><strong>Check your email</strong></legend>

        <%= render "sessions/flash_messages" %>

        <p class="txt-medium">Enter the 6-character code we sent you.</p>

        <%= render "sessions/code_field", form: form, styled: true %>
        <%= render "sessions/submit_button", form: form, label: "Verify" %>

        <p class="txt-small">
          Didn't receive it? <%= link_to "Try again", new_session_path %>
        </p>
      </fieldset>
    <% end %>
  </div>
</section>
