<section class="landing-hero landing-container landing-section">
  <div class="landing-trust-badge">
    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1.001A3.75 3.75 0 0012 18z"/></svg>
    Built on Campfire by 37signals
  </div>
  <h1>The community space<br>that respects your attention.</h1>
  <p class="lead">Stop fighting with Discord bots, drowning in Slack notifications, or managing chaos on Telegram. Sabha is the simple, intentional chat platform for communities who want to talk.</p>
  <a href="<%= new_registration_path %>" class="landing-btn">Start Your Community &ndash; Free</a>
  <span class="landing-hero-subtext">No credit card required. Set up in 30 seconds.</span>

  <%# Desktop mockup %>
  <div class="landing-mockup">
    <div class="landing-mockup-sidebar">
      <div class="landing-mockup-line brand"></div>
      <div class="landing-mockup-line"></div>
      <div class="landing-mockup-line short"></div>
      <div class="landing-mockup-line"></div>
    </div>
    <div class="landing-mockup-main">
      <div class="landing-mockup-line" style="width: 30%; height: 24px; margin-bottom: 48px;"></div>
      <div class="landing-mockup-chat">
        <div class="landing-mockup-avatar"></div>
        <div class="landing-mockup-bubble">
          <div class="landing-mockup-line short"></div>
          <div class="landing-mockup-line"></div>
        </div>
      </div>
      <div class="landing-mockup-chat">
        <div class="landing-mockup-avatar" style="background: var(--landing-brand);"></div>
        <div class="landing-mockup-bubble">
          <div class="landing-mockup-line"></div>
        </div>
      </div>
    </div>
