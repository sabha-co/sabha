<%# ═══════════════════════════════════ BUILT ON CAMPFIRE ═══════════════════════════════════ %>
<section id="campfire" class="landing-section landing-campfire">
  <div class="landing-inner">
    <a href="https://once.com/campfire" target="_blank" style="display: inline-block;">
      <%= image_tag "logos/campfire-logo.png", alt: "Campfire by 37signals", class: "landing-campfire-logo" %>
    </a>
    <h2><a href="https://once.com/campfire" target="_blank" class="landing-campfire-heading-link">Built on Campfire,<br>By 37signals.</a></h2>
    <p class="landing-campfire-body">Sabha isn't built from scratch. It's built on <a href="https://once.com/campfire" target="_blank" style="color: inherit; text-decoration: underline; text-underline-offset: 4px;">Campfire</a>, the team chat created by 37signals — the company behind Basecamp, HEY, and Ruby on Rails. That means you get a decade of opinionated product thinking baked into every interaction: simplicity over feature bloat, speed over spectacle, calm over chaos.</p>
    <div class="landing-campfire-strip">
      <div class="landing-campfire-col">
        <span class="landing-campfire-label">FOUNDATION</span>
        <span class="landing-campfire-value">Campfire by 37signals</span>
      </div>
      <div class="landing-campfire-divider-v"></div>
      <div class="landing-campfire-col">
        <span class="landing-campfire-label">STACK</span>
        <span class="landing-campfire-value">Rails, Hotwire, SQLite</span>
      </div>
      <div class="landing-campfire-divider-v"></div>
