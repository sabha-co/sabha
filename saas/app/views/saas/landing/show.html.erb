<%# ═══════════════════════════════════ PROBLEM ═══════════════════════════════════ %>
<section class="landing-section landing-problem">
  <div class="landing-inner">
    <div class="landing-section-header">
      <span class="landing-label">THE PROBLEM</span>
      <h2>Community chat is broken.</h2>
      <p class="landing-section-sub">Discord buries conversations in an unindexed void. Slack charges per seat. Group chats are chaos. You need something that respects your community and your attention.</p>
    </div>
    <div class="landing-problem-cards">
      <div class="landing-card">
        <div class="landing-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 9a2 2 0 0 1-.88 1.664L12 13 8.88 10.664A2 2 0 0 1 8 9V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2z"/><line x1="1" x2="1" y1="14" y2="18"/><line x1="1" x2="23" y1="18" y2="18"/><line x1="23" x2="23" y1="14" y2="18"/></svg>
        </div>
        <h3>Discord</h3>
        <p>Conversations disappear. Nothing is searchable. Bots, boosts, Nitro upsells. Your community becomes noise.</p>
      </div>
      <div class="landing-card">
        <div class="landing-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        </div>
        <h3>Slack</h3>
        <p>Per-seat pricing. 90-day message limits on free plans. Built for work, not community. Expensive lock-in.</p>
      </div>
      <div class="landing-card">
        <div class="landing-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h3>Mattermost / Rocket.Chat</h3>
        <p>Enterprise tools cosplaying as community platforms. Kubernetes deployments. Twelve environment variables. Overkill.</p>
      </div>
    </div>
  </div>
</section>

<div class="landing-divider"></div>

<%# ═══════════════════════════════════ CORE FEATURES ═══════════════════════════════════ %>
