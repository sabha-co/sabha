<% content_for :title, "Invite your team" %>

<section class="txt-align-center">
  <div class="panel panel--centered" style="--panel-width: 36rem; --panel-padding: 2.5em;">
    <div class="auth-brand">
      <%= link_to root_path do %>
        <%= image_tag "logos/app-icon.png", alt: Branding.app_name %>
      <% end %>
    </div>

    <fieldset class="flex flex-column gap center-block" style="--row-gap: 1.5em;">
      <legend class="txt-large txt-align-center"><strong>Welcome to <%= Current.account.name %></strong></legend>
      <p class="txt-muted txt-medium txt-align-center">To invite people to chat, share the join link below.</p>

      <%= render "accounts/invite", show_regenerate: false %>

      <div class="margin-top">
        <%= link_to root_path, class: "btn btn--reversed center txt-large" do %>
          Done
        <% end %>
      </div>
    </fieldset>
  </div>
</section>
