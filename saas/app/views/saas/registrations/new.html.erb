<% content_for :title, "Create account" %>
<% content_for :back_nav do %>
  <%= link_to "← Back", root_path, class: "txt-medium txt-muted txt-undecorated" %>
<% end %>

<section class="txt-align-center">
  <div class="panel panel--centered <%= "shake" if flash[:alert] %>">
    <div class="flex justify-center mb-6">
      <%= link_to root_path do %>
        <%= image_tag "logos/app-icon.png", alt: Branding.app_name, class: "w-18 h-auto rounded-lg" %>
      <% end %>
    </div>

    <%= form_with url: registration_path, method: :post, class: "flex flex-column gap", html: { autocomplete: "off" } do |form| %>
      <fieldset class="flex flex-column gap center-block pad">
        <legend class="txt-large txt-align-center"><strong>Create your account</strong></legend>

        <p class="txt-medium txt-muted">
          Already have an account?
          <%= link_to "Sign in", new_session_path(return_to: params[:return_to].presence || session[:return_to_after_authenticating]) %>
        </p>

        <%= render "sessions/flash_messages" %>

        <div data-controller="name-field">
          <div class="flex align-center gap">
            <%= translation_button(:user_name) %>
            <label class="flex align-center gap input input--actor txt-large">
              <%= form.text_field :name, class: "input", autocomplete: "name", placeholder: "Your name", autofocus: true, required: true,
                    minlength: 2, maxlength: 100, data: { "1p-ignore": true, action: "input->name-field#validate" } %>
              <%= icon_tag "person" %>
            </label>
          </div>
          <p class="txt-small txt-negative margin-block-start-half" hidden data-name-field-target="hint">This looks like an email address. Your name goes here!</p>
        </div>

        <%= render "sessions/email_field", form: form, autofocus: false %>
        <div class="flex justify-center"><%= cloudflare_turnstile %></div>

        <div class="flex justify-center">
          <label class="flex align-center gap-half txt-medium txt-muted">
            <%= form.check_box :terms_of_service, { required: true }, "1", "0" %>
            <span>I agree to the <%= link_to "Terms", "/terms", target: "_blank" %> and <%= link_to "Privacy Policy", "/privacy", target: "_blank" %>.</span>
          </label>
        </div>

        <%= render "sessions/submit_button", form: form, label: "Create account" %>
      </fieldset>
    <% end %>
  </div>
</section>
