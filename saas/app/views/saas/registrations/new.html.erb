<% content_for :title, "Create account" %>

<section class="txt-align-center">
  <div class="panel panel--centered <%= "shake" if flash[:alert] %>">
    <div class="flex justify-center mb-6">
      <%= link_to root_path do %>
        <%= image_tag "logos/app-icon.png", alt: Branding.saas_app_name, class: "w-24 h-auto rounded-lg" %>
      <% end %>
    </div>

    <%= form_with url: registration_path, method: :post, class: "flex flex-column gap", html: { autocomplete: "off" } do |form| %>
      <fieldset class="flex flex-column gap center-block pad">
        <legend class="txt-large txt-align-center"><strong>Create your account</strong></legend>

        <p class="txt-medium">
          Already have an account?
          <%= link_to "Sign in", new_session_path(return_to: params[:return_to].presence || session[:return_to_after_authenticating]) %>
        </p>

        <%= render "sessions/flash_messages" %>

        <div class="flex align-center gap">
          <%= translation_button(:user_name) %>
          <label class="flex align-center gap input input--actor txt-large">
            <%= form.text_field :name, class: "input", autocomplete: "name", placeholder: "Your name", autofocus: true, required: true,
                  data: { "1p-ignore": true } %>
            <%= icon_tag "person" %>
          </label>
        </div>

        <%= render "sessions/email_field", form: form, autofocus: false %>
        <div class="flex justify-center"><%= cloudflare_turnstile %></div>
        <%= render "sessions/submit_button", form: form, label: "Create account" %>
      </fieldset>
    <% end %>
  </div>
</section>
