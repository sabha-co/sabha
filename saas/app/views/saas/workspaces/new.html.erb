<% content_for :title, "Get started" %>

<section class="txt-align-center">
  <div class="panel panel--centered" style="--panel-width: 36rem">
    <div class="flex justify-center mb-6">
      <%= link_to root_path do %>
        <%= image_tag "logos/app-icon.png", alt: Branding.saas_app_name, class: "w-18 h-auto rounded-lg" %>
      <% end %>
    </div>

    <%= form_with url: workspaces_path, class: "flex flex-column gap", html: { autocomplete: "off" } do |form| %>
      <fieldset class="flex flex-column gap center-block pad">
        <% if current_global_identity.active_workspaces_recent_first.any? %>
          <legend class="txt-large txt-align-center"><strong>Create a new workspace</strong></legend>
        <% else %>
          <legend class="txt-large txt-align-center"><strong>You're not part of any workspace yet</strong></legend>
          <p class="txt-muted txt-medium txt-align-center">Create your first workspace to get started.</p>
        <% end %>

        <label class="flex align-center gap input input--actor txt-large">
          <%= form.text_field :name, required: true, class: "input", autofocus: true, placeholder: "Workspace name", minlength: 2, maxlength: 100 %>
        </label>

        <%= form.button class: "btn btn--reversed center txt-large", type: "submit" do %>
          Create workspace
        <% end %>
      </fieldset>
    <% end %>
  </div>
</section>
