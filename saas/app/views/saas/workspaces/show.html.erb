<% content_for :title, "Setting up #{@workspace.name}" %>

<noscript><meta http-equiv="refresh" content="0;url=<%= @invite_url %>"></noscript>

<section class="txt-align-center">
  <div class="panel panel--centered" style="--panel-width: 36rem"
       data-controller="workspace-provisioning"
       data-workspace-provisioning-url-value="<%= @invite_url %>">
    <div class="flex justify-center mb-6">
      <%= image_tag "logos/app-icon.png", alt: Branding.saas_app_name, class: "w-18 h-auto rounded-lg" %>
    </div>

    <fieldset class="flex flex-column gap center-block pad">
      <legend class="txt-large txt-align-center"><strong>Setting up <%= @workspace.name %></strong></legend>

      <div class="provisioning-progress">
        <div class="provisioning-progress__bar" data-workspace-provisioning-target="bar"></div>
      </div>

      <p class="txt-muted txt-medium" data-workspace-provisioning-target="status">Creating workspace&hellip;</p>

      <noscript>
        <p><%= link_to "Continue to your workspace", @invite_url %></p>
      </noscript>
    </fieldset>
  </div>
</section>
