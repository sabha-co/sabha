<% content_for :title, "Connect a community" %>

<section class="txt-align-center">
  <div class="panel panel--centered" style="--panel-width: 36rem">
    <%= form_with url: remote_workspace_pairings_path, class: "flex flex-column gap" do |form| %>
      <fieldset class="flex flex-column gap center-block pad">
        <legend class="txt-large txt-align-center"><strong>Connect a community to sabha.co</strong></legend>
        <p class="txt-muted txt-medium txt-align-center">
          Paste the address of a self-hosted Sabha you run. You'll get a secret to put in its settings.
        </p>

        <% if @lookup_error %>
          <p class="txt-small txt-negative" role="alert"><%= remote_workspace_lookup_message(@lookup_error) %></p>
        <% elsif @claimed %>
          <p class="txt-small txt-negative" role="alert">That address already signs in with sabha.co another way, so it can't be connected here.</p>
        <% end %>

        <label class="flex align-center gap input input--actor txt-large">
          <%= form.text_field :origin, value: @address, required: true, class: "input", autofocus: true,
                placeholder: "chat.example.org", inputmode: "url", autocapitalize: "off", spellcheck: false,
                "aria-label": "Community address" %>
        </label>

        <%= form.button class: "btn btn--reversed center txt-large", type: "submit" do %>
          Get a secret
        <% end %>
        <%= link_to "Back to settings", settings_path, class: "txt-small" %>
      </fieldset>
    <% end %>
  </div>
</section>
