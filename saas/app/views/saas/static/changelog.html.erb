<% content_for :title, "Changelog — Latest Updates & Features" %>
<% content_for :meta_description, "See what's new in Sabha. Latest updates, features, and improvements to the open source community chat platform." %>

<div class="landing">

<%= render "shared/marketing_header" %>

<%# ═══════════════════════════════════ CHANGELOG ═══════════════════════════════════ %>
<section class="landing-section" style="padding-top: 6rem;">
  <div class="landing-inner" style="max-width: 680px;">
    <div class="landing-section-header">
      <span class="landing-label">CHANGELOG</span>
      <h1 class="landing-section-title">What's new in Sabha</h1>
    </div>

    <div style="margin-top: 2rem;">
      <% @changelog.each do |section| %>
        <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--color-text-primary, #111); margin-top: 3rem; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--color-border, #e5e5e5);"><%= section[:heading] %></h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% section[:items].each do |item| %>
            <li style="padding: 0.75rem 0; border-bottom: 1px solid var(--color-border-light, #f0f0f0);">
              <strong style="color: var(--color-text-primary, #111);"><%= item[:title] %></strong>
              <span style="color: var(--color-text-secondary, #555);"> — <%= item[:description] %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <p style="margin-top: 3rem; font-size: 0.9375rem; color: var(--color-text-secondary, #555);">
      See the full changelog on <a href="https://github.com/sabha-co/sabha/blob/main/docs/CHANGELOG.md" target="_blank" style="color: inherit; text-decoration: underline; text-underline-offset: 4px;">GitHub</a>.
    </p>
  </div>
</section>

<div class="landing-divider"></div>

<%= render "shared/marketing_footer" %>

</div>
