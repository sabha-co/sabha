<!DOCTYPE html>
<html lang="en" data-theme="light" style="color-scheme: light">
  <head>
    <%= render "layouts/theme_preference" %>

    <title><%= content_for?(:title) ? "#{content_for(:title)} | Sabha" : "Sabha — Open Source Discord Alternative for Communities" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <meta name="description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Simple, intentional chat for communities, without a subscription. Rooms, threads, DMs, search. Open source, free to use, free to leave." %>">
    <meta name="theme-color" content="<%= Branding.theme_color %>">
    <meta name="mobile-web-app-capable" content="yes">

    <% canonical_url = request.original_url.split('?').first.chomp('/') %>
    <link rel="canonical" href="<%= canonical_url %>">

    <%# Open Graph %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for?(:title) ? "#{content_for(:title)} | Sabha" : "Sabha — Open Source Discord Alternative for Communities" %>">
    <meta property="og:description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Simple, intentional chat for communities, without a subscription. Rooms, threads, DMs, search. Open source, free to use, free to leave." %>">
    <meta property="og:image" content="<%= request.base_url %>/sabha-og.jpg">
    <meta property="og:logo" content="<%= request.base_url %>/icon.png">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:site_name" content="Sabha">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? "#{content_for(:title)} | Sabha" : "Sabha — Open Source Discord Alternative for Communities" %>">
    <meta name="twitter:description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Simple, intentional chat for communities, without a subscription. Rooms, threads, DMs, search. Open source, free to use, free to leave." %>">
    <meta name="twitter:image" content="<%= request.base_url %>/sabha-og.jpg">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "icon", href: image_path("icons/sabha-icon.svg"), type: "image/svg+xml" %>
    <%= tag.link rel: "apple-touch-icon", href: image_path("icons/sabha-icon.svg") %>

    <%= stylesheet_link_tag "tailwind", "application/_defaults", *Stylesheets.from("marketing"), "data-turbo-track": "reload" %>
    <% if hotwire_native_app? %>
      <%= stylesheet_link_tag "native", "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%= cloudflare_turnstile_script_tag %>
    <%= umami_analytics_tag %>
  </head>

  <body class="marketing">
    <% if notice = flash[:notice] || flash[:alert] %>
      <div class="marketing-toast" data-controller="element-removal" data-action="animationend->element-removal#remove">
        <div class="marketing-toast__card <%= "marketing-toast__card--alert" if flash[:alert] %>">
          <div class="marketing-toast__icon">
            <% if flash[:alert] %>
              <%= icon_tag "alert", class: "marketing-toast__glyph" %>
            <% else %>
              <%= icon_tag "check", class: "marketing-toast__glyph" %>
            <% end %>
          </div>
          <p class="marketing-toast__text"><%= notice %></p>
        </div>
      </div>
    <% end %>

    <div class="marketing-page">
      <main class="marketing-main">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
