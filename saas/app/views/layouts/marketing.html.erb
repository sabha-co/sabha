<!DOCTYPE html>
<html lang="en" data-theme="light" style="color-scheme: light">
  <head>
    <%= render "layouts/theme_preference" %>

    <title><%= content_for?(:title) ? "#{content_for(:title)} | Sabha" : "Sabha — Open Source Discord Alternative for Communities" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <meta name="description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Simple, intentional chat for communities, without a subscription. Rooms, threads, DMs, search. Open source, free to host, free to leave." %>">
    <meta name="theme-color" content="<%= Branding.theme_color %>">
    <meta name="mobile-web-app-capable" content="yes">

    <link rel="canonical" href="<%= request.original_url.split('?').first.chomp('/') %>">

    <%# Open Graph %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for?(:title) ? "#{content_for(:title)} | Sabha" : "Sabha — Open Source Discord Alternative for Communities" %>">
    <meta property="og:description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Simple, intentional chat for communities, without a subscription. Rooms, threads, DMs, search. Open source, free to host, free to leave." %>">
    <meta property="og:image" content="<%= image_url("sabha-og.png") %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:site_name" content="Sabha">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? "#{content_for(:title)} | Sabha" : "Sabha — Open Source Discord Alternative for Communities" %>">
    <meta name="twitter:description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Simple, intentional chat for communities, without a subscription. Rooms, threads, DMs, search. Open source, free to host, free to leave." %>">
    <meta name="twitter:image" content="<%= image_url("sabha-og.png") %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "icon", href: image_path("icons/sabha-icon.svg"), type: "image/svg+xml" %>
    <%= tag.link rel: "apple-touch-icon", href: image_path("icons/sabha-icon.svg") %>

    <%= stylesheet_link_tag "tailwind", *(Stylesheets.from("application") + Stylesheets.from("marketing") + Stylesheets.vendor_stylesheets), "data-turbo-track": "reload" %>
    <% if hotwire_native_app? %>
      <%= stylesheet_link_tag "native", "data-turbo-track": "reload" %>
    <% end %>
    <%= stylesheet_link_tag "overrides", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%= cloudflare_turnstile_script_tag %>
    <%= umami_analytics_tag %>
  </head>

  <body class="bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-50 antialiased font-sans">
    <% if notice = flash[:notice] || flash[:alert] %>
      <div class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full" data-controller="element-removal" data-action="animationend->element-removal#remove">
        <div class="bg-zinc-800 text-white rounded-lg shadow-lg p-4 flex items-start gap-3 <%= "bg-red-600" if flash[:alert] %>">
          <div class="mt-0.5">
            <% if flash[:alert] %>
              <%= icon_tag "alert", class: "w-5 h-5 text-white" %>
            <% else %>
              <%= icon_tag "check", class: "w-5 h-5 text-white" %>
            <% end %>
          </div>
          <p class="text-sm font-medium leading-relaxed"><%= notice %></p>
        </div>
      </div>
    <% end %>

    <div class="min-h-screen flex flex-col">
      <main class="flex-grow flex flex-col relative w-full overflow-hidden">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
