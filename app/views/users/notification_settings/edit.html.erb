<% @page_title = "Notification preferences" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to_last_room_visited %>
  </div>
<% end %>

<section class="panel flex flex-column gap">
  <h1 class="txt-align-center txt-large margin-none">Notification preferences</h1>

  <%
    show_missed_email = Current.account.email_notifications_enabled? || Current.user.administrator?
    show_weekly_digest = Current.account.weekly_digest_enabled? || Current.user.administrator?
  %>

  <div class="margin-block pad fill-shade border-radius">

    <%# ─── Push ─────────────────────────────────────────────────────── %>
    <section>
      <p class="txt-small txt-muted txt-label margin-block-end-half">Push</p>

      <%= render "users/notification_settings/toggle",
            settings:  @settings,
            attribute: :push_enabled,
            title:     "Push notifications",
            hint:      "Receive alerts on this device even when Sabha is closed." %>
    </section>

    <%# ─── Email ─────────────────────────────────────────────────────── %>
    <% if show_missed_email || show_weekly_digest %>
      <hr class="separator separator--row margin-block">

      <section>
        <p class="txt-small txt-muted txt-label margin-block-end-half">Email</p>

        <% if !Current.account.email_notifications_enabled? && !Current.account.weekly_digest_enabled? %>
          <p class="txt-small txt-muted margin-none">
            Email notifications are turned off for this workspace.
            <%= link_to "Enable in workspace settings", edit_account_path %>.
          </p>
        <% else %>
          <% if show_missed_email %>
            <% if Current.account.email_notifications_enabled? %>
              <%= render "users/notification_settings/toggle",
                    settings:  @settings,
                    attribute: :missed_email_enabled,
                    title:     "Email me when I'm mentioned or sent a DM while I'm away" %>

              <%= form_with model: @settings, url: user_notification_settings_path(user_id: "me"), method: :patch, scope: :user_notification_settings, data: { controller: "form" } do |form| %>
                <div class="flex align-center gap" style="padding-inline-start: 1.75rem;">
                  <span class="txt-small txt-muted">Bundle into</span>
                  <%= form.select :email_frequency,
                        [["one hourly email", "hourly"], ["one daily email", "daily"]], {},
                        class: "input txt-small", style: "width: auto;",
                        data: { action: "change->form#submit" } %>
                </div>
              <% end %>
            <% else %>
              <p class="txt-small txt-muted margin-none">
                Missed-notification email is turned off for this workspace.
                <%= link_to "Enable in workspace settings", edit_account_path %>.
              </p>
            <% end %>
          <% end %>

          <% if show_missed_email && show_weekly_digest %>
            <hr class="separator separator--row separator--soft">
          <% end %>

          <% if show_weekly_digest %>
            <% if Current.account.weekly_digest_enabled? %>
              <%= render "users/notification_settings/toggle",
                    settings:  @settings,
                    attribute: :weekly_digest_subscribed,
                    title:     "Receive the weekly community digest" %>
            <% else %>
              <p class="txt-small txt-muted margin-none">
                The weekly community digest is turned off for this workspace.
                <%= link_to "Enable in workspace settings", edit_account_path %>.
              </p>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>

  </div>

  <%# ─── Per-room notifications ────────────────────────────────────── %>
  <div class="margin-block pad fill-shade border-radius" style="margin-top: 0;">
    <p class="txt-small txt-muted txt-label margin-block-end-half">Per-room notifications</p>
    <p class="txt-small txt-muted margin-block-end-half">Choose how closely you follow each room. Use the bell button to set your involvement level.</p>

    <%
      grouped_memberships = @starred_memberships + @all_notifications_memberships + @other_memberships + @muted_memberships
    %>
    <% grouped_memberships.each do |membership| %>
      <%= turbo_stream_from membership %>
    <% end %>

    <menu class="flex flex-column gap-half margin-none pad">
      <%= render partial: "users/notification_settings/membership", collection: grouped_memberships %>
    </menu>
  </div>
</section>
