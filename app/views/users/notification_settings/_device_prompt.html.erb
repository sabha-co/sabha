<%# Device-level push enrollment: hidden until the notifications controller
    confirms this browser has no push subscription, then offers to enroll it. %>
<div id="notification_bell_container" hidden
    data-controller="notifications" data-notifications-subscriptions-url-value="<%= user_push_subscriptions_path %>" data-notifications-attention-class="btn--pulsing">
  <%= turbo_frame_tag "global_notifications" do %>
    <div class="setting-row">
      <span class="setting-row__text">
        <span class="setting-row__title">This browser</span>
        <span class="txt-small txt-muted">Sabha needs this browser's permission to show alerts.</span>
      </span>
      <button class="btn" data-action="click->notifications#attemptToSubscribe" data-notifications-target="bell">
        <%= icon_tag "notification-bell-alert" %>
        Turn on
      </button>
    </div>
  <% end %>

  <dialog data-notifications-target="notAllowedNotice" class="scrim-dialog"
      style="--dialog-width: 380px" aria-label="Notifications aren't allowed"
      data-controller="dialog" data-action="click->dialog#closeOnScrim">
    <header class="scrim-dialog__header scrim-dialog__header--titled">
      <span class="scrim-dialog__title">Notifications aren't allowed</span>
      <button type="button" class="scrim-dialog__close" data-action="dialog#close" aria-label="Close" autofocus="true">✕</button>
    </header>

    <div class="scrim-dialog__body">
      <%= render partial: "pwa/browser_settings" %>
      <%= render partial: "pwa/system_settings" %>
      <%= render partial: "pwa/install_instructions" %>
    </div>
  </dialog>
</div>
