<% indent = [local_assigns[:indent].to_i, 3].min %>
<li class="flex align-center gap margin-none min-width membership-item" style="padding-left: calc(var(--block-space) * <%= indent %>)">
  <%= link_to channel_path(membership.channel), class: "overflow-ellipsis fill-shade txt-primary txt-undecorated" do %>
    <strong><%= channel_display_name(membership.channel) %></strong>
  <% end %>

  <hr class="separator" aria-hidden="true">

  <span class="txt-small">
    <%= turbo_frame_tag dom_id(membership.channel, :involvement) do %>
      <%= button_to_change_involvement(membership.channel, membership.involvement) %>
    <% end %>
  </span>
</li>
