<% @page_title = @user.name %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back %>
  </div>

  <div class="flex align-center gap flex-item-justify-end">
    <% if Current.user == @user %>
      <%= link_to user_profile_path, class: "btn" do %>
        <%= icon_tag "pencil" %>
        <span class="for-screen-reader">Edit my profile</span>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="panel flex flex-column gap" style="view-transition-name: avatar-<%= @user.id %>">
  <% if @user.bot? %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <% if @user.active? %>
        <span class="txt-x-small txt-muted txt-label">Bot</span>
      <% else %>
        <span class="txt-small txt-muted">No longer active</span>
      <% end %>
    </div>

    <% if @user.active? %>
      <div class="flex justify-center">
        <%= button_to_direct_room_with @user %>
      </div>
    <% end %>

  <% elsif @user.active? %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half txt-align-center">
      <div class="flex align-center gap-half">
        <% if (dot_class = online_status_class(@user)) %>
          <span class="status-dot <%= dot_class %>" aria-hidden="true"></span>
        <% end %>
        <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
        <% if @user.administrator? %>
          <span class="txt-small txt-muted" title="Administrator" style="translate: 0 2px;"><%= icon_tag "crown" %></span>
        <% elsif @user.moderator? %>
          <span class="txt-small txt-muted" title="Moderator" style="translate: 0 2px;"><%= icon_tag "shield" %></span>
        <% end %>
      </div>
      <% if @user.badge %>
        <% badge = @user.badge %>
        <span class="txt-small" <%= "style=color:#{badge.color}" if badge.color.present? %>>
          <%= badge.name %>
        </span>
      <% end %>
      <% if @user.bio.present? %>
        <p class="txt-medium margin-none txt-tight-lines"><%= auto_link @user.bio %></p>
      <% end %>
      <% if Current.user.can_administer? %>
        <span class="txt-small txt-lighter"><%= mail_to @user.email_address, class: "txt-undecorated txt-lighter" %></span>
      <% end %>
    </div>

    <% if @user.has_social_links? %>
      <div class="flex align-center justify-center gap">
        <%= render "users/social_links", user: @user %>
      </div>
    <% end %>

    <div class="margin-block pad-inline pad-block fill-shade border-radius margin-none-block-start">
      <div class="flex justify-center align-center" style="gap: 2.5em;">
        <%= render "users/user_stats", user: @user, message_count: @user.total_message_count, streak: @user.current_streak, show_joined: true, large: true %>
      </div>
    </div>

    <% can_dm = Current.user.can_direct_message?(@user) %>
    <% if can_dm %>
      <div class="flex justify-center">
        <%= link_to rooms_directs_path(user_ids: [@user.id]), class: "btn btn--reversed", data: { turbo_frame: "_top", turbo_method: :post } do %>
          <%= icon_tag "messages" %>
          <span>Message <%= @user.name.split.first %></span>
        <% end %>
      </div>
    <% end %>

    <% if @recent_messages.any? %>
      <% if can_dm %>
        <hr class="margin-block-start borderless">
      <% end %>
      <fieldset class="margin-none-block-end">
        <legend class="gap">
          <%= icon_tag "messages", style: "--icon-size: 2.25rem" %>
        </legend>
      </fieldset>

      <div class="margin-block pad-inline pad-block fill-shade border-radius margin-none-block-start">
        <menu class="flex flex-column gap-half margin-none pad">
          <% @recent_messages.each do |message| %>
            <li class="flex flex-column gap-half margin-none">
              <div class="flex align-center gap-half txt-x-small txt-muted">
                <%= link_to message.room.name, room_at_message_path(message.room, message), class: "txt-undecorated txt-primary" %>
                <span>·</span>
                <span><%= time_ago_in_words(message.created_at) %> ago</span>
              </div>
              <span class="txt-small"><%= truncate(message.body.to_plain_text, length: 100) %></span>
            </li>
          <% end %>
        </menu>
      </div>

      <div class="flex justify-center">
        <%= link_to "All messages from #{@user.name}", user_messages_path(@user), class: "btn txt-small" %>
      </div>
    <% end %>

    <% if Current.user != @user && !@user.bot? %>
      <hr class="margin-block-start borderless">

      <div class="flex flex-column align-center gap-half">
        <% if Current.user.staff? %>
          <p class="txt-x-small txt-muted txt-label margin-none">For you</p>
        <% end %>
        <%= render "blocks/button", user: @user, compact: false %>
        <p class="txt-x-small txt-muted txt-align-center margin-none">
          Block stops the user from messaging or mentioning you.
        </p>
      </div>

      <% if Current.user.staff? %>
        <div class="flex flex-column align-center gap-half margin-block-start">
          <p class="txt-x-small txt-muted txt-label margin-none">Moderation</p>
          <div class="flex justify-center gap">
            <% if @user.removable_by?(Current.user) %>
              <%= render "users/deactivate_button", user: @user %>
            <% end %>
            <%= render "users/ban_button", user: @user %>
          </div>
          <p class="txt-x-small txt-muted txt-align-center margin-none">
            Deactivate revokes the user's access. Ban also deletes their messages and blocks their IPs.
          </p>
        </div>
      <% end %>
    <% end %>

  <% elsif @user.banned? %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <span class="txt-small txt-negative">Banned</span>
    </div>

    <% if Current.user.staff? && Current.user != @user %>
      <hr class="margin-block-start borderless">
      <div class="flex justify-center">
        <%= render "users/ban_button", user: @user %>
      </div>
    <% end %>

  <% else %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <span class="txt-small txt-muted">Deactivated</span>
    </div>

    <% if @user.reactivatable_by?(Current.user) %>
      <hr class="margin-block-start borderless">
      <div class="flex justify-center">
        <%= render "users/deactivate_button", user: @user %>
      </div>
    <% end %>
  <% end %>
</section>
