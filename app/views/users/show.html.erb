<% @page_title = @user.name %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back %>
  </div>

  <div class="flex align-center gap flex-item-justify-end">
    <% if Current.user == @user %>
      <%= link_to user_profile_path, class: "btn" do %>
        <%= image_tag "pencil.svg", aria: { hidden: "true" } %>
        <span class="for-screen-reader">Edit my profile</span>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="panel flex flex-column gap" style="view-transition-name: avatar-<%= @user.id %>">
  <% if @user.bot? %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <% if @user.active? %>
        <span class="txt-x-small txt-muted txt-label">Bot</span>
      <% else %>
        <span class="txt-small txt-muted">No longer active</span>
      <% end %>
    </div>

    <% if @user.active? %>
      <div class="flex justify-center">
        <%= button_to_direct_room_with @user %>
      </div>
    <% end %>

  <% elsif @user.active? %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half txt-align-center">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <% if @user.bio.present? %>
        <p class="txt-medium margin-none txt-tight-lines"><%= auto_link @user.bio %></p>
      <% end %>
      <% if Current.user.can_administer? %>
        <span class="txt-small txt-lighter"><%= mail_to @user.email_address, class: "txt-undecorated txt-lighter" %></span>
      <% end %>
    </div>

    <% if @user.has_social_links? %>
      <div class="flex align-center justify-center gap">
        <%= render "users/social_links", user: @user %>
      </div>
    <% end %>

    <% message_count = @user.total_message_count %>
    <% rank = @user.message_rank %>
    <div class="margin-block pad-inline pad-block fill-shade border-radius margin-none-block-start">
      <div class="flex justify-center align-center" style="gap: 2.5em;">
        <%= render "users/user_stats", user: @user, message_count: message_count, rank: rank, show_joined: true, large: true %>
      </div>
    </div>

    <% if Current.user.can_direct_message?(@user) %>
      <div class="flex justify-center">
        <%= link_to rooms_directs_path(user_ids: [@user.id]), class: "btn btn--reversed", data: { turbo_frame: "_top", turbo_method: :post } do %>
          <%= image_tag "messages.svg", size: 18, aria: { hidden: true } %>
          <span>Ping <%= @user.name.split.first %></span>
        <% end %>
      </div>
    <% end %>

    <% if @recent_messages.any? %>
      <hr class="margin-block-start borderless">

      <fieldset class="margin-none-block-end">
        <legend class="gap">
          <%= image_tag "messages.svg", aria: { hidden: "true" }, size: 36, class: "colorize--black" %>
        </legend>
      </fieldset>

      <div class="margin-block pad-inline pad-block fill-shade border-radius margin-none-block-start">
        <menu class="flex flex-column gap-half margin-none pad">
          <% @recent_messages.each do |message| %>
            <li class="flex flex-column gap-half margin-none">
              <div class="flex align-center gap-half txt-x-small txt-muted">
                <%= link_to message.room.name, room_at_message_path(message.room, message), class: "txt-undecorated txt-primary" %>
                <span>·</span>
                <span><%= time_ago_in_words(message.created_at) %> ago</span>
              </div>
              <span class="txt-small"><%= truncate(message.body.to_plain_text, length: 100) %></span>
            </li>
          <% end %>
        </menu>
      </div>

      <div class="flex justify-center">
        <%= link_to "All messages from #{@user.name}", user_messages_path(@user), class: "btn txt-small" %>
      </div>
    <% end %>

    <% if Current.user.can_administer? && !@user.bot? %>
      <hr class="margin-block-start borderless">

      <fieldset class="margin-none-block-end">
        <legend class="gap">
          <%= image_tag "settings.svg", aria: { hidden: "true" }, size: 36, class: "colorize--black" %>
        </legend>
      </fieldset>

      <div class="margin-block pad-inline pad-block fill-shade border-radius margin-none-block-start">
        <menu class="flex flex-column gap-half margin-none pad">
          <li class="flex align-center gap margin-none">
            Role

            <hr class="separator" aria-hidden="true">

            <%= form_with model: [:account, @user], data: { controller: "form" }, class: "flex align-center" do |form| %>
              <%= form.select :role, %w[member administrator].map { |role| [role.titleize, role] }, {}, class: "txt-small", data: { action: "change->form#submit" } %>
            <% end %>
          </li>
        </menu>
      </div>

      <%= render "users/profiles/transfer", user: @user %>
    <% end %>

    <% if Current.user.can_administer? && Current.user != @user && !@user.bot? %>
      <hr class="margin-block-start borderless">
      <%= render "users/ban_button", user: @user %>
    <% end %>

  <% elsif @user.banned? %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <span class="txt-small txt-negative">Banned</span>
    </div>

    <% if Current.user.can_administer? && Current.user != @user %>
      <hr class="margin-block-start borderless">
      <%= render "users/ban_button", user: @user %>
    <% end %>

  <% else %>
    <div class="align-center center gap">
      <div class="avatar avatar--large">
        <%= avatar_image_tag(@user, alt: "") %>
      </div>
    </div>

    <div class="flex flex-column align-center gap-half">
      <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
      <span class="txt-small txt-muted">No longer active</span>
    </div>
  <% end %>
</section>
