<% @page_title = @user.name %>
<% @body_class = "sidebar profile" %>
<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% content_for :nav do %>
  <%= link_back %>
  <h1 class="navbar-title">Profile</h1>
<% end %>

<section class="profile-page">
  <% if @user.bot? %>
    <div class="profile-hero">
      <span class="profile-hero__avatar" style="view-transition-name: avatar-<%= @user.id %>">
        <span class="avatar"><%= avatar_image_tag(@user, alt: "") %></span>
      </span>
      <div class="profile-hero__body">
        <div class="profile-hero__name-row">
          <h1 class="profile-hero__name"><%= @user.name %></h1>
          <span class="member-badge"><%= icon_tag "bot" %> Bot</span>
        </div>
        <p class="profile-hero__meta"><%= @user.active? ? "Posts through the API" : "No longer active" %></p>
        <% if @user.active? %>
          <div class="profile-hero__actions">
            <%= link_to new_rooms_direct_path(user_ids: [ @user.id ]), class: "btn settings-save", data: { turbo_frame: "_top" } do %>
              Message
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  <% elsif @user.active? %>
    <div class="profile-hero">
      <span class="profile-hero__avatar" style="view-transition-name: avatar-<%= @user.id %>">
        <span class="avatar"><%= avatar_image_tag(@user, alt: "") %></span>
        <%# You're by definition here while looking at your own profile %>
        <% status = Current.user == @user ? :active : (@activity_statuses[@user.id] || :offline) %>
        <span class="status-dot <%= AccountsHelper::STATUS_CSS_CLASSES[status] %> profile-hero__dot" aria-hidden="true"></span>
      </span>

      <div class="profile-hero__body">
        <div class="profile-hero__name-row">
          <h1 class="profile-hero__name"><%= @user.name %></h1>
          <% if @user.administrator? %>
            <span class="profile-hero__glyph" title="Administrator"><%= icon_tag "crown" %></span>
          <% elsif @user.moderator? %>
            <span class="profile-hero__glyph" title="Moderator"><%= icon_tag "shield" %></span>
          <% end %>
          <% if @user.badge %>
            <%= badge_tag @user.badge %>
          <% end %>
        </div>

        <p class="profile-hero__meta">
          <%= dm_presence_label(status) %> · joined <%= @user.joined_at.strftime("%b %Y") %>
          <% if Current.user.can_administer? %>
            · <%= mail_to @user.email_address, class: "txt-undecorated profile-hero__email" %>
          <% end %>
        </p>

        <% if @user.bio.present? %>
          <p class="profile-hero__bio"><%= auto_link @user.bio %></p>
        <% end %>

        <% if @user.has_social_links? %>
          <div class="profile-hero__social flex align-center gap">
            <%= render "users/social_links", user: @user %>
          </div>
        <% end %>

        <div class="profile-hero__actions">
          <% if Current.user == @user %>
            <%= link_to user_profile_path, class: "btn settings-save" do %>
              <%= icon_tag "pencil" %>
              Edit profile
            <% end %>
          <% elsif Current.user.can_direct_message?(@user) %>
            <%= link_to new_rooms_direct_path(user_ids: [ @user.id ]), class: "btn settings-save", data: { turbo_frame: "_top" } do %>
              Message
            <% end %>
          <% end %>
          <%= link_to "All messages", user_messages_path(@user), class: "btn settings-chip-btn" %>
          <% if Current.user != @user %>
            <%= render "blocks/button", user: @user, compact: false, btn_class: "btn settings-chip-btn" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="profile-stats">
      <div class="profile-stat">
        <span class="profile-stat__value"><%= number_with_delimiter(@user.total_message_count) %></span>
        <span class="profile-stat__label">Messages</span>
      </div>
      <div class="profile-stat">
        <% streak = @user.current_streak %>
        <span class="profile-stat__value"><%= streak_icon(streak) %><%= number_with_delimiter(streak) if streak > 0 %></span>
        <span class="profile-stat__label">Day streak</span>
      </div>
      <div class="profile-stat">
        <span class="profile-stat__value"><%= number_with_delimiter(@shared_room_count) %></span>
        <span class="profile-stat__label"><%= Current.user == @user ? "Rooms" : "Shared rooms" %></span>
      </div>
    </div>

    <% if @recent_messages.any? %>
      <h2 class="profile-section-label">Recent messages</h2>
      <div class="profile-recent">
        <% @recent_messages.each do |message| %>
          <%= link_to room_at_message_path(message.room, message), class: "profile-recent__row" do %>
            <span class="profile-recent__meta">
              <span class="profile-recent__room"><%= room_display_name(message.room) %></span>
              <span class="profile-recent__time"><%= local_datetime_tag message.created_at, style: :compact %></span>
            </span>
            <span class="profile-recent__text"><%= truncate(message.body.to_plain_text, length: 120) %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if Current.user.staff? && Current.user != @user %>
      <div class="profile-card">
        <h2 class="profile-card__title">Moderation</h2>
        <p class="profile-card__body">Deactivate revokes the user's access. Ban also deletes their messages and blocks their IPs.</p>
        <div class="profile-card__actions">
          <% if @user.removable_by?(Current.user) %>
            <%= render "users/deactivate_button", user: @user %>
          <% end %>
          <%= render "users/ban_button", user: @user %>
        </div>
      </div>
    <% end %>

  <% elsif @user.banned? %>
    <div class="profile-hero">
      <span class="profile-hero__avatar banned" style="view-transition-name: avatar-<%= @user.id %>">
        <span class="avatar"><%= avatar_image_tag(@user, alt: "") %></span>
      </span>
      <div class="profile-hero__body">
        <div class="profile-hero__name-row">
          <h1 class="profile-hero__name"><%= @user.name %></h1>
          <span class="member-badge member-badge--negative">Banned</span>
        </div>
      </div>
    </div>

    <% if Current.user.staff? && Current.user != @user %>
      <div class="profile-card">
        <h2 class="profile-card__title">Moderation</h2>
        <div class="profile-card__actions">
          <%= render "users/ban_button", user: @user %>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="profile-hero">
      <span class="profile-hero__avatar" style="view-transition-name: avatar-<%= @user.id %>">
        <span class="avatar"><%= avatar_image_tag(@user, alt: "") %></span>
      </span>
      <div class="profile-hero__body">
        <div class="profile-hero__name-row">
          <h1 class="profile-hero__name"><%= @user.name %></h1>
          <span class="member-badge">Deactivated</span>
        </div>
      </div>
    </div>

    <% if @user.reactivatable_by?(Current.user) %>
      <div class="profile-card">
        <h2 class="profile-card__title">Moderation</h2>
        <div class="profile-card__actions">
          <%= render "users/deactivate_button", user: @user %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>
