<div class="setting-row" data-controller="density">
  <span class="setting-row__text">
    <span class="setting-row__title">Density</span>
    <span class="txt-small txt-muted">Row spacing in the sidebar</span>
  </span>
  <%= segmented_control_tag controller: "density", label: "Density", options: [
        { label: "Comfortable", action: "setOff", target: "offButton", selected: true },
        { label: "Compact", action: "setOn", target: "onButton" }
      ] %>
</div>
