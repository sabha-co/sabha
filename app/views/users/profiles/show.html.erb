<% @page_title = @user.name %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back %>
  </div>

  <div class="flex-item-justify-end">
    <%= form_with url: session_path, method: :delete, data: { controller: "sessions" } do %>
      <%= hidden_field_tag :push_subscription_endpoint, nil, data: { sessions_target: "pushSubscriptionEndpoint" } %>

      <button class="btn" data-action="sessions#logout:prevent">
        <%= icon_tag "logout" %>
        <span class="for-screen-reader">Log out</span>
      </button>
    <% end %>
  </div>
<% end %>

<section class="panel flex flex-column gap" style="view-transition-name: avatar-<%= @user.id %>">
  <%= render partial: "pwa/install_instructions" %>

  <div class="align-center center avatar__form gap" data-controller="upload-preview">
    <%= profile_form_with @user, class:"txt-medium" do |form| %>
      <label class="btn input--file">
        <%= icon_tag "camera" %>
        <%= form.file_field :avatar, id: "file", class: "input", accept: "image/*",
            data: { upload_preview_target: "input", action: "upload-preview#previewImage change->form#submit" } %>
        <span class="for-screen-reader">Upload avatar</span>
      </label>
    <% end %>

    <%= profile_form_with @user do |form| %>
      <label class="btn avatar input--file txt-xx-large">
        <%= image_tag user_image_path(@user), role: "presentation", size: 300, data: { upload_preview_target: "image" } %>
        <%= form.file_field :avatar, id: "file", class: "input", accept: "image/*",
                            data: { upload_preview_target: "input", action: "upload-preview#previewImage change->form#submit" } %>
        <span class="for-screen-reader">Avatar</span>
      </label>
    <% end %>

    <% if @user.avatar.attached? %>
      <%= button_to user_avatar_path(@user), method: :delete, class: "btn btn--negative txt-small avatar__delete-btn" do %>
        <%= icon_tag "minus" %>
        <span class="for-screen-reader">Delete avatar</span>
      <% end %>
    <% elsif Dicebear.enabled? %>
      <%= button_to user_avatar_shuffle_path, method: :post, class: "btn txt-small" do %>
        <%= icon_tag "refresh" %>
        <span class="for-screen-reader">Shuffle avatar</span>
      <% end %>
    <% end %>
  </div>

  <%= profile_form_with @user do |form| %>
    <div class="flex flex-column gap">

      <% if flash[:alert] %>
        <div class="margin-block pad-inline fill-negative border-radius">
          <p class="pad-inline-start txt-medium txt-negative"><%= flash[:alert] %></p>
        </div>
      <% end %>
      
      <div class="flex align-center gap">
        <%= translation_button(:user_name) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_field :name, value: @user.editable_name, class: "input txt-medium ", autocomplete: "name", placeholder: "Enter your name",
                              autofocus: true, required: true,  data: { "1p-ignore": true } %>
          <%= icon_tag "person" %>
        </label>
      </div>

      <div class="flex align-center gap">
        <%= translation_button(:email_address) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <% if Sabha.saas? %>
            <%= form.email_field :email_address, class: "input txt-medium", value: @user.email_address,
                                 disabled: true, readonly: true %>
          <% else %>
            <%= form.email_field :email_address, class: "input txt-medium", value: @user.email_address, autocomplete: "username",
                                 placeholder: "Enter your email address", required: true %>
          <% end %>
          <%= icon_tag "email" %>
        </label>
      </div>

      <% if @user.pending_email_change? && !Sabha.saas? %>
        <div class="flex align-center gap">
          <div class="btn" style="visibility: hidden;"></div>
          <p class="txt-small txt-muted margin-none">
            Pending: <strong><%= @user.unconfirmed_email %></strong> ·
            <%= button_tag "Cancel", type: :submit, form: "cancel-email-change", class: "btn btn--plain" %>
          </p>
        </div>
      <% end %>

      <div class="flex align-center gap">
        <%= translation_button(:twitter) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_field :twitter_url, class: "input txt-medium ", placeholder: "Your X profile", required: false %>
          <%= icon_tag "twitter" %>
        </label>
      </div>

      <div class="flex align-center gap">
        <%= translation_button(:linkedin) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_field :linkedin_url, class: "input txt-medium ", placeholder: "Your LinkedIn profile", required: false %>
          <%= icon_tag "linkedin" %>
        </label>
      </div>

      <div class="flex align-center gap">
        <%= translation_button(:website) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_field :personal_url, class: "input txt-medium ", placeholder: "Your website", required: false %>
          <%= icon_tag "web" %>
        </label>
      </div>

      <div class="flex align-start gap">
        <%= translation_button(:bio) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_area :bio, class: "input txt-medium", placeholder: "A few words about yourself…", maxlength: 200,
                             rows: 3, required: false %>
          <%= icon_tag "bio" %>
        </label>
      </div>

      <%= profile_form_submit_button %>
    </div>
  <% end %>

  <% if @user.pending_email_change? && !Sabha.saas? %>
    <%= form_with url: user_email_change_path, method: :delete, id: "cancel-email-change", class: "inline" do %>
    <% end %>
  <% end %>

  <div class="margin-block pad fill-shade border-radius">
    <section>
      <p class="txt-small txt-muted txt-label margin-block-end">Appearance</p>
      <%= render "users/profiles/theme" %>
    </section>

    <hr class="separator separator--row margin-block">

    <section>
      <p class="txt-small txt-muted txt-label">Notifications</p>
      <%= link_to edit_user_notification_settings_path, class: "setting-row txt-undecorated" do %>
        <span class="setting-row__text">
          <span class="setting-row__title">Notification preferences</span>
          <span class="txt-small txt-muted">Email, push, and per-room alerts</span>
        </span>
        <%= icon_tag "arrow-right", class: "txt-muted flex-item-no-shrink" %>
      <% end %>
    </section>

    <% if Rails.env.development? %>
      <hr class="separator separator--row margin-block">

      <section>
        <p class="txt-small txt-muted txt-label">Developer</p>
        <%= link_to user_push_subscriptions_url, class: "setting-row txt-undecorated" do %>
          <span class="setting-row__text">
            <span class="setting-row__title">Push notifications dev mode</span>
            <span class="txt-small txt-muted">Test push subscriptions on this device</span>
          </span>
          <%= icon_tag "arrow-right", class: "txt-muted flex-item-no-shrink" %>
        <% end %>
      </section>
    <% end %>
  </div>

  <%= render "users/profiles/transfer", user: @user %>
</section>
