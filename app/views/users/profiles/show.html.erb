<% @page_title = "Profile" %>

<%= render layout: "settings/shell", locals: { section: :profile } do %>
  <%= render partial: "pwa/install_instructions" %>

  <header class="settings-header">
    <div class="settings-header__scope">Your settings</div>
    <h1 class="settings-header__title">Profile</h1>
    <p class="settings-header__blurb">How you appear to everyone in <%= Current.account.name %>. Only you can change this.</p>
  </header>

  <% if flash[:alert] %>
    <div class="auth-card__alert" style="margin: 0 0 16px;"><div><%= flash[:alert] %></div></div>
  <% end %>

  <div class="settings-card" style="view-transition-name: avatar-<%= @user.id %>">
    <div class="settings-avatar-row" data-controller="upload-preview">
      <%= profile_form_with @user do |form| %>
        <label class="btn avatar input--file">
          <%= image_tag user_image_path(@user), role: "presentation", size: 300, data: { upload_preview_target: "image" } %>
          <%= form.file_field :avatar, class: "input", accept: "image/*",
                              data: { upload_preview_target: "input", action: "upload-preview#previewImage change->form#submit" } %>
          <span class="for-screen-reader">Avatar</span>
        </label>
      <% end %>

      <div class="flex align-center gap-half">
        <%= profile_form_with @user do |form| %>
          <label class="btn settings-chip-btn">
            Upload
            <%= form.file_field :avatar, accept: "image/*",
                data: { upload_preview_target: "input", action: "upload-preview#previewImage change->form#submit" } %>
            <span class="for-screen-reader">Upload avatar</span>
          </label>
        <% end %>

        <% if @user.avatar.attached? %>
          <%= button_to user_avatar_path(@user), method: :delete, class: "btn settings-chip-btn settings-chip-btn--negative" do %>
            Remove
          <% end %>
        <% elsif Dicebear.enabled? %>
          <%= button_to user_avatar_shuffle_path, method: :post, class: "btn settings-chip-btn" do %>
            Shuffle
          <% end %>
        <% end %>
      </div>
    </div>

    <%= profile_form_with @user do |form| %>
      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_name">Name</label>
        </div>
        <%= form.text_field :name, value: @user.editable_name, class: "input", autocomplete: "name", placeholder: "Enter your name",
                            required: true, data: { "1p-ignore": true } %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_email_address">Email</label>
        </div>
        <% if Sabha.saas? %>
          <%= form.email_field :email_address, class: "input", value: @user.email_address, disabled: true, readonly: true %>
        <% else %>
          <%= form.email_field :email_address, class: "input", value: @user.email_address, autocomplete: "username",
                               placeholder: "Enter your email address", required: true %>
        <% end %>
        <% if @user.pending_email_change? && !Sabha.saas? %>
          <p class="settings-field__hint">
            Pending: <strong><%= @user.unconfirmed_email %></strong> ·
            <%= link_to "Cancel", user_email_change_path, data: { turbo_method: :delete } %>
          </p>
        <% end %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_twitter_url">X profile</label>
        </div>
        <%= form.text_field :twitter_url, class: "input", placeholder: "Your X profile", required: false %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_linkedin_url">LinkedIn</label>
        </div>
        <%= form.text_field :linkedin_url, class: "input", placeholder: "Your LinkedIn profile", required: false %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_personal_url">Website</label>
        </div>
        <%= form.text_field :personal_url, class: "input", placeholder: "Your website", required: false %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_status_message">Status</label>
        </div>
        <%= form.text_field :status_message, class: "input", placeholder: "What are you up to?", maxlength: 80, required: false %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="user_bio">Bio</label>
        </div>
        <%= form.text_area :bio, class: "input", placeholder: "A few words about yourself…", maxlength: 200, rows: 3, required: false %>
      </div>

      <div class="settings-field">
        <%= profile_form_submit_button %>
      </div>
    <% end %>
  </div>
<% end %>
