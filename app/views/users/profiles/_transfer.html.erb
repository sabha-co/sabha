<% url = session_transfer_url(user.transfer_id) %>

<div class="flex flex-column gap" style="--row-gap: 0.5em">
  <div class="setting-row" style="padding-block: 0;">
    <span class="setting-row__text">
      <span class="setting-row__title" id="session_transfer_label">
        <% if Current.user != user %>
          Share to get them back into their account
        <% else %>
          Sign in on another device
        <% end %>
      </span>
      <span class="txt-small txt-muted">Transfer this session with a private link or QR code.</span>
    </span>

    <div class="flex align-center gap-half flex-item-no-shrink">
      <%= link_to_zoom_qr_code(url) do %>
        <span class="for-screen-reader">Show auto-login QR code</span>
        <%= icon_tag "qr-code" %>
      <% end %>

      <%= button_to_copy_to_clipboard(url) do %>
        <span class="for-screen-reader">Copy auto-login link</span>
        <%= icon_tag "copy-paste" %>
      <% end %>

      <%= web_share_session_button(url, "Your sign-in link", "This is your own private sign-in URL, DO NOT SHARE IT. Use it to sign-in on another device or if you get locked out.") do %>
        <span class="for-screen-reader">Share auto-login link</span>
        <%= icon_tag "share" %>
      <% end %>
    </div>
  </div>
</div>
