<div class="setting-row" data-controller="theme">
  <span class="setting-row__text">
    <span class="setting-row__title">Theme</span>
    <span class="txt-small txt-muted">System preference, or pick one</span>
  </span>
  <%= segmented_control_tag controller: "theme", label: "Theme", options: [
        { label: "Light", action: "setLight", target: "lightButton" },
        { label: "Dark", action: "setDark", target: "darkButton" },
        { label: "System", action: "setAuto", target: "autoButton" }
      ] %>
</div>
