<%= turbo_frame_tag "invite_link", class: "invite-frame" do %>
  <% invite_link = Current.user.active_invite_link %>
  <% if invite_link %>
    <% url = join_url(invite_link.code) %>
    <% qr_id = Base64.urlsafe_encode64(url) %>
    <div class="invite-link" data-controller="dialog">
      <div class="invite-link__head">
        <span class="setting-row__text">
          <span class="setting-row__title" id="invite_label">Your invite link</span>
          <span class="txt-small txt-muted">Anyone with this link can join <%= Current.account.name %>.</span>
        </span>
        <% if invite_link.expires? %>
          <span class="invite-status invite-status--alert"><%= invite_link.expiry_display %></span>
        <% else %>
          <span class="invite-status invite-status--active">Active</span>
        <% end %>
      </div>

      <div class="invite-url-row">
        <input type="text" class="invite-url-input" id="invite_url" value="<%= url %>" aria-labelledby="invite_label" readonly autocomplete="off">

        <%= button_to_copy_to_clipboard(url, btn_class: "btn settings-chip-btn", toast: "Invite link copied") do %>
          Copy
        <% end %>

        <button type="button" class="btn settings-chip-btn" data-action="dialog#open">
          <%= icon_tag "qr-code" %>
          <span class="for-screen-reader">Show invite QR code</span>
        </button>

        <%= web_share_session_button(url, "Join me in #{Current.account.name}", "Use this link to join me in #{Current.account.name}!", btn_class: "btn settings-chip-btn") do %>
          <%= icon_tag "share" %>
          <span class="for-screen-reader">Share invite link</span>
        <% end %>
      </div>

      <%= render "shared/qr_dialog", qr_id: qr_id, title: "Scan to join",
            note: "Scan from another device to join #{Current.account.name}." %>
    </div>

    <div class="setting-row">
      <span class="setting-row__text">
        <span class="setting-row__title">Generate a new link</span>
        <span class="txt-small txt-muted">The current link stops working immediately. There is no undo.</span>
      </span>
      <%= button_to user_invite_link_path, method: :post, class: "btn settings-chip-btn settings-chip-btn--negative flex-item-no-shrink" do %>
        Regenerate
      <% end %>
    </div>
  <% else %>
    <div class="setting-row">
      <span class="setting-row__text">
        <span class="setting-row__title">Invite people to <%= Current.account.name %></span>
        <span class="txt-small txt-muted">Create a personal link others can use to join.</span>
      </span>
      <%= button_to user_invite_link_path, method: :post, class: "btn settings-chip-btn flex-item-no-shrink" do %>
        Create link
      <% end %>
    </div>
  <% end %>
<% end %>
