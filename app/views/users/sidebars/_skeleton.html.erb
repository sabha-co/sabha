<%# Cold-start placeholder for the lazy sidebar frame — holds the list rhythm so
    nothing jumps when the real rooms land. Four rows, per the States comp. %>
<div class="sidebar-skeleton" aria-hidden="true">
  <% 4.times do %>
    <div class="sidebar-skeleton__row">
      <span class="sidebar-skeleton__glyph"></span>
      <span class="sidebar-skeleton__bar"></span>
    </div>
  <% end %>
</div>
