<%= tag.div class: "position-relative", data: { controller: "popover" } do %>
  <button type="button" class="btn options-btn" aria-expanded="false"
      data-popover-target="trigger" data-action="popover#toggle">
    <%= icon_tag "menu-dots-horizontal" %>
    <span class="for-screen-reader">Room options</span>
  </button>

  <%= popover_menu_tag "room-menu", aria: { label: "Room options" } do %>
    <%= link_to "Browse rooms", rooms_browse_path, class: "btn" %>

    <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
      <%= link_to "New forum", new_rooms_forum_path, class: "btn" %>
    <% end %>

    <%= link_to "Hidden rooms", user_hidden_rooms_path, class: "btn", data: { turbo_frame: :hidden_rooms } %>

    <%= link_to "Notifications", inbox_notifications_path, class: "btn" %>

    <%= link_to "Bookmarks", inbox_bookmarks_path, class: "btn" %>

    <%= button_to "Mark all as seen", inbox_clearance_path(stay: true), class: "btn",
          form_class: "room-menu__separated", data: { turbo_confirm: "Are you sure you want to mark everything as seen?" } %>
  <% end %>
<% end %>
