<%# Unread, the badge count and presence are derived, not stored — none of
    them touch the membership row, so the derived state must be part of the
    cache key. %>
<% membership_unread = membership.unread? %>
<% notifications_count = membership.unread_notifications_count.to_i %>
<% members = @direct_room_members&.dig(membership.room.id).presence || membership.room.users.without(membership.user).presence || [ membership.user ] %>
<% presence = members.many? ? nil : @direct_member_statuses&.dig(members.first.id) %>
<% cache [ membership, membership_unread, notifications_count, presence ] do %>
  <%= link_to_room membership.room, class: [ "direct", "unread": membership_unread, "badge": notifications_count > 0 ], id: dom_id(membership.room, :list),
        data: {
          sorted_list_target: "item",
          updated_at: membership.room.last_active_at&.iso8601
        } do %>
    <% if members.many? %>
      <div class="avatar__group">
        <% members.first(2).each do |member| %>
          <span class="avatar">
            <%= avatar_image_tag(member, size: 20, loading: :lazy) %>
          </span>
        <% end %>
      </div>
    <% else %>
      <span class="avatar direct__avatar">
        <%= avatar_image_tag(members.first, size: 48, loading: :lazy) %>
        <%= presence_dot_tag members.first, presence, surface: :direct %>
      </span>
    <% end %>

    <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
      <span class="txt-nowrap overflow-ellipsis">
        <span class="for-screen-reader">Direct message with</span>
        <%= Rooms::Direct.display_label(members, short: true) %>
      </span>
    </span>

    <% if notifications_count > 0 %><span class="notification-badge"><%= unread_badge_count(notifications_count) %></span><% end %>
  <% end %>
<% end %>
