<%= sidebar_turbo_frame_tag do %>
  <%= turbo_stream_from Current.account, :rooms %>
  <%= turbo_stream_from Current.user, :rooms %>

  <div data-controller="unread-indicator"
       data-unread-indicator-indicators-value='[{"selector":".direct.unread","class":"has-unread-dms","target":"dms"}]'
       data-action="rooms-list:unread@window->unread-indicator#update rooms-list:read@window->unread-indicator#update rooms-list:addBadge@window->unread-indicator#update">
    <div class="sidebar__container overflow-y overflow-hide-scrollbar"
        data-controller="badge-dot maintain-scroll debounce-updates"
        data-badge-dot-unread-class="badge"
        data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update rooms-list:addBadge@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize turbo:before-render@document->maintain-scroll#beforeRender">

    <header class="sidebar__workspace">
      <%= link_to root_path, class: "sidebar__workspace-logo", title: Current.account.name do %>
        <% if Current.account.logo.attached? %>
          <%= image_tag fresh_account_logo_path, alt: "", size: 64 %>
        <% else %>
          <span class="sidebar__workspace-initial" aria-hidden="true"><%= Current.account.name.first %></span>
        <% end %>
        <span class="for-screen-reader"><%= Current.account.name %> home</span>
      <% end %>

      <span class="sidebar__workspace-info">
        <span class="sidebar__workspace-name"><%= Current.account.name %></span>
        <%= link_to account_users_path, class: "sidebar__workspace-sub", title: "View members" do %><%= pluralize(@member_count, "member") %> · <%= here_now_label here_now_count %><% end %>
      </span>

      <% if Current.user.can_administer? %>
        <%= link_to edit_account_path, class: "btn sidebar__workspace-action", title: "Community settings" do %>
          <%= icon_tag "gear" %>
          <span class="for-screen-reader">Community settings</span>
        <% end %>
      <% else %>
        <%= link_to account_path, class: "btn sidebar__workspace-action", title: "About this community" do %>
          <%= icon_tag "info" %>
          <span class="for-screen-reader">About this community</span>
        <% end %>
      <% end %>
    </header>

    <nav class="sidebar__menu" aria-label="Tools">
      <%= link_to searches_path, id: "room-search", class: "btn sidebar__menu-item",
            data: { controller: "search-palette", action: "search-palette#open" } do %>
        <%= icon_tag "search" %>
        <span class="sidebar__menu-label">Search</span>
        <kbd class="sidebar__menu-kbd" data-search-palette-target="kbd">⌘K</kbd>
      <% end %>

      <%= turbo_stream_from Current.user, :sidebar_activity_indicator %>
      <%= render "users/sidebars/activity_indicator", user: Current.user %>

      <%= link_to inbox_direct_messages_path, class: "btn sidebar__menu-item", data: { unread_indicator_target: "dms" } do %>
        <%= icon_tag "messages" %>
        <span class="sidebar__menu-label">Direct messages</span>
      <% end %>

      <%= link_to inbox_threads_path, class: "btn sidebar__menu-item" do %>
        <%= icon_tag "threads" %>
        <span class="sidebar__menu-label">Threads</span>
      <% end %>

      <%= link_to inbox_bookmarks_path, class: "btn sidebar__menu-item" do %>
        <%= icon_tag "bookmark" %>
        <span class="sidebar__menu-label">Bookmarks</span>
      <% end %>
    </nav>

    <div class="rooms position-relative flex flex-col gap">
      <div id="favorites_section"
           data-controller="collapsible-section sorted-list sidebar-count"
           data-collapsible-section-key-value="favorites"
           data-sorted-list-attribute-value="updatedAt" data-sorted-list-order-value="desc"
           data-sidebar-count-container-value="starred_rooms"
           data-sidebar-count-hide-when-empty-value="true"
           data-action="rooms-list:unread@window->sorted-list#reSort rooms-list:read@window->sorted-list#reSort rooms-list:renamed@window->sorted-list#reSort"
           class="flex position-relative flex-col gap"
           <%= "hidden" if @starred_memberships.empty? %>>
        <button type="button" class="sidebar__section-toggle sidebar__section-toggle--full"
                aria-expanded="true"
                data-collapsible-section-target="toggle"
                data-action="collapsible-section#toggle">
          <span data-collapsible-section-target="icon" class="sidebar__section-icon"><%= icon_tag "caret-down" %></span>
          <h1 class="font-semibold txt-label sidebar__label">Favorites</h1>
          <span class="sidebar__label-count" data-sidebar-count-target="count" <%= "hidden" if @starred_memberships.size.zero? %>><%= @starred_memberships.size %></span>
        </button>

        <div data-collapsible-section-target="content" class="flex flex-col rooms-list">
          <%= render "users/sidebars/rooms/shared_rooms_list", list_name: :starred_rooms, memberships: @starred_memberships %>
        </div>
      </div>

      <div id="rooms_section"
           data-controller="collapsible-section sidebar-count"
           data-collapsible-section-key-value="rooms"
           data-sidebar-count-container-value="shared_rooms"
           class="flex position-relative flex-col gap">
        <div class="flex items-center justify-between gap-half">
          <button type="button" class="sidebar__section-toggle"
                  aria-expanded="true"
                  data-collapsible-section-target="toggle"
                  data-action="collapsible-section#toggle">
            <span data-collapsible-section-target="icon" class="sidebar__section-icon"><%= icon_tag "caret-down" %></span>
            <h1 class="font-semibold txt-label sidebar__label">Rooms</h1>
            <span class="sidebar__label-count" data-sidebar-count-target="count" <%= "hidden" if @shared_memberships.size.zero? %>><%= @shared_memberships.size %></span>
          </button>
          <div class="flex items-center gap-half">
            <%= render "users/sidebars/all_rooms_actions" %>
            <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
              <%= link_to new_rooms_open_path, class: "btn btn--small", aria: { label: "New Room" },
                    data: { turbo_frame: "new_room" } do %>
                <%= icon_tag "add" %>
                <span class="for-screen-reader">New Room</span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div data-collapsible-section-target="content" class="flex flex-col">
          <div data-controller="sorted-list" <%= all_rooms_sort_order %>
               data-action="rooms-list:unread@window->sorted-list#reSort rooms-list:read@window->sorted-list#reSort rooms-list:renamed@window->sorted-list#reSort"
               class="rail-rooms flex position-relative flex-col rooms-list">
            <%= render "users/sidebars/rooms/shared_rooms_list", list_name: :shared_rooms, memberships: @shared_memberships %>
          </div>
        </div>
      </div>

      <div id="forums_section"
           data-controller="collapsible-section sidebar-count"
           data-collapsible-section-key-value="forums"
           data-sidebar-count-container-value="forum_rooms"
           data-sidebar-count-hide-when-empty-value="true"
           class="flex position-relative flex-col gap"
           <%= "hidden" if @forum_memberships.empty? %>>
        <button type="button" class="sidebar__section-toggle sidebar__section-toggle--full"
                aria-expanded="true"
                data-collapsible-section-target="toggle"
                data-action="collapsible-section#toggle">
          <span data-collapsible-section-target="icon" class="sidebar__section-icon"><%= icon_tag "caret-down" %></span>
          <h1 class="font-semibold txt-label sidebar__label">Forums</h1>
          <span class="sidebar__label-count" data-sidebar-count-target="count" <%= "hidden" if @forum_memberships.size.zero? %>><%= @forum_memberships.size %></span>
        </button>
        <div data-collapsible-section-target="content" class="flex flex-col">
          <div data-controller="sorted-list" <%= all_rooms_sort_order %>
               data-action="rooms-list:unread@window->sorted-list#reSort rooms-list:read@window->sorted-list#reSort rooms-list:renamed@window->sorted-list#reSort"
               class="flex position-relative flex-col rooms-list">
            <%= render "users/sidebars/rooms/shared_rooms_list", list_name: :forum_rooms, memberships: @forum_memberships %>
          </div>
        </div>
      </div>

      <%= turbo_frame_tag :hidden_rooms %>

      <% if show_dm_section?(@direct_memberships) %>
        <div id="direct_messages_section"
             data-controller="collapsible-section sidebar-count"
             data-collapsible-section-key-value="direct-messages"
             data-sidebar-count-container-value="direct_rooms"
             data-sidebar-count-hide-when-empty-value="true"
             class="flex position-relative flex-col gap"
             <%= "hidden" if @direct_memberships.empty? %>>
          <div class="flex items-center justify-between gap-half">
            <button type="button" class="sidebar__section-toggle"
                    aria-expanded="true"
                    data-collapsible-section-target="toggle"
                    data-action="collapsible-section#toggle">
              <span data-collapsible-section-target="icon" class="sidebar__section-icon"><%= icon_tag "caret-down" %></span>
              <h1 class="font-semibold txt-label sidebar__label">Direct messages</h1>
              <span class="sidebar__label-count" data-sidebar-count-target="count" <%= "hidden" if @direct_memberships.size.zero? %>><%= @direct_memberships.size %></span>
            </button>
            <% if can_create_dms? %>
              <%= link_to inbox_direct_messages_path, class: "btn btn--small", aria: { label: "Direct messages" } do %>
                <%= icon_tag "add" %>
                <span class="for-screen-reader">New direct message</span>
              <% end %>
            <% end %>
          </div>
          <div data-collapsible-section-target="content" class="directs gap">
            <div id="direct_rooms" contents data-controller="sorted-list" data-sorted-list-attribute-value="updatedAt"
                 data-sorted-list-order-value="desc"
                 data-action="rooms-list:unread@window->sorted-list#reSort rooms-list:read@window->sorted-list#reSort">
              <%= render partial: "users/sidebars/rooms/direct", collection: @direct_memberships, as: :membership, cached: true %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <footer class="sidebar__footer">
      <%= render "users/sidebars/profile_menu" %>
    </footer>
    </div>

    <button id="sidebar-toggle" class="btn sidebar__toggle" data-action="click->toggle-class#toggle">
      <%= icon_tag "menu" %>
      <span class="for-screen-reader">Open menu</span>
    </button>

    <button class="btn sidebar__close d-hotwire-native-none" data-action="click->toggle-class#toggle" aria-label="Close sidebar">
      <%= icon_tag "close" %>
      <span class="for-screen-reader">Close sidebar</span>
    </button>
  </div>
<% end %>
