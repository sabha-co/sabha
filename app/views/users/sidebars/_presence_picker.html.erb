<%# The one control that names your chosen availability. It's replaced live after
    a successful change (see Users::PresencesController#update) because the presence
    broadcast only moves the dots and labels — never this, so the checkmark would
    otherwise keep pointing at the state you just left until the next full load. %>
<div role="radiogroup" aria-label="Presence" id="presence_picker">
  <% User.availabilities.each_key do |state| %>
    <button type="submit" name="user[availability]" value="<%= state %>"
            role="radio" aria-checked="<%= Current.user.availability == state %>"
            class="sidebar__presence-option">
      <span class="sidebar__presence-dot sidebar__presence-dot--<%= state %>" aria-hidden="true"></span>
      <span class="sidebar__presence-option-label"><%= presence_dot_label availability_dot(state) %></span>
      <%# Always rendered; the checked row reveals it in CSS, so the row
          keeps its height whichever option is selected. %>
      <span class="sidebar__presence-check" aria-hidden="true">&#10003;</span>
    </button>
  <% end %>
</div>
