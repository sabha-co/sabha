<%= tag.div class: "sidebar__profile",
      data: { controller: "popover theme", popover_placement_value: "bottom-start", action: "resize@window->popover#reposition" } do %>
  <button type="button" class="sidebar__me" title="Open profile menu"
          aria-haspopup="true" aria-expanded="false"
          data-popover-target="trigger" data-action="popover#toggle">
    <span class="sidebar__me-avatar">
      <figure class="avatar" style="--avatar-size: 32px;">
        <%= avatar_image_tag(Current.user, size: 32, loading: :lazy) %>
      </figure>
      <%= presence_dot_tag Current.user, Current.user.own_presence_dot, surface: :sidebar %>
    </span>
    <span class="sidebar__me-info">
      <span class="sidebar__me-name"><%= Current.user.name %></span>
      <%= presence_label_tag Current.user, Current.user.own_presence_dot, surface: :sidebar %>
    </span>
    <span class="sidebar__me-caret" aria-hidden="true"><%= icon_tag "caret-down" %></span>
  </button>

  <%= popover_menu_tag "sidebar__profile-popover", aria: { label: "Profile menu" } do %>
    <%= link_to user_path(Current.user), class: "sidebar__profile-summary" do %>
      <figure class="avatar" style="--avatar-size: 38px;">
        <%= avatar_image_tag(Current.user, size: 38, loading: :lazy) %>
      </figure>
      <span class="sidebar__profile-summary-info">
        <strong class="overflow-ellipsis"><%= Current.user.name %></strong>
        <span class="overflow-ellipsis"><%= Current.user.email_address %></span>
      </span>
      <span class="sidebar__profile-summary-arrow" aria-hidden="true">&rsaquo;</span>
    <% end %>

    <span class="sidebar__profile-divider" aria-hidden="true"></span>

    <%# click->popover#hold keeps the menu open through the click itself; only
        turbo:submit-end closes it, so a rejected change stays visible. %>
    <%= form_with url: user_presence_path, method: :patch, class: "sidebar__presence",
          data: { action: "click->popover#hold" } do %>
      <div role="radiogroup" aria-label="Presence">
        <% User.availabilities.each_key do |state| %>
          <% selected = Current.user.availability == state %>
          <button type="submit" name="user[availability]" value="<%= state %>"
                  role="radio" aria-checked="<%= selected %>"
                  class="sidebar__profile-menu-item sidebar__presence-option">
            <span class="status-dot <%= presence_dot_class availability_dot(state) %>" aria-hidden="true"></span>
            <span><%= presence_dot_label availability_dot(state) %></span>
            <% if selected %>
              <span class="sidebar__profile-menu-hint" aria-hidden="true"><%= icon_tag "check" %></span>
            <% end %>
          </button>
        <% end %>
      </div>
      <p class="sidebar__presence-hint">Do not disturb shows your status only — notifications are unchanged.</p>
    <% end %>

    <span class="sidebar__profile-divider" aria-hidden="true"></span>

    <%= link_to "Your settings", user_profile_path, class: "sidebar__profile-menu-item" %>
    <%= link_to user_appearance_path, class: "sidebar__profile-menu-item" do %>
      <span>Appearance</span>
      <span class="sidebar__profile-menu-hint" data-theme-target="currentTheme">Light</span>
    <% end %>

    <% if Current.account.settings.allow_users_to_create_invite_links? %>
      <%= link_to "Invitations", user_invitations_path, class: "sidebar__profile-menu-item" %>
    <% end %>

    <% if Current.user.staff? %>
      <%= link_to (Current.user.can_manage_account? ? edit_account_path : account_path), class: "sidebar__profile-menu-item" do %>
        <span>Community settings</span>
        <span class="sidebar__profile-menu-chip"><%= Current.user.administrator? ? "Admin" : "Mod" %></span>
      <% end %>
    <% end %>

    <span class="sidebar__profile-divider" aria-hidden="true"></span>

    <%= form_with url: session_path, method: :delete, class: "sidebar__profile-logout", data: { controller: "sessions" } do %>
      <%= hidden_field_tag :push_subscription_endpoint, nil, data: { sessions_target: "pushSubscriptionEndpoint" } %>
      <button class="sidebar__profile-menu-item txt-negative" data-action="sessions#logout:prevent">
        Log out
      </button>
    <% end %>
  <% end %>
<% end %>
