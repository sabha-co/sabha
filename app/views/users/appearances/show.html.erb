<% @page_title = "Appearance" %>

<%= render layout: "settings/shell", locals: { section: :appearance } do %>
  <header class="settings-header">
    <div class="settings-header__scope">Your settings</div>
    <h1 class="settings-header__title">Appearance</h1>
    <p class="settings-header__blurb">Theme and row density — saved on this device.</p>
  </header>

  <div class="settings-card">
    <%= render "users/profiles/theme" %>
    <%= render "users/profiles/density" %>
  </div>
<% end %>
