<% agent = UserAgent.parse(push_subscription.user_agent) %>
<div class="flex align-center gap membership-item">
  <div class="flex-item-grow min-width">
    <div class="txt-small"><strong><%= agent.browser %> <%= agent.version %> on <%= agent.platform %></strong></div>
    <div class="txt-x-small txt-muted overflow-ellipsis"><%= push_subscription.endpoint %></div>
  </div>

  <div class="flex align-center gap-half flex-item-no-shrink">
    <%= button_to "Test", user_push_subscription_test_notifications_path(push_subscription), class: "btn settings-chip-btn" %>
    <%= button_to "Remove", user_push_subscription_path(push_subscription), method: :delete,
          class: "btn settings-chip-btn settings-chip-btn--negative",
          form: { data: { turbo_confirm: "Remove this device from push notifications?" } } %>
  </div>
</div>
