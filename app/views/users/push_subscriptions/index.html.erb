<% @page_title = "Push notifications" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to_last_room_visited %>
  </div>
<% end %>

<section class="panel panel--wide">
  <header class="settings-header">
    <div class="settings-header__scope">Your settings</div>
    <h1 class="settings-header__title">Push notifications</h1>
    <p class="settings-header__blurb">Devices signed up to receive push notifications from <%= Branding.contextual_app_name %>.</p>
  </header>

  <div class="settings-card" id="push_subscriptions">
    <% if @push_subscriptions.any? %>
      <%= render partial: "users/push_subscriptions/push_subscription", collection: @push_subscriptions %>
    <% else %>
      <p class="txt-small txt-muted margin-none">No devices are subscribed yet. Enable push notifications from your notification settings.</p>
    <% end %>
  </div>
</section>
