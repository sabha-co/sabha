<%# locals: (user:) -%>
<div class="quick-profile flex flex-column gap">
  <% if user.bot? %>
    <div class="flex align-start gap">
      <div class="avatar avatar--small">
        <%= avatar_image_tag(user, alt: "") %>
      </div>
      <div class="flex flex-column gap-half">
        <strong class="txt-medium"><%= user.name %></strong>
        <% if user.active? %>
          <span class="txt-x-small txt-muted txt-label">Bot</span>
        <% else %>
          <span class="txt-small txt-muted">No longer active</span>
        <% end %>
      </div>
    </div>
    <% if user.active? %>
      <%= button_to_direct_room_with user %>
    <% end %>

  <% elsif user.active? %>
    <div class="flex align-start gap">
      <%= link_to user_path(user), data: { turbo_frame: "_top" } do %>
        <div class="avatar avatar--small">
          <%= avatar_image_tag(user, alt: "") %>
        </div>
      <% end %>
      <div class="flex flex-column gap-half" style="min-width: 0;">
        <strong class="txt-medium">
          <%= link_to user.name, user_path(user), title: user.title, class: "txt-undecorated txt-primary", data: { turbo_frame: "_top" } %>
        </strong>
        <% if user.bio.present? %>
          <p class="txt-small txt-lighter margin-none" style="line-height: 1.35;"><%= auto_link truncate(user.bio, length: 80) %></p>
        <% end %>
      </div>
    </div>

    <% message_count = user.total_message_count %>
    <% rank = user.message_rank %>
    <div class="flex flex-column gap-half">
      <div class="flex align-center justify-space-between pad-block-half border-top border-bottom">
        <span class="txt-x-small txt-muted txt-label">Joined <%= user.joined_at.strftime("%b %Y") %></span>
        <% if user.has_social_links? %>
          <span class="flex align-center gap-half">
            <%= render "users/social_links", user: user %>
          </span>
        <% end %>
      </div>

      <div class="flex gap">
        <%= render "users/user_stats", user: user, message_count: message_count, rank: rank %>
      </div>
    </div>

    <div class="flex align-center gap">
      <%= link_to user_path(user), class: "btn txt-small", data: { turbo_frame: "_top" } do %>
        <%= icon_tag "person" %>
        <span>View profile</span>
      <% end %>
      <% if Current.user.can_direct_message?(user) %>
        <%= link_to rooms_directs_path(user_ids: [user.id]), class: "btn btn--reversed txt-small", data: { turbo_frame: "_top", turbo_method: :post } do %>
          <%= icon_tag "messages" %>
          <span>Ping</span>
        <% end %>
      <% end %>
    </div>

  <% else %>
    <div class="flex align-start gap">
      <div class="avatar avatar--small">
        <%= avatar_image_tag(user, alt: "") %>
      </div>
      <div class="flex flex-column gap-half">
        <strong class="txt-medium"><%= user.name %></strong>
        <span class="txt-small txt-muted">No longer active</span>
      </div>
    </div>
  <% end %>
</div>
