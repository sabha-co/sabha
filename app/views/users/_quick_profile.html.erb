<%# locals: (user:) -%>
<div class="quick-profile flex flex-column gap">
  <% if user.bot? %>
    <div class="flex align-start gap">
      <span class="quick-profile__avatar">
        <span class="avatar"><%= avatar_image_tag(user, alt: "") %></span>
      </span>
      <div class="flex flex-column gap-half" style="min-width: 0;">
        <div class="flex align-center gap-half">
          <strong class="txt-medium"><%= user.name %></strong>
          <%= render "users/role_badge", user: user %>
        </div>
        <% if user.bio.present? %>
          <p class="txt-small txt-lighter margin-none" style="line-height: 1.35;"><%= auto_link truncate(user.bio, length: 80) %></p>
        <% end %>
        <span class="txt-x-small txt-muted">Added <%= user.joined_at.strftime("%b %Y") %><%= " · webhook configured" if user.webhook.present? %></span>
      </div>
    </div>

    <div class="quick-profile__actions flex align-center gap">
      <%= link_to user_path(user), class: "btn txt-small", data: { turbo_frame: "_top" } do %>
        <%= icon_tag "person" %>
        <span>View profile</span>
      <% end %>
      <% if Current.user.administrator? %>
        <%= link_to edit_account_bot_path(user), class: "btn btn--reversed txt-small", data: { turbo_frame: "_top" } do %>
          <%= icon_tag "gear" %>
          <span>Manage bot</span>
        <% end %>
      <% elsif user.active? %>
        <%= link_to_direct_room_with user %>
      <% end %>
    </div>

  <% elsif user.active? %>
    <% presence_dot = user.presence_dot_now %>
    <div class="flex align-start gap">
      <span class="quick-profile__avatar">
        <%= link_to user_path(user), class: "avatar", data: { turbo_frame: "_top" } do %>
          <%= avatar_image_tag(user, alt: "") %>
        <% end %>
        <%= presence_dot_tag user, presence_dot, surface: :quick_profile %>
      </span>
      <div class="quick-profile__identity flex flex-column gap-half">
        <div class="flex align-center gap-half">
          <strong class="quick-profile__name">
            <%= link_to user.name, user_path(user), title: user.title, class: "txt-undecorated txt-primary", data: { turbo_frame: "_top" } %>
          </strong>
          <%= render "users/role_badge", user: user %>
        </div>
        <% if presence_dot %>
          <span class="quick-profile__status"><%= presence_dot_label presence_dot %></span>
        <% end %>
        <% if user.bio.present? %>
          <p class="quick-profile__bio margin-none"><%= auto_link user.bio %></p>
        <% end %>
      </div>
    </div>

    <div class="quick-profile__stats flex align-center justify-space-between pad-block-half border-top">
      <div class="quick-profile__stats-values flex gap">
        <%= render "users/user_stats", user: user, message_count: user.total_message_count, streak: user.current_streak, show_joined: true %>
      </div>
      <% if user.has_social_links? %>
        <span class="flex align-center gap-half">
          <%= render "users/social_links", user: user %>
        </span>
      <% end %>
    </div>

    <div class="quick-profile__actions flex align-center gap">
      <%= link_to user_path(user), class: "btn txt-small", data: { turbo_frame: "_top" } do %>
        <%= icon_tag "person" %>
        <span>View profile</span>
      <% end %>
      <% if user == Current.user %>
        <%= link_to user_profile_path, class: "btn btn--reversed txt-small", data: { turbo_frame: "_top" } do %>
          <%= icon_tag "pencil" %>
          <span>Edit profile</span>
        <% end %>
      <% elsif Current.user.can_direct_message?(user) %>
        <%= link_to new_rooms_direct_path(user_ids: [user.id]), class: "btn btn--reversed txt-small", data: { turbo_frame: "_top" } do %>
          <%= icon_tag "messages" %>
          <span>Direct message</span>
        <% end %>
      <% end %>
    </div>

  <% else %>
    <div class="flex align-start gap">
      <span class="quick-profile__avatar quick-profile__avatar--muted">
        <span class="avatar"><%= avatar_image_tag(user, alt: "") %></span>
      </span>
      <div class="flex flex-column gap-half">
        <strong class="txt-medium"><%= user.name %></strong>
        <span class="txt-small txt-muted">No longer active</span>
      </div>
    </div>

    <div class="quick-profile__actions flex align-center gap">
      <%= link_to user_path(user), class: "btn txt-small", data: { turbo_frame: "_top" } do %>
        <%= icon_tag "person" %>
        <span>View profile</span>
      <% end %>
    </div>
  <% end %>
</div>
