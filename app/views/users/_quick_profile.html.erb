<%# locals: (user:) -%>
<section class="quick-profile">
  <% if user.bot? %>
    <div class="quick-profile__header">
      <div class="quick-profile__avatar">
        <%= avatar_image_tag(user, class: "avatar", alt: "") %>
      </div>
      <div class="quick-profile__header-info">
        <h1 class="quick-profile__name"><%= user.name %></h1>
        <% if user.active? %>
          <span class="quick-profile__badge">Bot</span>
        <% else %>
          <span class="quick-profile__status">No longer active</span>
        <% end %>
      </div>
    </div>
    <% if user.active? %>
      <div class="quick-profile__actions">
        <%= button_to_direct_room_with user %>
      </div>
    <% end %>
  <% elsif user.active? %>
    <div class="quick-profile__header">
      <div class="quick-profile__avatar">
        <%= avatar_image_tag(user, class: "avatar", alt: "") %>
      </div>
      <div class="quick-profile__header-info">
        <h1 class="quick-profile__name">
          <%= link_to user.name, user_path(user), title: user.title, class: "quick-profile__name-link", data: { turbo_frame: "_top" } %>
        </h1>
        <% if user.bio.present? %>
          <p class="quick-profile__bio"><%= auto_link truncate(user.bio, length: 80) %></p>
        <% end %>
      </div>
    </div>

    <div class="quick-profile__meta">
      <span class="quick-profile__joined">Joined <%= user.joined_at.strftime("%b %Y") %></span>
      <% if (links = social_links_for(user)).any? %>
        <span class="quick-profile__links">
          <% links.each do |link| %>
            <%= link_to with_protocol(link[:url]), target: "_blank", class: "quick-profile__social-link", title: link[:title] do %>
              <%= image_tag link[:icon], size: 16 %>
            <% end %>
          <% end %>
        </span>
      <% end %>
    </div>

    <div class="quick-profile__stats">
      <% rank = user.message_rank %>
      <div class="quick-profile__stat">
        <span class="quick-profile__stat-value"><%= rank_medal(rank) %><%= number_with_delimiter(user.total_message_count) %></span>
        <span class="quick-profile__stat-label"><%= "message".pluralize(user.total_message_count) %></span>
      </div>
      <div class="quick-profile__stat">
        <span class="quick-profile__stat-value">#<%= number_with_delimiter(rank) %></span>
        <span class="quick-profile__stat-label">rank</span>
      </div>
    </div>

    <div class="quick-profile__actions">
      <% if Current.user.can_direct_message?(user) %>
        <%= button_to rooms_directs_path(user_ids: [user.id]), class: "btn btn--reversed quick-profile__ping-btn", data: { turbo_frame: "_top" } do %>
          <%= image_tag "messages.svg", size: 16, aria: { hidden: true } %>
          <span>Ping</span>
        <% end %>
      <% end %>
      <%= link_to "All messages", user_messages_path(user), class: "quick-profile__messages-link", data: { turbo_frame: "_top" } %>
    </div>
  <% else %>
    <div class="quick-profile__header">
      <div class="quick-profile__avatar">
        <%= avatar_image_tag(user, class: "avatar", alt: "") %>
      </div>
      <div class="quick-profile__header-info">
        <h1 class="quick-profile__name"><%= user.name %></h1>
        <span class="quick-profile__status">No longer active</span>
      </div>
    </div>
  <% end %>
</section>
