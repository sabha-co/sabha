<%# locals: (user:) -%>
<% cache [user, "popup", user.updated_at] do %>
  <%= tag.div class: "avatar position-relative", data: { controller: "popover", popover_placement_value: "bottom-start" } do %>
    <button type="button" class="btn avatar" aria-expanded="false"
        data-popover-target="trigger" data-action="popover#toggle">
      <%= avatar_tag user, loading: :lazy %>
    </button>

    <%= popover_menu_tag "message__avatar-menu", action: "turbo:frame-load->popover#reposition", aria: { label: user.name } do %>
      <%= turbo_frame_tag dom_id(user, :message_profile),
                          data: { turbo_frame_src: mention_profile_path(user) } do %>
        <div class="txt-align-center pad">
          <div class="spinner"></div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
