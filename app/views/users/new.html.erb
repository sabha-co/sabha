<% @page_title = "Sign up" %>
<% @body_class = "signup" %>

<%# Turnstile's script carries data-turbo-track="reload"; loading it only where
    the widget renders keeps it off every other page, where it would otherwise
    force a full reload on every Turbo Drive navigation. %>
<% content_for :head, cloudflare_turnstile_script_tag %>

<div class="auth-ground">
  <section class="auth-card <%= "shake" if flash[:alert] %>">
    <header class="auth-card__header">
      <%= link_to root_path, class: "auth-card__logo" do %>
        <%= image_tag fresh_account_logo_path, alt: Current.account.name %>
      <% end %>
      <div>
        <h1 class="auth-card__title">Join <%= Current.account.name %></h1>
        <p class="auth-card__blurb">
          <% if @join_code.personal? %>
            <strong><%= @join_code.user.name %></strong> invited you to join.
          <% else %>
            You've been invited to join.
          <% end %>
        </p>
      </div>
    </header>

    <div class="auth-card__meta">
      <span><%= @member_count %> members</span>
      <span>&middot;</span>
      <%= here_now_label @here_now_count_extended, window: "24 hours" %>
    </div>

    <% if flash[:notice] %>
      <div class="auth-card__alert auth-card__alert--positive"><div><%= flash[:notice] %></div></div>
    <% end %>

    <% if flash[:alert] %>
      <div class="auth-card__alert"><div><%= flash[:alert] %></div></div>
    <% end %>

    <% if saas_unauthenticated? %>
      <%# SaaS: User is not logged in - show sign up/sign in options %>
      <%= link_to untenanted_path(:new_registration, return_to: @return_to_url), class: "btn auth-card__submit" do %>
        Sign up to join
      <% end %>

      <p class="auth-card__note">
        Already have an account? <%= link_to "Sign in", untenanted_path(:new_session, return_to: @return_to_url) %>
      </p>
    <% elsif saas_authenticated? %>
      <%# SaaS: User is globally authenticated, one-click join %>
      <%= form_with model: @user, url: request.fullpath do |form| %>
        <%= form.button class: "btn auth-card__submit", type: "submit" do %>
          Join <%= Current.account.name %>
        <% end %>
      <% end %>

      <p class="auth-card__note">
        Joining as <strong><%= Current.global_identity.email_address %></strong>
      </p>
    <% else %>
      <%# Self-hosted or new SaaS user: full signup form %>
      <%= form_with model: @user, url: request.fullpath do |form| %>
        <div class="auth-card__field" data-controller="name-field">
          <div class="auth-card__label">
            <label for="user_name">Your name</label>
          </div>
          <%= form.text_field :name, class: "input", autocomplete: "name", placeholder: "How you want to be known", autofocus: true, required: true,
                minlength: 2, maxlength: 100, data: { "1p-ignore": true, action: "input->name-field#validate" } %>
          <p class="auth-card__note txt-negative" hidden data-name-field-target="hint">This looks like an email address. Your name goes here!</p>
        </div>

        <div class="auth-card__field">
          <div class="auth-card__label">
            <label for="user_email_address">Email</label>
          </div>
          <%= form.email_field :email_address, class: "input", autocomplete: "username", placeholder: "you@example.com", required: true %>
        </div>

        <% unless Account.otp_auth? %>
          <div class="auth-card__field">
            <div class="auth-card__label">
              <label for="user_password">Password</label>
            </div>
            <%= form.password_field :password, class: "input", autocomplete: "new-password",
                placeholder: "At least #{User::MINIMUM_PASSWORD_LENGTH} characters", required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72 %>
          </div>
        <% end %>

        <div class="auth-card__field flex justify-center"><%= cloudflare_turnstile %></div>

        <%= form.button class: "btn auth-card__submit", type: "submit" do %>
          <%= Account.otp_auth? ? "Email me a code" : "Create account" %>
        <% end %>
      <% end %>

      <p class="auth-card__note">
        <% if Account.otp_auth? %>
          We email a code to confirm the address. No password needed.
        <% else %>
          You will get an email to confirm the address before you can post.
        <% end %>
      </p>

      <footer class="auth-card__footer">
        Already have an account? <%= link_to "Sign in", new_session_path(return_to: request.fullpath), class: "auth-card__label-link" %>
      </footer>
    <% end %>
  </section>
</div>
