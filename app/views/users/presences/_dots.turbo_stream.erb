<%# Replays one subject's dot across the surfaces it was asked for, and the words
    beside it wherever a surface prints them — a dot that turns amber next to a
    label still reading "Available" is worse than not moving at all. Only the
    surfaces the viewer actually has on screen match a target; Turbo discards the
    rest. Which surfaces arrive is decided by the caller, so a payload is never
    larger than its audience can use. %>
<% surfaces.each do |surface| %>
  <%# The sidebar footer is only ever your own, and it answers a different
      question than everyone else's dots do: what you chose, not how you look
      from outside. Reflecting idleness back at the person who is demonstrably
      right there would just be wrong. %>
  <% shown = surface == :sidebar ? user.own_presence_dot : dot %>

  <%= turbo_stream.replace presence_dot_id(user, surface) do %>
    <%= presence_dot_tag user, shown, surface: surface %>
  <% end %>

  <% if presence_labelled?(surface) %>
    <%= turbo_stream.replace presence_label_id(user, surface) do %>
      <%= presence_label_tag user, shown, surface: surface %>
    <% end %>
  <% end %>
<% end %>
