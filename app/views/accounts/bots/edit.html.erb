<% @page_title = "Edit bot" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_bot_path(@bot) %>
  </div>
<% end %>

<section class="panel flex flex-column gap" style="view-transition-name: chat-bot-<%= @bot.id %>">
  <div class="flex align-center gap pad-inline">
    <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3em;">
      <%= avatar_tag @bot %>
    </figure>

    <div class="min-width flex-item-grow">
      <h1 class="margin-none txt-large"><strong>Edit <%= @bot.name %></strong></h1>
      <p class="txt-small txt-muted margin-none">Update identity and delivery settings.</p>
    </div>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <%= form_with model: @bot, url: account_bot_path(@bot), class: "flex flex-column gap" do |form| %>
    <%= render "accounts/bots/form", form: form, bot: @bot %>
  <% end %>
</section>
