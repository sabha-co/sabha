<% @page_title = "#{@bot.name} room access" %>

<%= render layout: "settings/shell", locals: { section: :bots } do %>
<div class="flex flex-column gap">
  <p class="margin-none"><%= link_to "‹ Back to #{@bot.name}", account_bot_path(@bot), class: "txt-small txt-muted txt-undecorated" %></p>
  <div class="flex align-center gap pad-inline">
    <figure class="avatar flex-item-no-shrink" style="--avatar-size: 2em;">
      <%= avatar_tag @bot %>
    </figure>

    <div class="min-width flex-item-grow">
      <h1 class="margin-none txt-large"><strong>Room access</strong></h1>
      <p class="txt-small txt-muted margin-none"><%= @bot.name %> · <%= pluralize(@bot_memberships.size, "room") %></p>
    </div>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="pad-inline flex flex-column gap-half">
    <% if @bot_memberships.any? %>
      <menu class="flex flex-column gap-half margin-none pad-none">
        <% @bot_memberships.each do |membership| %>
          <li>
            <%= link_to account_bot_room_permission_path(@bot, membership.room),
                  class: "flex align-center gap pad-block-half", style: "text-decoration: none; color: inherit;" do %>
              <%= room_type_indicator(membership.room) %>
              <span class="flex-item-grow min-width overflow-ellipsis"><%= room_display_name(membership.room) %></span>
              <span class="txt-small txt-muted txt-nowrap"><% case membership.involvement
                when "mentions" %>Mentions only<% when "nothing" %>Muted<% end %></span>
              <%= icon_tag "arrow-right" %>
            <% end %>
          </li>
        <% end %>
      </menu>
    <% else %>
      <p class="txt-small txt-muted margin-none">Not in any rooms yet. Add this bot to a room to start posting messages.</p>
    <% end %>

    <% if @available_rooms.any? %>
      <details class="pad-block-half">
        <summary class="btn btn--small txt-small">
          <%= icon_tag "add" %>
          <span>Add to room</span>
        </summary>

        <menu class="flex flex-column gap-half margin-none pad-none pad-block-start">
          <% @available_rooms.each do |room| %>
            <li>
              <%= link_to account_bot_room_permission_path(@bot, room),
                    class: "flex align-center gap pad-block-half", style: "text-decoration: none; color: inherit;" do %>
                <%= room_type_indicator(room) %>
                <span class="flex-item-grow min-width overflow-ellipsis txt-muted"><%= room.name %></span>
                <%= icon_tag "arrow-right" %>
              <% end %>
            </li>
          <% end %>
        </menu>
      </details>
    <% end %>
  </div>
</div>
<% end %>
