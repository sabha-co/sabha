<li>
  <%= link_to account_bot_path(bot), class: "flex align-center gap pad-block-half pad-inline fill-shade border-radius txt-undecorated", style: "view-transition-name: chat-bot-#{ bot.id }" do %>
    <figure class="avatar flex-item-no-shrink" style="--avatar-size: 2.4em;">
      <%= avatar_tag bot, loading: :lazy %>
    </figure>

    <div class="min-width flex-item-grow">
      <div class="overflow-ellipsis txt-small"><strong><%= bot.name %></strong> <span class="txt-x-small txt-muted" title="Bot"><%= icon_tag "bot" %></span></div>
      <div class="txt-x-small txt-muted"><%= pluralize(bot.rooms.without_directs.without_threads.count, "room") %></div>
    </div>

    <%= icon_tag "arrow-right", class: "txt-muted flex-item-no-shrink" %>
  <% end %>
</li>
