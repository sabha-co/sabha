<div class="bot-row" id="<%= dom_id(bot) %>" data-controller="dialog" data-action="turbo:submit-end->dialog#closeOnSubmit">
  <figure class="avatar bot-row__avatar"><%= avatar_tag bot, loading: :lazy %></figure>

  <div class="bot-row__body">
    <div class="bot-row__name"><%= bot.name %> <span class="bot-tag">bot</span></div>
    <div class="bot-row__meta"><%= bot_rooms_summary(bot) %></div>
    <div class="bot-row__hook"><%= bot_webhook_summary(bot) %></div>
  </div>

  <div class="bot-row__actions">
    <%= link_to "Edit", edit_account_bot_path(bot), class: "bot-action", data: { turbo_frame: "bot_editor" } %>
    <%= button_to "Rotate key", account_bot_key_path(bot), method: :put, class: "bot-action" %>
    <button type="button" class="bot-action bot-action--danger" data-action="dialog#open">Remove</button>
  </div>

  <dialog class="scrim-dialog scrim-dialog--bot-remove" aria-label="Remove <%= bot.name %>"
          data-dialog-target="modal" data-action="click->dialog#closeOnScrim">
    <div class="scrim-dialog__header scrim-dialog__header--titled">
      <h2 class="scrim-dialog__title">Remove <%= bot.name %>?</h2>
    </div>
    <div class="scrim-dialog__body">
      <div class="bot-remove-warning">Its key stops working immediately and any integration using it will start failing. Messages it already posted stay in their rooms.</div>
      <div class="scrim-dialog__footer">
        <button type="button" class="btn" data-action="dialog#close">Cancel</button>
        <%= button_to "Remove bot", account_bot_path(bot), method: :delete, class: "btn btn--negative" %>
      </div>
    </div>
  </dialog>
</div>
