<% @page_title = @bot.name %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_bots_path %>
  </div>
<% end %>

<section class="panel panel--wide flex flex-column gap" style="view-transition-name: chat-bot-<%= @bot.id %>">
  <div class="flex align-center gap pad-inline-double">
    <figure class="avatar flex-item--no-shrink" style="--avatar-size: 3em;">
      <%= avatar_tag @bot %>
    </figure>

    <div class="min-width flex-item-grow">
      <h1 class="margin-none txt-x-large"><%= @bot.name %></h1>
    </div>

    <%= link_to edit_account_bot_path(@bot), class: "btn", aria: { label: "Edit #{@bot.name}" } do %>
      <%= icon_tag "pencil" %>
    <% end %>
  </div>

  <% if @bot.webhook_url.present? %>
    <div class="pad-inline">
      <div class="flex align-center gap">
        <%= icon_tag "web" %>
        <span class="flex-item-grow txt-small txt-muted overflow-ellipsis"><%= @bot.webhook_url %></span>
        <%= button_to_copy_to_clipboard(@bot.webhook_url) do %>
          <%= icon_tag "copy-paste" %>
          <span class="for-screen-reader">Copy webhook URL</span>
        <% end %>
      </div>
    </div>
  <% end %>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="pad-inline flex flex-column gap-half">
    <h2 class="txt-small txt-muted margin-none">Rooms</h2>

    <% if @bot_memberships.any? %>
      <menu class="flex flex-column gap-half margin-none pad-none">
        <% @bot_memberships.each do |membership| %>
          <li>
            <%= link_to account_bot_room_permission_path(@bot, membership.room),
                  class: "flex align-center gap pad-block-half", style: "text-decoration: none; color: inherit;" do %>
              <%= room_type_indicator(membership.room) %>
              <span class="flex-item-grow"><%= room_display_name(membership.room) %></span>
              <span class="badge txt-small"><%= membership.involvement.humanize %></span>
              <%= icon_tag "chevron-right" %>
            <% end %>
          </li>
        <% end %>
      </menu>
    <% else %>
      <p class="txt-small txt-muted">Not in any rooms yet.</p>
    <% end %>

    <% if @available_rooms.any? %>
      <details class="pad-block-half">
        <summary class="btn btn--small txt-small">
          <%= icon_tag "add" %>
          <span>Add to room</span>
        </summary>

        <menu class="flex flex-column gap-half margin-none pad-none pad-block-start">
          <% @available_rooms.each do |room| %>
            <li>
              <%= link_to account_bot_room_permission_path(@bot, room),
                    class: "flex align-center gap pad-block-half", style: "text-decoration: none; color: inherit;" do %>
                <%= room_type_indicator(room) %>
                <span class="flex-item-grow txt-muted"><%= room.name %></span>
                <%= icon_tag "chevron-right" %>
              <% end %>
            </li>
          <% end %>
        </menu>
      </details>
    <% end %>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="flex align-center gap justify-space-between">
    <%= button_to account_bot_path(@bot), method: :delete, class: "btn txt-small btn--negative", aria: { label: "Delete this chat bot" },
          data: { turbo_confirm: "Are you sure you want to permanently remove this bot from the account? This can't be undone." } do %>
      <%= icon_tag "trash" %>
      <%= icon_tag "bot" %>
    <% end %>

    <%= button_to account_bot_key_path(@bot), method: :put, class: "btn full-width txt-small btn--negative", aria: { label: "Generate a new key" },
          data: { turbo_confirm: "Are you sure you want to change the bot key? All usage of this bot must be updated." } do %>
      <%= icon_tag "refresh" %>
      <%= icon_tag "key" %>
    <% end %>
  </div>
</section>
