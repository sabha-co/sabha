<% @page_title = @bot.name %>

<%= render layout: "settings/shell", locals: { section: :bots } do %>
<div class="flex flex-column gap" style="view-transition-name: chat-bot-<%= @bot.id %>">
  <div class="flex align-center gap pad-inline">
    <figure class="avatar flex-item--no-shrink" style="--avatar-size: 3em;">
      <%= avatar_tag @bot %>
    </figure>

    <div class="min-width flex-item-grow">
      <h1 class="margin-none txt-x-large"><%= @bot.name %> <span class="txt-small txt-muted" title="Bot"><%= icon_tag "bot" %></span></h1>
      <p class="txt-small txt-muted margin-none">Post messages to rooms via the API, receive events in real-time.</p>
    </div>

    <%= link_to edit_account_bot_path(@bot), class: "btn", aria: { label: "Edit #{@bot.name}" } do %>
      <%= icon_tag "pencil" %>
    <% end %>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="pad-inline flex flex-column gap-half">
    <h2 class="txt-small txt-muted margin-none"><strong>Credentials</strong></h2>

    <label class="flex flex-column gap-half">
      <span class="txt-x-small txt-muted">Base URL</span>
      <div class="flex align-center gap">
        <div class="flex-item-grow min-width">
          <input type="text" class="input input--small full-width fill-white txt-small" value="<%= request.base_url %><%= request.script_name %>" readonly>
        </div>
        <%= button_to_copy_to_clipboard("#{request.base_url}#{request.script_name}") do %>
          <%= icon_tag "copy-paste" %>
          <span class="for-screen-reader">Copy base URL</span>
        <% end %>
      </div>
    </label>

    <label class="flex flex-column gap-half">
      <span class="txt-x-small txt-muted">Bot key</span>
      <div class="flex align-center gap">
        <div class="flex-item-grow min-width">
          <input type="text" class="input input--small full-width fill-white txt-small" value="<%= @bot.bot_key %>" readonly>
        </div>
        <%= button_to_copy_to_clipboard(@bot.bot_key) do %>
          <%= icon_tag "copy-paste" %>
          <span class="for-screen-reader">Copy bot key</span>
        <% end %>
      </div>
    </label>

    <% if @bot.webhook_configured? %>
      <label class="flex flex-column gap-half">
        <span class="txt-x-small txt-muted">Webhook secret</span>
        <div class="flex align-center gap">
          <div class="flex-item-grow min-width">
            <input type="text" class="input input--small full-width fill-white txt-small" value="<%= @bot.webhook_secret %>" readonly>
          </div>
          <%= button_to_copy_to_clipboard(@bot.webhook_secret) do %>
            <%= icon_tag "copy-paste" %>
            <span class="for-screen-reader">Copy webhook secret</span>
          <% end %>
        </div>
      </label>
    <% end %>

    <div class="flex flex-column gap-half">
      <span class="txt-x-small txt-muted">Delivery</span>
      <p class="txt-small margin-none">
        WebSocket — enabled by default.
      </p>
      <p class="txt-small margin-none">
        <% if @bot.webhook_url.present? %>
          Webhook — <span class="txt-muted"><%= @bot.webhook_url %></span>
          <%= link_to "Edit", edit_account_bot_path(@bot), class: "txt-underlined txt-muted txt-x-small" %>
        <% else %>
          Webhook — <span class="txt-muted">not configured.</span>
          <%= link_to "Add one", edit_account_bot_path(@bot), class: "txt-underlined txt-muted txt-x-small" %>
        <% end %>
      </p>
    </div>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="pad-inline">
    <%= link_to account_bot_rooms_path(@bot),
          class: "flex align-center gap pad-block-half pad-inline fill-shade border-radius txt-undecorated" do %>
      <div class="flex-item-grow min-width">
        <div class="txt-small"><strong>Room access</strong></div>
        <div class="txt-x-small txt-muted">Choose which rooms this bot can post in and how events are delivered.</div>
      </div>
      <span class="txt-small txt-muted txt-nowrap"><%= pluralize(@rooms_count, "room") %></span>
      <%= icon_tag "arrow-right", class: "txt-muted flex-item-no-shrink" %>
    <% end %>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="pad-inline flex flex-column gap-half">
    <h2 class="txt-small txt-muted margin-none"><strong>How bots work</strong></h2>

    <div class="flex flex-column gap-half">
      <p class="txt-small margin-none"><strong>Receiving events</strong> — Your bot client connects over WebSocket using its bot key. Events stream in real-time.</p>
      <p class="txt-small margin-none"><strong>Webhook delivery</strong> — Set a webhook URL and Sabha POSTs every event to it as a signed JSON request, alongside the WebSocket broadcast. Useful for stateless bots that can't hold a persistent connection.</p>
      <p class="txt-small margin-none"><strong>Sending messages</strong> — POST to the per-room message URL (shown on each room's settings page) with <code>Authorization: Bearer &lt;bot_key&gt;</code>.</p>
    </div>

    <%= render "curl_example",
          bot: @bot,
          url: "#{request.base_url}#{request.script_name}/api/bots/rooms/<room_id>/messages",
          body: "Hello from your bot" %>

    <p class="txt-x-small txt-muted margin-none"><%= link_to "Full API reference →", skill_path, target: "_blank", class: "txt-underlined" %></p>
  </div>

  <hr class="separator full-width" style="--border-style: solid">

  <div class="pad-inline flex flex-column gap-half">
    <%= button_to account_bot_key_path(@bot), method: :put, class: "btn full-width txt-small btn--negative",
          data: { turbo_confirm: "Are you sure you want to rotate the bot key? All integrations using this bot must be updated." } do %>
      <%= icon_tag "refresh" %>
      <span>Rotate bot key</span>
    <% end %>

    <%= button_to account_bot_path(@bot), method: :delete, class: "btn full-width txt-small btn--negative",
          data: { turbo_confirm: "Are you sure you want to permanently delete this bot? This can't be undone." } do %>
      <%= icon_tag "trash" %>
      <span>Delete bot</span>
    <% end %>
  </div>
</div>
<% end %>
