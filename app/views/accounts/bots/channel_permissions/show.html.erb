<% @page_title = "#{@bot.name} in #{@channel.name}" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_bot_path(@bot) %>
  </div>
<% end %>

<section class="panel flex flex-column gap">
  <div class="flex align-center gap pad-inline">
    <figure class="avatar flex-item--no-shrink" style="--avatar-size: 2em;">
      <%= avatar_tag @bot %>
    </figure>

    <div class="min-width flex-item-grow">
      <h1 class="margin-none txt-large overflow-ellipsis"><%= channel_type_indicator(@channel) %> <%= channel_display_name(@channel) %></h1>
      <p class="txt-small txt-muted margin-none"><%= @bot.name %></p>
    </div>
  </div>

  <% if @membership %>
    <div class="pad-inline flex flex-column gap">
      <%= form_with url: account_bot_channel_permission_path(@bot, @channel), method: :patch,
            data: { controller: "form" } do %>
        <label class="txt-small txt-muted" for="involvement">Event delivery</label>
        <%= select_tag :involvement,
              options_for_select([
                ["Mentions only", "mentions"],
                ["Muted", "nothing"]
              ], @membership.involvement),
              id: "involvement", class: "input full-width",
              data: { action: "change->form#submit" } %>
      <% end %>

      <p class="txt-small txt-muted margin-none">
        <% if @membership.involvement == "mentions" %>Bot receives events when @mentioned or in a DM. Applies to WebSocket and webhook delivery.
        <% elsif @membership.involvement == "nothing" %>Bot receives no events from this channel. It can still post and read via the API.<% end %>
      </p>

      <% message_url = api_bots_channel_messages_url(@channel) %>
      <label class="txt-small txt-muted">Message URL — POST to this URL with <code>Authorization: Bearer &lt;bot_key&gt;</code> to send messages to this channel</label>
      <div class="flex align-center gap">
        <div class="flex-item-grow min-width">
          <input type="text" class="input full-width fill-white txt-small" value="<%= message_url %>" aria-label="Message URL" readonly>
        </div>
        <%= button_to_copy_to_clipboard(message_url) do %>
          <%= icon_tag "copy-paste" %>
          <span class="for-screen-reader">Copy message URL</span>
        <% end %>
      </div>

      <label class="txt-small txt-muted">Example — send a message into this channel from your code or CI.</label>
      <%= render "accounts/bots/curl_example", bot: @bot, url: message_url, body: "Hello from #{@channel.name}" %>

      <hr class="separator full-width" style="--border-style: solid">

      <%= button_to account_bot_channel_permission_path(@bot, @channel), method: :delete,
            class: "btn btn--negative full-width txt-small",
            data: { turbo_confirm: "Remove #{@bot.name} from #{@channel.name}?" } do %>
        <%= icon_tag "minus" %>
        <span>Remove from channel</span>
      <% end %>
    </div>
  <% else %>
    <div class="pad-inline flex flex-column gap">
      <p class="txt-small txt-muted"><%= @bot.name %> does not have access to this channel.</p>
      <p class="txt-small txt-muted margin-none">Adding the bot will grant it permission to post and read messages. Event delivery defaults to mentions only — you can change this after adding.</p>

      <%= button_to account_bot_channel_permission_path(@bot, @channel), method: :post,
            class: "btn btn--primary full-width" do %>
        <%= icon_tag "add" %>
        <span>Add to channel</span>
      <% end %>
    </div>
  <% end %>
</section>
