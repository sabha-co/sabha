<fieldset class="gap max-width pad border border-radius">
  <legend class="min-width txt-align-start pad-inline">
    <strong class="overflow-ellipsis">Direct message</strong>
  </legend>

  <% curl_text_line = %[curl -H "Authorization: Bearer #{bot.bot_key}" -H "Content-Type: application/json" #{api_bots_direct_messages_url} -d '{ "user_ids": [ "#{Current.user.id}" ] }'] %>
  <div class="flex align-center gap">
    <%= icon_tag "add" %>

    <div class="flex-item-grow">
      <input type="text" class="input full-width fill-white" value="<%= curl_text_line %>" aria-label="curl command for creating a direct message" readonly>
    </div>

    <div class="txt-small">
      <%= button_to_copy_to_clipboard(curl_text_line) do %>
        <%= icon_tag "copy-paste" %>
        <span class="for-screen-reader">Copy command for creating a direct message</span>
      <% end %>
    </div>
  </div>
</fieldset>
