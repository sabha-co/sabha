<% @page_title = "Invitations" %>
<% join_code = @account.join_code %>
<% url = join_url(join_code.code) %>

<%= render layout: "settings/shell", locals: { section: :invitations } do %>
  <header class="settings-header">
    <div class="settings-header__scope">Community settings</div>
    <h1 class="settings-header__title">Invitations</h1>
    <p class="settings-header__blurb">One join link for the whole community, plus whether members can mint their own.</p>
  </header>

  <div class="settings-card">
    <div class="invite-link">
      <div class="invite-link__head">
        <span class="setting-row__text">
          <span class="setting-row__title" id="invite_label">Join link</span>
          <span class="txt-small txt-muted">
            One code for the whole community. Anyone with the link can create an account.
            <% if join_code.used? %><%= join_code.usage_display %>.<% end %>
          </span>
        </span>
        <% if join_code.expires? %>
          <span class="invite-status invite-status--alert"><%= join_code.expiry_display %></span>
        <% else %>
          <span class="invite-status invite-status--active">Active</span>
        <% end %>
      </div>

      <div class="invite-url-row">
        <input type="text" class="invite-url-input" id="invite_url" value="<%= url %>" aria-labelledby="invite_label" readonly>

        <%= button_to_copy_to_clipboard(url, btn_class: "btn settings-chip-btn") do %>
          Copy
        <% end %>

        <%= link_to_zoom_qr_code(url, btn_class: "btn settings-chip-btn") do %>
          <%= icon_tag "qr-code" %>
          <span class="for-screen-reader">Show join link QR code</span>
        <% end %>

        <%= web_share_session_button(url, "Link to join #{Current.account.name}", "Hit this link to join me in #{Current.account.name} and start chatting.", btn_class: "btn settings-chip-btn") do %>
          <%= icon_tag "share" %>
          <span class="for-screen-reader">Share join link</span>
        <% end %>
      </div>
    </div>

    <%= form_with url: account_join_code_path, method: :patch, data: { controller: "form" } do %>
      <label class="setting-row">
        <span class="setting-row__text">
          <span class="setting-row__title">Expire this link</span>
          <span class="txt-small txt-muted"><%= join_code.expires? ? "#{join_code.expiry_display}." : "It works until you regenerate it." %></span>
        </span>
        <span class="switch">
          <input type="checkbox" class="switch__input" <%= "checked" if join_code.expires? %> data-action="change->form#submit">
          <span class="switch__btn round"></span>
          <span class="for-screen-reader"><%= join_code.expires? ? "Make this link permanent" : "Set this link to expire" %></span>
        </span>
      </label>
    <% end %>

    <div class="setting-row">
      <span class="setting-row__text">
        <span class="setting-row__title">Generate a new link</span>
        <span class="txt-small txt-muted">Every link already shared stops working immediately. There is no undo.</span>
      </span>
      <%= button_to account_join_code_path, class: "btn settings-chip-btn settings-chip-btn--negative flex-item-no-shrink" do %>
        Regenerate
      <% end %>
    </div>
  </div>

  <div class="settings-card">
    <%= render "accounts/setting_toggle", account: @account, scope: :settings,
          attribute: :allow_users_to_create_invite_links,
          title:     "Allow everyone to create invite links",
          hint:      "Off means only admins can generate invite URLs." %>
  </div>

  <p class="settings-footnote">There is no email invitation queue &mdash; people join by opening a link, so nothing is pending here.</p>
<% end %>
