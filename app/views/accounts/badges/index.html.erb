<% @page_title = "Badges" %>

<%= render layout: "settings/shell", locals: { section: :badges } do %>
  <header class="settings-header">
    <div class="settings-header__scope">Community settings</div>
    <h1 class="settings-header__title">Badges</h1>
    <p class="settings-header__blurb">One badge per person, shown beside their name everywhere. Names cap at 10 characters.</p>
  </header>

  <div class="settings-card">
    <div id="badges_list" class="badges-list">
      <% if @badges.any? %>
        <%= render partial: "accounts/badges/badge", collection: @badges, as: :badge %>
      <% else %>
        <%= render "accounts/badges/empty" %>
      <% end %>
    </div>

    <div class="badge-footer">
      <div class="badge-footer__text">Assign a badge from the role menu on any member in the directory.</div>
      <%= link_to new_account_badge_path, class: "btn settings-chip-btn", data: { turbo_frame: "badge_editor" } do %>
        <%= icon_tag "add" %><span>New badge</span>
      <% end %>
    </div>
  </div>

  <%# Editor dialog mounted once; new/edit load their form into this frame. %>
  <dialog id="badge_editor_dialog" class="scrim-dialog scrim-dialog--badge-editor" aria-label="Badge editor"
          data-controller="dialog"
          data-action="click->dialog#closeOnScrim turbo:submit-end->dialog#closeOnSubmit turbo:before-cache@document->dialog#close">
    <%= turbo_frame_tag "badge_editor", data: { action: "turbo:frame-load->dialog#open" } %>
  </dialog>
<% end %>
