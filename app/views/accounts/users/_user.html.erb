<%# locals: (user:) %>
<%= turbo_frame_tag dom_id(user), class: "list-row member-row #{"banned" if user.banned?}" do %>
  <span class="member-row__avatar list-row__avatar">
    <%= render "users/popup", user: user %>
    <% unless user.bot? %>
      <span class="member-row__dot status-dot <%= activity_status_class(user) %>" aria-hidden="true"></span>
    <% end %>
  </span>

  <div class="list-row__body">
    <div class="flex align-center gap-half min-width">
      <%= link_to user_path(user), class: "txt-undecorated list-row__title", data: { turbo_frame: "_top" } do %>
        <strong><%= user.name %></strong>
        <% if user == Current.user %><span class="txt-x-small txt-muted">(you)</span><% end %>
      <% end %>
      <% if user.bot? %>
        <span class="member-badge" title="Bot"><%= icon_tag "bot" %> Bot</span>
      <% elsif user.badge %>
        <span class="member-badge" <%= tag.attributes(style: "--badge-color: #{user.badge.color}") if user.badge.color.present? %>><%= user.badge.name %></span>
      <% end %>
    </div>
    <div class="list-row__subtitle">
      <% if user.bot? %>
        Posts through the API
      <% else %>
        <%= { "status--active" => "Here now", "status--away" => "Away", "status--offline" => "Offline" }[activity_status_class(user)] %> · joined <%= user.created_at.year %>
      <% end %>
    </div>
  </div>

  <% if user.bot? %>
    <% if Current.user.can_administer? %>
      <div class="member-controls list-row__trailing flex align-center gap">
        <%= link_to account_bot_path(user), class: "btn txt-small flex-item-no-shrink", data: { turbo_frame: "_top" } do %>
          <%= icon_tag "settings" %>
          <span class="for-screen-reader">Manage <%= user.name %></span>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% has_controls = user.manageable_by?(Current.user) || user.reactivatable_by?(Current.user) || user.unbannable_by?(Current.user) || user == Current.user %>

    <% if has_controls %>
      <div class="member-controls list-row__trailing flex align-center gap">
        <% if user.manageable_by?(Current.user) %>
          <%= link_to edit_account_user_path(user), class: "btn settings-chip-btn flex-item-no-shrink",
                data: { turbo_frame: "manage_member" } do %>
            Manage
          <% end %>
        <% end %>

        <% if user.reactivatable_by?(Current.user) %>
          <%= button_to account_user_reactivation_path(user), method: :post, class: "btn settings-chip-btn flex-item-no-shrink", data: {
                turbo_confirm: "Reactivate #{user.name}? They will be able to log in again." } do %>
            Reactivate
          <% end %>
        <% elsif user.unbannable_by?(Current.user) %>
          <%= button_to user_ban_path(user), method: :delete, class: "btn settings-chip-btn flex-item-no-shrink", data: {
                turbo_confirm: "Unban #{user.name}? They will be able to access the chat again." } do %>
            Unban
          <% end %>
        <% end %>

        <% if user == Current.user %>
          <%= link_to user_profile_path, class: "btn txt-small flex-item-no-shrink", target: "_top" do %>
            <%= icon_tag "pencil" %>
            <span class="for-screen-reader">My settings</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
