<%# locals: (user:) %>
<%= turbo_frame_tag dom_id(user), class: class_names("list-row", "member-row", "is-deactivated": user.deactivated?, "is-banned": user.banned?) do %>
<%# Your own row says nothing about your presence — you're the one reading it. %>
<% show_presence = !user.bot? && user != Current.user %>
<% dot = show_presence ? @presence_dots&.dig(user.id) : nil %>
  <span class="member-row__avatar list-row__avatar">
    <%= render "users/popup", user: user %>
    <%# The subscription lives in the layout, not in this frame — a row that
        re-renders would otherwise tear its own stream source down and rebuild
        it, and one workspace stream covers every row here anyway. %>
    <%= presence_dot_tag user, dot, surface: :member %>
  </span>

  <div class="list-row__body">
    <div class="flex align-center gap-half min-width">
      <%= link_to user_path(user), class: "txt-undecorated list-row__title", data: { turbo_frame: "_top" } do %>
        <strong><%= user.name %></strong>
        <% if user == Current.user %><span class="txt-x-small txt-muted">(you)</span><% end %>
      <% end %>
      <% if user.bot? %>
        <span class="member-badge" title="Bot"><%= icon_tag "bot" %> Bot</span>
      <% elsif user.badge %>
        <%= badge_tag user.badge %>
      <% end %>
      <% if user.deactivated? %>
        <span class="status-chip status-chip--deactivated">Deactivated</span>
      <% elsif user.banned? %>
        <span class="status-chip status-chip--banned">Banned</span>
      <% end %>
    </div>
    <div class="list-row__subtitle">
      <% if user.bot? %>
        Posts through the API
      <% elsif dot %>
        <%= presence_label_tag user, dot, surface: :member %>
      <% else %>
        Joined <%= user.created_at.strftime("%B %Y") %>
      <% end %>
    </div>
  </div>

  <% if user.bot? %>
    <% if Current.user.can_administer? %>
      <div class="member-controls list-row__trailing">
        <%# account_bot_path has no GET route (bots exclude :show); manage bots on the bots settings page. %>
        <%= link_to account_bots_path, class: "btn txt-small flex-item-no-shrink", data: { turbo_frame: "_top" } do %>
          <%= icon_tag "settings" %>
          <span class="for-screen-reader">Manage <%= user.name %></span>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="member-controls list-row__trailing">
      <% if user.manageable_by?(Current.user) && user != Current.user %>
        <%= link_to edit_account_user_path(user), class: "member-role__control",
              aria: { label: "Manage #{user.name}" }, data: { turbo_frame: "manage_member" } do %>
          <span class="member-role__name"><%= user.role.capitalize %></span>
          <span class="member-role__caret" aria-hidden="true">▾</span>
        <% end %>
      <% elsif user.reactivatable_by?(Current.user) %>
        <%= button_to account_user_reactivation_path(user), method: :post, class: "btn settings-chip-btn flex-item-no-shrink", data: {
              turbo_confirm: "Reactivate #{user.name}? They will be able to log in again." } do %>
          Reactivate
        <% end %>
      <% elsif user.unbannable_by?(Current.user) %>
        <%= button_to user_ban_path(user), method: :delete, class: "btn settings-chip-btn flex-item-no-shrink", data: {
              turbo_confirm: "Unban #{user.name}? They will be able to access the chat again." } do %>
          Unban
        <% end %>
      <% else %>
        <span class="member-role__readonly"><%= user.role.capitalize %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
