<%= turbo_stream.remove :next_page_container %>

<%= turbo_stream.append :members_section do %>
  <%= render partial: "accounts/users/user", collection: @members, as: :user %>
<% end %>

<% unless @page.last? %>
  <%= turbo_stream.append :members_section, partial: "accounts/users/next_page_container", locals: { page: @page.next_param } %>
<% end %>
