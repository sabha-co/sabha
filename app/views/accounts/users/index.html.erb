<% @page_title = "Members" %>
<%# This directory is one of the pages that draws other people's dots, so it
    opts into the workspace presence stream while it's open. The layout only
    subscribes you to your own. %>
<%= turbo_stream_from Current.account, :presence %>

<%= render layout: "settings/shell", locals: { section: :members } do %>
  <header class="settings-header">
    <div class="settings-header__scope">Community settings</div>
    <h1 class="settings-header__title">Members</h1>
    <p class="settings-header__blurb"><%= pluralize(@member_count, "member") %> · <%= online_users_count %> here now</p>
  </header>

  <section class="members-page">
  <div class="members-toolbar">
    <%= form_with url: account_users_path, method: :get, data: { turbo_frame: "account_users", controller: "form" }, class: "members-toolbar__form" do |f| %>
      <%= f.search_field :query,
            value: params[:query],
            class: "input txt-small members-toolbar__search",
            placeholder: "Search members",
            data: { action: "input->form#debouncedSubmit" } %>
    <% end %>

    <% if Current.user.staff? && (@deactivated_count.to_i > 0 || @banned_count.to_i > 0 || @filtering_deactivated || @filtering_banned) %>
      <nav class="segmented-control" aria-label="Member status">
        <%= link_to "All", account_users_path,
              class: class_names("segmented-control__btn", "member-status-tab", "member-status-tab--active": !@filtering_deactivated && !@filtering_banned, "segmented-control__btn--active": !@filtering_deactivated && !@filtering_banned) %>
        <% if @deactivated_count.to_i > 0 || @filtering_deactivated %>
          <%= link_to "Deactivated (#{@deactivated_count.to_i})", account_users_path(status: "deactivated"),
                class: class_names("segmented-control__btn", "member-status-tab", "member-status-tab--active": @filtering_deactivated, "segmented-control__btn--active": @filtering_deactivated) %>
        <% end %>
        <% if @banned_count.to_i > 0 || @filtering_banned %>
          <%= link_to "Banned (#{@banned_count.to_i})", account_users_path(status: "banned"),
                class: class_names("segmented-control__btn", "member-status-tab", "member-status-tab--active": @filtering_banned, "segmented-control__btn--active": @filtering_banned) %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <div class="members-list">
    <turbo-frame id="account_users">
      <% if @searching %>
        <% if @users.any? %>
          <div class="members-roster">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Results</span>
              <span class="members-roster__band-count"><%= @users.size %></span>
            </div>
            <div class="role-section">
              <%= render partial: "accounts/users/user", collection: @users, as: :user %>
            </div>
          </div>
        <% else %>
          <div class="empty-state">
            <p class="empty-state__title">No one matches <% if params[:query].present? %>&ldquo;<%= params[:query] %>&rdquo;<% else %>your search<% end %></p>
            <p class="empty-state__body">Search runs on names, and only over people you can see. Deactivated accounts are staff-visible.</p>
          </div>
        <% end %>
      <% elsif @filtering_deactivated %>
        <% if @users.any? %>
          <div class="members-roster">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Deactivated</span>
              <span class="members-roster__band-count"><%= @users.size %></span>
            </div>
            <div class="role-section">
              <%= render partial: "accounts/users/user", collection: @users, as: :user %>
            </div>
          </div>
        <% else %>
          <div class="empty-state">
            <p class="empty-state__title">No deactivated accounts</p>
            <p class="empty-state__body">Deactivated members can no longer sign in, but everything they wrote stays visible.</p>
          </div>
        <% end %>
      <% elsif @filtering_banned %>
        <% if @users.any? %>
          <div class="members-roster">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Banned</span>
              <span class="members-roster__band-count"><%= @users.size %></span>
            </div>
            <div class="role-section">
              <%= render partial: "accounts/users/user", collection: @users, as: :user %>
            </div>
          </div>
        <% else %>
          <div class="empty-state">
            <p class="empty-state__title">No banned accounts</p>
            <p class="empty-state__body">Banning removes the person and deletes everything they posted.</p>
          </div>
        <% end %>
      <% else %>
        <div class="members-roster">
          <div class="members-roster__group">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Administrators</span>
              <span class="members-roster__band-count"><%= @administrators.size %></span>
            </div>
            <div id="administrators_section" class="role-section">
              <%= render partial: "accounts/users/user", collection: @administrators, as: :user %>
            </div>
          </div>

          <div class="members-roster__group">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Moderators</span>
              <span class="members-roster__band-count"><%= @moderators.size %></span>
            </div>
            <div id="moderators_section" class="role-section">
              <%= render partial: "accounts/users/user", collection: @moderators, as: :user %>
            </div>
          </div>

          <div class="members-roster__group">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Members</span>
              <span class="members-roster__band-count"><%= @members_total %></span>
            </div>
            <div id="members_section" class="role-section">
              <%= render partial: "accounts/users/user", collection: @members, as: :user %>
              <%= render "accounts/users/next_page_container", page: @page.next_param unless @page.last? %>
            </div>
          </div>

          <div class="members-roster__group">
            <div class="members-roster__band">
              <span class="members-roster__band-label">Bots</span>
              <span class="members-roster__band-count"><%= @bots&.size.to_i %></span>
            </div>
            <div id="bots_section" class="role-section">
              <%= render partial: "accounts/users/user", collection: @bots, as: :user %>
            </div>
          </div>
        </div>
      <% end %>
    </turbo-frame>
  </div>
  </section>

  <dialog id="manage_member_dialog" class="scrim-dialog" style="--dialog-width: 290px" aria-label="Manage member"
          data-controller="dialog"
          data-action="click->dialog#closeOnScrim turbo:submit-end->dialog#closeOnSubmit">
    <%= turbo_frame_tag "manage_member", data: { action: "turbo:frame-load->dialog#open" } %>
  </dialog>
<% end %>
