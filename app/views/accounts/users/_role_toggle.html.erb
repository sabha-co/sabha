<%# locals: (user:, role:, icon:) %>
<% active = user.public_send("#{role}?") %>
<%= form_with model: user, url: account_user_path(user), data: { controller: "form" }, method: :patch do |form| %>
  <label class="btn txt-small flex-item-no-shrink <%= "btn--active" if active %>"
         for="<%= dom_id(user, role) %>"
         title="<%= active ? "Remove #{role}" : "Make #{role}" %>">
    <span class="for-screen-reader"><%= active ? "Remove #{role}" : "Make #{role}" %></span>
    <%= icon_tag icon %>
    <%= form.check_box :role,
          { data: { action: "form#submit" }, hidden: true, id: dom_id(user, role), disabled: user == Current.user },
          role.to_s,
          "member" %>
  </label>
<% end %>
