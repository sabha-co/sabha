<% @page_title = "Identity" %>

<%= render layout: "settings/shell", locals: { section: :identity } do %>
  <header class="settings-header">
    <div class="settings-header__scope">Community settings</div>
    <h1 class="settings-header__title">Identity</h1>
    <p class="settings-header__blurb">How <%= @account.name %> introduces itself. Administrators keep this up to date.</p>
  </header>

  <div class="settings-card" style="view-transition-name: account-settings">
    <div class="settings-avatar-row">
      <%= account_logo_tag style: "account-logo--display" %>
      <div>
        <strong><%= @account.name %></strong>
        <div class="txt-small txt-muted"><%= pluralize(@member_count, "member") %> · <%= online_users_count %> here now · <%= pluralize(@room_count, "room") %></div>
      </div>
    </div>

    <% if Current.user.can_administer? %>
      <%= link_to "Edit community identity", edit_account_path, class: "btn settings-chip-btn" %>
    <% else %>
      <p class="txt-small txt-muted margin-none">Only administrators can change the community’s name or logo.</p>
    <% end %>
  </div>
<% end %>
