<% @page_title = "Account settings" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to account_path %>
  </div>

  <div class="flex align-center gap flex-item-justify-end">
    <%= link_to account_users_path, class: "btn" do %>
      <%= icon_tag "everyone" %>
      <span class="for-screen-reader">Manage members</span>
    <% end %>

    <%= link_to account_bots_path, class: "btn", style: "view-transition-name: chat-bots" do %>
      <%= icon_tag "bot" %>
      <span class="for-screen-reader">Set up chat bots</span>
    <% end %>
  </div>
<% end %>

<section class="panel" style="view-transition-name: account-settings">
  <header class="settings-header">
    <div class="settings-header__scope">Community settings</div>
    <h1 class="settings-header__title">Identity</h1>
    <p class="settings-header__blurb">Name and logo. Changes here are seen by every member.</p>
  </header>

  <div class="settings-card">
    <div class="settings-avatar-row" data-controller="upload-preview">
      <%= form_with model: @account, method: :patch, data: { controller: "form" } do |form| %>
        <label class="btn avatar input--file account-logo">
          <%= image_tag fresh_account_logo_path, role: "presentation", size: 48, data: { upload_preview_target: "image" } %>
          <%= form.file_field :logo, class: "input", accept: "image/*",
                data: { action: "upload-preview#previewImage change->form#submit" } %>
          <span class="for-screen-reader">Upload logo</span>
        </label>
      <% end %>

      <div class="flex align-center gap-half">
        <%= form_with model: @account, method: :patch, data: { controller: "form" } do |form| %>
          <label class="btn settings-chip-btn">
            Replace logo
            <%= form.file_field :logo, accept: "image/*",
                  data: { action: "upload-preview#previewImage change->form#submit" } %>
            <span class="for-screen-reader">Upload logo</span>
          </label>
        <% end %>

        <% if @account.logo.attached? %>
          <%= button_to fresh_account_logo_path, method: :delete, class: "btn settings-chip-btn settings-chip-btn--negative" do %>
            Remove
          <% end %>
        <% end %>
      </div>
    </div>

    <%= form_with model: @account, data: { controller: "form" } do |form| %>
      <div class="settings-field">
        <div class="settings-field__label">
          <label for="account_name">Name</label>
          <%= translation_button(:account_name) %>
        </div>
        <%= form.text_field :name, class: "input", autocomplete: "off", placeholder: "Name this account",
              data: { action: "keydown.enter->form#submit" } %>
      </div>

      <div class="settings-field">
        <%= form.button "Save changes", class: "btn settings-save", type: "submit" %>
      </div>
    <% end %>
  </div>

  <span class="settings-label">Appearance</span>
  <div class="settings-card">
    <%# turbo: false — data-accent lives on <html>, which Turbo Drive doesn't
        morph, so the accent change needs a full page load to take effect. %>
    <%= form_with model: @account, data: { controller: "form", turbo: false } do |form| %>
      <%= form.fields_for :settings, @account.settings do |settings_form| %>
        <div class="setting-row">
          <span class="setting-row__text">
            <span class="setting-row__title">Accent color</span>
            <span class="txt-small txt-muted">Set once — links, selection, and highlights follow it everywhere.</span>
          </span>
          <div class="accent-picker" role="radiogroup" aria-label="Accent color">
            <% Account::ACCENTS.each do |accent| %>
              <label class="accent-swatch" title="<%= accent.capitalize %>">
                <%= settings_form.radio_button :accent, accent, checked: account_accent == accent,
                      class: "for-screen-reader", data: { action: "change->form#submit" } %>
                <span class="accent-swatch__dot" style="--swatch-color: <%= accent_swatch_color(accent) %>"></span>
                <span class="accent-swatch__name"><%= accent.capitalize %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render "accounts/admin_settings" %>

  <span class="settings-label">Members</span>
  <div class="settings-card">
    <%= link_to account_users_path, class: "setting-row txt-undecorated" do %>
      <span class="setting-row__text">
        <span class="setting-row__title">Manage members</span>
        <span class="txt-small txt-muted">Roles, badges, deactivations, and bans</span>
      </span>
      <%= icon_tag "arrow-right", class: "txt-muted flex-item-no-shrink" %>
    <% end %>
  </div>
</section>
