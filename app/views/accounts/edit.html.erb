<% @page_title = "Community settings" %>

<%= render layout: "settings/shell", locals: { section: :identity } do %>
  <header class="settings-header">
    <div class="settings-header__scope">Community settings</div>
    <h1 class="settings-header__title">Identity</h1>
    <p class="settings-header__blurb">Name, logo, accent, and how the community introduces itself. Changes here are seen by all <%= pluralize(@member_count, "member") %>.</p>
  </header>

  <div class="settings-card" style="view-transition-name: account-settings"
       data-controller="dialog" data-action="turbo:submit-end->dialog#closeOnSubmit">
    <div class="settings-avatar-row" data-controller="upload-preview">
      <%= form_with model: @account, method: :patch, data: { controller: "form" } do |form| %>
        <label class="btn avatar input--file account-logo">
          <%= image_tag fresh_account_logo_path, role: "presentation", size: 48, data: { upload_preview_target: "image" } %>
          <%= form.file_field :logo, class: "input", accept: "image/*",
                data: { action: "upload-preview#previewImage change->form#submit" } %>
          <span class="for-screen-reader">Upload logo</span>
        </label>
      <% end %>

      <div class="flex-item-grow">
        <strong><%= @account.name %></strong>
        <div class="txt-small txt-muted"><%= pluralize(@member_count, "member") %> · <%= online_users_count %> here now · <%= pluralize(@room_count, "room") %></div>
      </div>

      <div class="flex align-center gap-half">
        <button type="button" class="btn settings-chip-btn" data-action="dialog#open">Rename</button>

        <%= form_with model: @account, method: :patch, data: { controller: "form" } do |form| %>
          <label class="btn settings-chip-btn">
            Replace logo
            <%= form.file_field :logo, accept: "image/*",
                  data: { action: "upload-preview#previewImage change->form#submit" } %>
            <span class="for-screen-reader">Upload logo</span>
          </label>
        <% end %>

        <% if @account.logo.attached? %>
          <%= button_to fresh_account_logo_path, method: :delete, class: "btn settings-chip-btn settings-chip-btn--negative", title: "Remove logo", aria: { label: "Remove logo" } do %>
            <%= icon_tag "trash" %>
            <span class="for-screen-reader">Remove logo</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <p class="txt-small txt-muted margin-none">The name is shown on the join page, in link previews, and in every email. The join code lives in Invitations.</p>

    <dialog class="scrim-dialog scrim-dialog--rename" data-dialog-target="modal" data-action="click->dialog#closeOnScrim">
      <div class="scrim-dialog__header scrim-dialog__header--titled">
        <h2 class="scrim-dialog__title">Rename community</h2>
        <button type="button" class="scrim-dialog__close" data-action="dialog#close" aria-label="Close">&times;</button>
      </div>

      <%= form_with model: @account, class: "scrim-dialog__body", data: { controller: "rename" } do |form| %>
        <div class="settings-field">
          <div class="settings-field__label">
            <label for="account_name">Community name</label>
          </div>
          <%= form.text_field :name, autofocus: true, autocomplete: "off", class: "input",
                data: { rename_target: "field", action: "input->rename#update" } %>
          <p class="settings-field__hint">Everyone sees the new name immediately, and it replaces the old one on the join page, in link previews, and in every email already sent.</p>
        </div>

        <div class="scrim-dialog__footer">
          <button type="button" class="btn" data-action="dialog#close">Cancel</button>
          <%= form.button "Save name", type: "submit", class: "btn settings-save", data: { rename_target: "submit" } %>
        </div>
      <% end %>
    </dialog>
  </div>

  <span class="settings-label">Appearance</span>
  <div class="settings-card">
    <%# turbo: false — data-accent lives on <html>, which Turbo Drive doesn't
        morph, so the accent change needs a full page load to take effect. %>
    <%= form_with model: @account, data: { controller: "form", turbo: false } do |form| %>
      <%= form.fields_for :settings, @account.settings do |settings_form| %>
        <div class="setting-row">
          <span class="setting-row__text">
            <span class="setting-row__title">Accent color</span>
            <span class="txt-small txt-muted">Set once — links, selection, and highlights follow it everywhere.</span>
          </span>
          <div class="accent-picker" role="radiogroup" aria-label="Accent color">
            <% Account::ACCENTS.each do |accent| %>
              <label class="accent-swatch" title="<%= accent.capitalize %>">
                <%= settings_form.radio_button :accent, accent, checked: account_accent == accent,
                      class: "for-screen-reader", data: { action: "change->form#submit" } %>
                <span class="accent-swatch__dot" style="--swatch-color: <%= accent_swatch_color(accent) %>"></span>
                <span class="accent-swatch__name"><%= accent.capitalize %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% unless Sabha.email_globally_disabled? %>
    <span class="settings-label">Email from this community <span class="version-badge">Beta</span></span>
    <div class="settings-card">
      <%= render "accounts/setting_toggle", account: @account,
            attribute: :email_notifications_enabled,
            title:     "Send missed-notification emails",
            hint:      "Email members a recap when they miss a mention or DM while away.",
            disabled:  !Sabha.email_configured? %>

      <%= render "accounts/setting_toggle", account: @account,
            attribute: :weekly_digest_enabled,
            title:     "Send the weekly community digest",
            hint:      "Send a weekly recap to members who opted in.",
            disabled:  !Sabha.email_configured? %>
    </div>
  <% end %>
<% end %>
