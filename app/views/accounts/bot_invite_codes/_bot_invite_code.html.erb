<%# locals: (bot_invite_code: nil, regenerated: false) %>
<div id="bot_invite_code">
  <% if bot_invite_code %>
    <div class="invite-url-row">
      <input type="text" class="invite-url-input" value="<%= join_bot_url(bot_invite_code.code) %>" aria-label="Bot invite URL" readonly autocomplete="off">
      <%= button_to_copy_to_clipboard(join_bot_url(bot_invite_code.code), btn_class: "btn settings-chip-btn", toast: "Bot invite URL copied") do %>
        <%= icon_tag "copy-paste" %>
        <span class="for-screen-reader">Copy bot invite URL</span>
      <% end %>
      <%= button_to account_bot_invite_code_path, class: "btn settings-chip-btn", aria: { label: "Generate new bot invite URL" } do %>
        <%= icon_tag "refresh" %>
        <span class="for-screen-reader">Generate new bot invite URL</span>
      <% end %>
    </div>

    <% if regenerated %>
      <p class="txt-x-small txt-muted margin-none">Previous URL expired. Share this new one.</p>
    <% end %>
  <% else %>
    <%= button_to account_bot_invite_code_path, class: "btn settings-chip-btn" do %>
      <%= icon_tag "add" %>
      <span>Generate</span>
    <% end %>
  <% end %>
</div>
