<% content_for :title, "Reset password" %>
<% content_for :back_nav do %>
  <%= link_to "← Back", new_session_path(return_to: session[:return_to_after_authenticating]), class: "txt-medium txt-muted txt-undecorated" %>
<% end %>

<section class="auth-card <%= "shake" if flash[:alert] %>">
  <header class="auth-card__header">
    <%= link_to root_path, class: "auth-card__logo" do %>
      <%= image_tag fresh_account_logo_path, alt: Branding.contextual_app_name %>
    <% end %>
    <div>
      <h1 class="auth-card__title">Reset your password</h1>
      <p class="auth-card__blurb">Enter your email address and we'll send you instructions to reset your password.</p>
    </div>
  </header>

  <%= form_with url: password_resets_path, html: { autocomplete: "off" } do |form| %>
    <%= render "sessions/email_field", form: form %>
    <%= render "sessions/submit_button", form: form, label: "Send reset instructions" %>
  <% end %>
</section>
