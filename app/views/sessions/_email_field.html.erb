<%# locals: (form:, autofocus: true) %>
<div class="auth-card__field">
  <div class="auth-card__label">
    <label for="email_address">Email</label>
  </div>
  <%= form.email_field :email_address,
      required: true,
      class: "input",
      autofocus: autofocus,
      autocomplete: "email",
      placeholder: "you@example.com",
      value: params[:email_address] %>
</div>
