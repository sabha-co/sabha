<%# locals: (form:, autofocus: true, show_translation: true) %>
<div class="auth-card__field">
  <div class="auth-card__label">
    <label for="code">One-time code</label>
    <% if show_translation && defined?(translation_button) %>
      <%= translation_button(:one_time_code) %>
    <% end %>
  </div>
  <%= form.text_field :code,
      required: true,
      class: "input input--otp",
      autofocus: autofocus,
      autocomplete: "one-time-code",
      placeholder: "Enter code",
      minlength: 6,
      maxlength: 6,
      pattern: "[A-Za-z0-9]{6}",
      title: "Enter the 6-character code from your email" %>
</div>
