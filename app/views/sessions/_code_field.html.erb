<%# locals: (form:, autofocus: true) %>
<div class="auth-card__field" data-controller="otp-input">
  <div class="auth-card__label">
    <label for="code">One-time code</label>
  </div>

  <div class="otp" role="group" aria-label="Enter the 6-character code from your email">
    <% 6.times do |i| %>
      <input type="text" inputmode="latin" class="input otp__cell"
             maxlength="1"
             autocomplete="<%= i.zero? ? "one-time-code" : "off" %>"
             aria-label="Character <%= i + 1 %> of 6"
             <%= "autofocus" if autofocus && i.zero? %>
             data-otp-input-target="cell"
             data-action="input->otp-input#input keydown->otp-input#keydown paste->otp-input#paste">
    <% end %>
  </div>

  <%= form.hidden_field :code, data: { otp_input_target: "code" } %>
</div>
