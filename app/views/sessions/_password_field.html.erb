<%# locals: (form:, show_icon: true, show_translation: true) %>
<div class="flex align-center gap">
  <% if show_translation && defined?(translation_button) %>
    <%= translation_button(:password) %>
  <% end %>
  <label class="flex align-center gap input input--actor txt-large">
    <%= form.password_field :password,
        required: true,
        class: "input",
        autocomplete: "current-password",
        placeholder: "Enter your password",
        maxlength: 72 %>
    <% if show_icon && defined?(icon_tag) %>
      <%= icon_tag "password" %>
    <% end %>
  </label>
</div>
