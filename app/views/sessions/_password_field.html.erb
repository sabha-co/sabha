<%# locals: (form:, show_translation: true, side_link: nil) %>
<div class="auth-card__field">
  <div class="auth-card__label">
    <label for="password">Password</label>
    <%= side_link if side_link %>
    <% if side_link.nil? && show_translation && defined?(translation_button) %>
      <%= translation_button(:password) %>
    <% end %>
  </div>
  <%= form.password_field :password,
      required: true,
      class: "input",
      autocomplete: "current-password",
      placeholder: "Enter your password",
      maxlength: 72 %>
</div>
