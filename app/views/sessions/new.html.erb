<% content_for :title, "Sign in" %>
<% turbo_page_requires_reload %>

<section class="auth-card <%= "shake" if flash[:alert] %>">
  <header class="auth-card__header">
    <%= link_to root_path, class: "auth-card__logo" do %>
      <%= image_tag fresh_account_logo_path, alt: Branding.contextual_app_name %>
    <% end %>
    <div>
      <h1 class="auth-card__title">Sign in to <%= Branding.contextual_app_name %></h1>
      <p class="auth-card__blurb">
        <% if Account.otp_auth? %>
          We email you a six-character code. Nothing to remember.
        <% else %>
          Email and password. Accounts are created by invitation.
        <% end %>
      </p>
    </div>
  </header>

  <%= render "sessions/flash" %>

  <% if Account.otp_auth? %>
    <%= form_with url: auth_tokens_url, html: { autocomplete: "off" } do |form| %>
      <%= render "sessions/email_field", form: form %>
      <%= render "sessions/submit_button", form: form, label: "Sign in with email" %>
      <p class="auth-card__note">No password to forget. The code works once and expires after 15 minutes.</p>
    <% end %>
  <% else %>
    <%= form_with url: session_url, html: { autocomplete: "off" } do |form| %>
      <%= render "sessions/email_field", form: form %>
      <%= render "sessions/password_field", form: form,
            side_link: link_to("Forgot your password?", new_password_reset_path(return_to: session[:return_to_after_authenticating]), class: "auth-card__label-link") %>
      <%= render "sessions/submit_button", form: form, label: "Sign in" %>
    <% end %>
  <% end %>

  <% if DemoMode.enabled? %>
    <div class="auth-card__alert auth-card__alert--positive">
      <div>
        <strong>Demo credentials</strong><br>
        Email: <code><%= DemoMode.credentials[:email] %></code><br>
        Password: <code><%= DemoMode.credentials[:password] %></code>
      </div>
    </div>
  <% end %>

  <footer class="auth-card__footer">
    <% if Account.otp_auth? %>
      New here? Ask a member for an invite link.
    <% else %>
      New here? You need an invite link from someone in the community.
    <% end %>
  </footer>
</section>
