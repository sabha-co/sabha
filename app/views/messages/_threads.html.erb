<% threads = message.threads.to_a.select { |t| t.messages_count.to_i > 0 } %>
<div id="<%= dom_id(message, :threads) %>" class="threads flex align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0" data-controller="local-time">
  <% threads.each do |thread| %>
    <% ordered_participants = message.thread_participants_for(thread) || thread.participant_creators %>
    <% reply_count = thread.messages_count.to_i %>

    <%= link_to rooms_thread_path(thread), class: "thread__link flex-inline align-center gap", data: { turbo_frame: "thread_panel_frame", updated_at: thread.last_active_at&.iso8601 } do %>
      <div class="thread__avatars flex-inline gap">
        <% ordered_participants.each do |user| %>
          <figure class="avatar thread__avatar flex-item-no-shrink" data-stop-propagation="true">
            <%= render 'users/popup', user: user %>
          </figure>
        <% end %>
      </div>
      <strong class="thread__count"><%= pluralize(reply_count, 'reply', 'replies') %></strong>
      <% if reply_count > 0 && thread.last_active_at.present? %>
        <span class="thread__separator" aria-hidden="true">·</span>
        <span class="txt-muted thread__last-reply">Last reply <%= local_datetime_tag thread.last_active_at, style: :relative %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
