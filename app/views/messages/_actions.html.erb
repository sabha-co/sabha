<%# Be sure to check/update messages/_template.html.erb when changing this file %>
<%# locals: (message:, current_room: nil) -%>

<% show_thread_actions = !message.room.direct? && !current_room&.thread? && !message.room.sub_room? %>
<% existing_thread = message.threads.find { |t| t.active? } if show_thread_actions %>

<div class="message__actions">
  <%# Quick reactions surface in the bar on pointer devices; phones keep the
      single overflow menu below, so these hide on coarse pointers. %>
  <% EmojiHelper::REACTIONS.first(4).each do |character, title| %>
    <%= form_with model: [ message, Boost.new ], class: "message__quick-reaction", data: { turbo_frame: dom_id(message, :boosting), action: "submit->reaction-bar#route" } do |form| %>
      <%= hidden_field_tag "boost[content]", character %>
      <%= form.button type: "submit", title: title, class: "btn message__action-btn message__bar-btn", data: { emoji: character } do %>
        <figure class="margin-none boost-character"><%= character %></figure>
        <span class="for-screen-reader"><%= title %></span>
      <% end %>
    <% end %>
  <% end %>

  <%= tag.div class: "position-relative message__reaction-picker", data: { controller: "popover" } do %>
    <button type="button" class="btn message__action-btn message__bar-btn message__boost-btn"
        aria-expanded="false" data-popover-target="trigger" data-action="popover#toggle">
      <%= icon_tag "boost" %>
      <span class="for-screen-reader">Boost this message</span>
    </button>

    <%= render "messages/boosts/quick_picker", message: %>
  <% end %>

  <% if show_thread_actions %>
    <%# No for-screen-reader span here — combined with the icon it would trip
        the circle-button treatment in buttons.css and stack the label. The
        aria-label keeps the name when touch hides the visible label. %>
    <%= link_to existing_thread ? rooms_thread_path(existing_thread) : new_rooms_thread_path(parent_message_id: message.id),
          class: "btn message__action-btn message__bar-btn message__options-btn message__reply-btn",
          aria: { label: "Reply" },
          data: { turbo_frame: "thread_panel_frame" } do %>
      <%= icon_tag "reply" %>
      <span class="message__reply-label">Reply</span>
    <% end %>
  <% end %>

  <%= tag.div class: "position-relative", data: { controller: "popover", popover_row_value: ".message" } do %>
    <button type="button" class="btn message__action-btn message__bar-btn message__options-btn options-btn"
        aria-expanded="false" data-popover-target="trigger" data-action="popover#toggle">
      <%= icon_tag "menu-dots-horizontal" %>
      <span class="for-screen-reader">Message options</span>
    </button>

    <%= popover_menu_tag "message-menu", "menu-popover", aria: { label: "Message options" } do %>
        <%= link_to new_message_boost_path(message),
              class: "btn message__action-btn full-width message__boost-btn",
              data: { turbo_frame: "reaction_picker" } do %>
          <span>Add reaction</span>
        <% end %>

        <% if message.content_type.attachment? %>
          <%= link_to rails_blob_path(message.attachment, disposition: "attachment", only_path: true), class: "btn message__action-btn full-width hide-in-ios-pwa" do %>
            <span>Download</span>
          <% end %>

          <%= tag.button class: "btn message__action-btn full-width",
              data: { controller: "web-share", action: "web-share#share", web_share_files_value: rails_blob_path(message.attachment, only_path: true), web_share_title_value: message.attachment.filename.to_s } do %>
            <span>Share</span>
          <% end %>
        <% else %>
          <% if show_thread_actions %>
            <% if existing_thread %>
              <%= link_to rooms_thread_path(existing_thread), class: "btn message__action-btn full-width", data: { turbo_frame: "thread_panel_frame" } do %>
                <span>Reply</span>
              <% end %>
            <% else %>
              <%= link_to new_rooms_thread_path(parent_message_id: message.id), class: "btn message__action-btn full-width", data: { turbo_frame: "thread_panel_frame" } do %>
                <span>Reply</span>
              <% end %>
            <% end %>
          <% end %>

          <% if current_room.present? %>
            <%= tag.button class: "btn message__action-btn full-width", data: { action: "reply#reply" } do %>
              <span>Quote</span>
            <% end %>
          <% else %>
            <%= link_to message_permalink_url(message), class: "btn message__action-btn full-width",
                        target: "_top" do %>
              <span>Quote</span>
            <% end %>
          <% end %>
        <% end %>

        <% unless message.content_type.attachment? %>
          <%= link_to edit_message_in_room_path(current_room, message), class: "btn message__action-btn full-width message__edit-btn",
                      data: { turbo_frame: dom_id(message, :edit) } do %>
            <span>Edit</span>
          <% end %>
        <% end %>

        <%= tag.button class: "btn message__action-btn full-width", data: { controller: "copy-to-clipboard", action: "copy-to-clipboard#copy", copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: message_permalink_url(message) } do %>
          <span>Copy link</span>
        <% end %>

        <%= render "messages/actions/bookmark", message: message %>

        <% if current_room.present? %>
          <%= render "messages/actions/pin", message: message %>

          <%= button_to room_message_unreads_path(current_room, message), class: "btn message__action-btn full-width" do %>
            <span>Mark unread</span>
          <% end %>
        <% end %>

        <%# Destructive action last, set apart. A post's opening message is the
            post body — delete the whole post from its header menu, never here. %>
        <% unless forum_opening_message?(message) %>
          <%= button_to room_message_path(message.room, message), method: :delete, class: "btn message__action-btn full-width message__edit-btn message-menu__danger",
                         data: { turbo_confirm: "Are you sure you want to delete this message?", turbo_frame: dom_id(message, :edit) } do %>
            <span>Delete</span>
          <% end %>
        <% end %>
    <% end %>
  <% end %>
</div>
