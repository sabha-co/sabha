<%# locals: (message:) -%>
<%# The hover-bar's compact picker excludes its four visible reactions. Its
    sixteenth grid cell opens the existing full picker for every reaction and
    custom text. %>
<%= popover_menu_tag "message-reaction-menu", aria: { label: "Add reaction" } do %>
  <div class="message-reaction-menu__grid">
    <% EmojiHelper::REACTIONS.drop(4).each do |character, title| %>
      <%= form_with model: [ message, Boost.new ], data: { turbo_frame: dom_id(message, :boosting) } do |form| %>
        <%= hidden_field_tag "boost[content]", character %>
        <%= form.button type: "submit", title:, class: "btn message-reaction-menu__emoji", data: { emoji: character } do %>
          <figure class="margin-none boost-character"><%= character %></figure>
          <span class="for-screen-reader"><%= title %></span>
        <% end %>
      <% end %>
    <% end %>
    <%= link_to new_message_boost_path(message), class: "btn message-reaction-menu__more",
          data: { turbo_frame: "reaction_picker" }, aria: { label: "More reactions" } do %>
      <span aria-hidden="true">+</span>
      <span class="for-screen-reader">More reactions</span>
    <% end %>
  </div>
<% end %>
