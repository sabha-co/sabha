<%= turbo_frame_tag "reaction_picker" do %>
  <div class="scrim-dialog__body">
    <span class="scrim-dialog__label">Quick reactions</span>

    <div class="reaction-grid">
      <% EmojiHelper::REACTIONS.each do |character, title| %>
        <%= form_with model: [ @message, Boost.new ], data: { turbo_frame: dom_id(@message, :boosting) } do |form| %>
          <%= hidden_field_tag "boost[content]", character %>
          <%= form.button type: "submit", title: title, class: "btn reaction-grid__btn", data: { emoji: character } do %>
            <figure class="margin-none boost-character"><%= character %></figure>
            <span class="for-screen-reader"><%= title %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%= form_with model: [ @message, Boost.new ], class: "reaction-custom",
          data: { controller: "form", turbo_frame: dom_id(@message, :boosting) } do |form| %>
      <%= form.text_field :content, id: nil, autocomplete: "off", autocorrect: "off", maxlength: 16,
            required: true, pattern: /\S+.*/, placeholder: "Custom — 16 characters max",
            class: "input reaction-custom__input txt-small" %>

      <%= form.button class: "btn btn--reversed reaction-custom__submit", type: "submit" do %>
        <%= icon_tag "check" %>
        <span class="for-screen-reader">Submit</span>
      <% end %>
    <% end %>
  </div>
<% end %>
