<%# locals: (message:) -%>
<%# The trailing pill that opens the reaction picker. The whole boosts container
    is replaced on every change, so this no longer needs its own frame. %>
<%= link_to new_message_boost_path(message), class: "boost__add",
      data: { turbo_frame: "reaction_picker" }, aria: { label: "Add a reaction" } do %>
  <span aria-hidden="true">+</span>
<% end %>
