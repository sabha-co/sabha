<%= turbo_frame_tag message, :new_boost do %>
  <div class="flex-inline message__boost-inline">
    <%= link_to new_message_boost_path(message), class: "boost__action txt-small btn", data: { turbo_frame: "reaction_picker" } do %>
      <%= icon_tag "boost" %>
      <span class="for-screen-reader">Add a boost</span>
    <% end %>
  </div>
<% end %>