<%# locals: (messages:, channel:, first_unread_message: nil, composer_id: "composer") %>
<% seen_first_unread = false %>
<% messages.each do |message| %>
  <% seen_first_unread = true if message == first_unread_message %>
  <% if message == channel.parent_message %>
    <% cache message_cache_key(message, channel_id: channel.id, is_parent: true) do %>
      <%= render "messages/parent_message", message: message, thread: channel %>
    <% end %>
  <% else %>
    <% is_unread = first_unread_message.present? && seen_first_unread %>
    <% is_first_unread = message == first_unread_message %>
    <%= render partial: "messages/message",
          locals: { message:, current_channel: channel, first_unread_message:, is_unread:, composer_id: },
          cached: message_cache_key(message, channel_id: channel.id, is_first_unread_message: is_first_unread, is_unread:, composer_id:) %>
  <% end %>
<% end %>
