<div id="<%= dom_id(message, :bookmarking) %>">
  <% if message.bookmarked_by?(Current.user) %>
    <%= button_to message_bookmark_path(message), method: :delete, class: "btn message__action-btn full-width" do %>
      <span>Remove bookmark</span>
    <% end %>
  <% else %>
    <%= button_to message_bookmark_path(message), class: "btn message__action-btn full-width" do %>
      <span>Bookmark</span>
    <% end %>
  <% end %>
</div>