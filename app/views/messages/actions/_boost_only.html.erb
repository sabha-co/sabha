<%# locals: (message:) -%>

<div class="message__actions">
  <%= tag.div class: "position-relative", data: { controller: "dialog" } do %>
    <button type="button" class="btn message__action-btn message__bar-btn message__options-btn options-btn" data-action="dialog#open">
      <%= icon_tag "menu-dots-horizontal" %>
      <span class="for-screen-reader">Message options</span>
    </button>

    <dialog class="scrim-dialog scrim-dialog--menu" aria-label="Message options"
        data-dialog-target="modal"
        data-action="click->dialog#closeOnScrim click->dialog#closeOnMenuAction turbo:submit-end->dialog#closeOnSubmit">
      <div class="message-menu">
        <%= link_to new_message_boost_path(message),
              class: "btn message__action-btn full-width message__boost-btn",
              data: { turbo_frame: "reaction_picker" } do %>
          <span>Add reaction</span>
        <% end %>
      </div>
    </dialog>
  <% end %>
</div>
