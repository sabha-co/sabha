<%# locals: (message:) -%>

<div class="message__actions">
  <%= tag.div class: "position-relative", data: { controller: "popover", popover_row_value: ".message" } do %>
    <button type="button" class="btn message__action-btn message__bar-btn message__options-btn options-btn"
        aria-expanded="false" data-popover-target="trigger" data-action="popover#toggle">
      <%= icon_tag "menu-dots-horizontal" %>
      <span class="for-screen-reader">Message options</span>
    </button>

    <%= popover_menu_tag "message-menu", aria: { label: "Message options" } do %>
      <%= link_to new_message_boost_path(message),
            class: "btn message__action-btn full-width message__boost-btn",
            data: { turbo_frame: "reaction_picker" } do %>
        <span>Add reaction</span>
      <% end %>
    <% end %>
  <% end %>
</div>
