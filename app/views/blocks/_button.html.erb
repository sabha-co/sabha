<% if user %>
  <% blocked = Current.user.blocked?(user) %>
  <%= button_to user_blocks_path(user),
        class: "btn",
        method: blocked ? :delete : :post,
        title: blocked ? "Unblock this user" : "Block this user",
        data: {
          controller: "busy-on-submit",
          turbo_confirm: blocked ? "Are you sure you want to unblock #{user.name}?" : "Are you sure you want to block #{user.name} from messaging you?"
        } do %>
    <%= icon_tag(blocked ? "unblock" : "block") %>
    <%= compact ? "" : (blocked ? "Unblock user" : "Block user") %>
  <% end %>
<% end %>