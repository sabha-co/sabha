<%= turbo_stream.append dom_id(@channel, :messages) do %>
  <%= render partial: "messages/message", 
             collection: @new_messages, 
             cached: -> message { message_cache_key(message, channel_id: @channel.id, is_first_unread_message: message == @unread_at_message) }, 
             locals: { current_channel: @channel, first_unread_message: @unread_at_message } %>
<% end if @new_messages.any? %>

<% @updated_messages.each do |message| %>
  <%= turbo_stream.replace dom_id(message), partial: "messages/message", locals: { message: message, current_channel: @channel, first_unread_message: @unread_at_message } %>
<% end %>
