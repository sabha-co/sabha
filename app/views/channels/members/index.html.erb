<%= turbo_frame_tag :channel_members do %>
  <%= user_filter_menu_tag do %>
    <%= user_filter_search_tag if @channel.active_member_count > 20 %>

    <div id="channel_members_list" contents>
      <%= render partial: "channels/threads/user", collection: @members, as: :user, locals: { channel: @channel } %>
      <%= render "channels/members/next_page_container", page: @page.next_param unless @page.last? %>
    </div>
  <% end %>
<% end %>
