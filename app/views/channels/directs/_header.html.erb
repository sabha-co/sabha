<%# locals: (title:, channel: nil, membership: nil) -%>
<%# The DM surface header — shared by the live conversation (channels/show/_nav) and
    the provisional compose surface (channels/directs/new). With a persisted channel the
    title links to its settings and the edit + involvement controls show; the
    provisional surface (channel: nil) has nothing to edit or follow yet. %>
<% content_for :nav do %>
  <%= account_logo_tag if Current.account.logo.attached? %>
  <%= link_back_to_or_referrer inbox_direct_messages_path %>

  <% heading = tag.h1 class: "channel__contents txt-medium overflow-ellipsis" do %>
    <span class="for-screen-reader">Direct message with</span>
    <%= title %>
  <% end %>

  <% if channel %>
    <%= link_to heading, edit_channel_path(channel), class: "btn btn--reversed btn--faux channel--current" %>
    <%= link_to_edit_channel(channel) %>

    <% unless hotwire_native_app? %>
      <div class="flex gap-half align-center navbar-actions">
        <%= turbo_frame_tag dom_id(channel, :involvement) do %>
          <%= button_to_change_involvement(channel, membership.involvement) %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="btn btn--reversed btn--faux channel--current"><%= heading %></div>
  <% end %>
<% end %>
