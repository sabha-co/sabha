<% if Current.user.can_administer?(channel) && channel.convertible? %>
  <%= form_with url: channel_access_path(channel), method: :patch, data: { controller: "form" } do %>
    <%= hidden_field_tag :open, channel.is_a?(Channels::Open) ? "0" : "1" %>
    <div class="flex align-center gap pad-block">
      <span><b>Public</b> (anyone can join)</span>
      <hr class="separator" aria-hidden="true">
      <label class="switch">
        <input type="checkbox" class="switch__input" <%= "checked" if channel.is_a?(Channels::Open) %> data-action="change->form#submit">
        <span class="switch__btn round"></span>
        <span class="for-screen-reader"><%= channel.is_a?(Channels::Open) ? "Make this channel invite-only" : "Let anyone join this channel" %></span>
      </label>
    </div>
  <% end %>

  <hr class="margin-block separator full-width" style="--border-style: solid">
<% end %>

<% if Current.user.can_administer?(channel) && channel.sidebar_channel? %>
  <div data-controller="filter member-toggle"
       data-member-toggle-members-url-value="<%= channel_members_path(channel) %>"
       data-member-toggle-available-users-value="<%= @available_users_json.to_json %>">
    <input type="search"
           autocorrect="off"
           autocomplete="off"
           data-1p-ignore="true"
           class="input fill full-width margin-block"
           placeholder="Find people to add or remove"
           data-filter-target="input"
           data-member-toggle-target="input"
           data-action="input->filter#filter input->member-toggle#search search->filter#filter">

    <menu id="channel_<%= channel.id %>_preview_members" class="flex flex-column gap margin-none pad fill-shade border-radius">
      <%= render partial: "channels/closeds/user", collection: @preview_members, as: :user, locals: { channel: channel, selected: true, dom_id_prefix: "preview_member" } %>
      <% remaining = channel.active_member_count - @preview_members.size %>
      <% if remaining > 0 %>
        <li class="txt-small txt-deemphasize txt-align-center margin-none" data-filter-target="summary">
          and <%= pluralize(remaining, "more member") %>
        </li>
      <% end %>
      <%= render partial: "channels/closeds/user", collection: @remaining_members, as: :user, locals: { channel: channel, selected: true, default_hidden: true } %>
    </menu>
  </div>
<% else %>
  <menu class="flex flex-column gap margin-none pad fill-shade border-radius">
    <%= render partial: "channels/threads/user", collection: @preview_members, as: :user, locals: { channel: channel } %>
  </menu>
<% end %>
