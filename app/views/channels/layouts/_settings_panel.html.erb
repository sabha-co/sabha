<% if membership %>
  <p class="txt-muted margin-none margin-block-half txt-align-center">Notifications</p>

  <% if membership.involved_in_invisible? %>
    <%= render "channels/involvements/hide_toggle", channel: channel, is_hidden: true %>
  <% else %>
    <%= render "channels/involvements/involvement_select", channel: channel, membership: membership %>
    <%= render "channels/involvements/hide_toggle", channel: channel, is_hidden: false %>
  <% end %>

  <hr class="margin-block separator full-width" style="--border-style: solid">
  <p class="txt-muted margin-none margin-block-half txt-align-center">Membership</p>

  <div class="txt-align-center pad-block">
    <%= button_to channel_membership_path(channel), method: :delete,
          class: "btn max-width",
          data: { turbo_confirm: "Leave #{channel_display_name(channel)}?" } do %>
      Leave channel
    <% end %>
  </div>
<% end %>

<% if Current.user.can_administer?(channel) && !channel.original? %>
  <hr class="margin-block separator full-width" style="--border-style: solid">
  <p class="txt-muted margin-none margin-block-half txt-align-center">Danger zone</p>
  <div class="txt-align-center pad-block">
    <%= button_to_delete_channel channel %>
  </div>
<% end %>
