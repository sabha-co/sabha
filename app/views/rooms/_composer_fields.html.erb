<%# locals: (form:, autocomplete_room: nil, label:, send_label:, body_id: nil, attachments: true, placeholder: nil, mention_user_ids: nil) -%>
<%# The shared input card for every chat composer — the main room composer, a
    thread reply, and a provisional (not-yet-created) thread reply. Callers supply
    the form builder plus the bits that vary: the room to autocomplete @-mentions
    against and the aria/send labels. The card stacks the always-on format bar
    (Lexxy's toolbar, B/I/S/code + an @ insert) over the input over the tools row
    (attach · emoji · send); search lives in the ⌘K palette, not here. The
    surrounding chrome (typing indicator, everyone-confirm, hidden fields) stays in
    each caller since it differs per context. %>
<fieldset data-composer-target="fields" contents>
  <div class="flex flex-column">
    <div class="composer__filelist flex flex--align-center gap flex-wrap" data-composer-target="fileList"></div>

    <div class="composer__input input input--actor fill-white min-width flex flex-column" style="--input-border-radius: 12px; --input-padding: 0">
      <% mention_src = autocompletable_users_path(room_id: autocomplete_room&.id, user_ids: mention_user_ids) %>
      <% body_options = {
           rows: 1, class: "input lexxy-content",
           aria: { multiline: "true", label: label },
           "permitted-attachment-types": "application/vnd.sabha.mention application/vnd.actiontext.opengraph-embed",
           data: {
             controller: "unfurl",
             action: "#{rich_text_data_actions} lexxy:insert-link->unfurl#unfurl",
             composer_target: "text" } } %>
      <% body_options[:id] = body_id if body_id %>
      <% body_options[:placeholder] = placeholder if placeholder %>
      <%= form.rich_text_area :body, **body_options do %>
        <%= mention_prompt_tag mention_src %>
      <% end %>

      <div class="composer__tools flex align-center full-width">
        <% if attachments %>
          <label class="btn btn--borderless txt-small flex-item-no-shrink composer__attachment-btn input--file">
            <%= icon_tag "attachment" %>
            <input type="file" data-action="composer#filePicked" multiple>
            <span class="for-screen-reader">Attach a file</span>
          </label>
        <% end %>

        <%# Emoji reuses the reaction grid in a scrim dialog; picking one closes the
            dialog first (releasing the modal focus trap) so the character lands in
            the editor at the caret. %>
        <span class="composer__emoji flex-item-no-shrink" data-controller="dialog" data-action="click->dialog#closeOnScrim">
          <button type="button" class="btn btn--borderless txt-small composer__emoji-btn" data-action="dialog#open" aria-haspopup="dialog">
            <%= icon_tag "reaction" %>
            <span class="for-screen-reader">Insert an emoji</span>
          </button>

          <dialog class="scrim-dialog composer__emoji-dialog" data-dialog-target="modal" aria-label="Insert an emoji">
            <div class="scrim-dialog__body">
              <span class="scrim-dialog__label">Emoji</span>
              <div class="reaction-grid">
                <% EmojiHelper::REACTIONS.each do |character, title| %>
                  <button type="button" class="btn reaction-grid__btn" title="<%= title %>"
                          data-action="dialog#close composer#insertEmoji" data-composer-emoji-param="<%= character %>">
                    <figure class="margin-none boost-character"><%= character %></figure>
                    <span class="for-screen-reader"><%= title %></span>
                  </button>
                <% end %>
              </div>
            </div>
          </dialog>
        </span>

        <%# No for-screen-reader span — with the icon it would trip the
            circle-button treatment in buttons.css; the aria-label names it. %>
        <%= form.button name: "send", type: "submit", data: { action: "composer#submit" },
              aria: { label: send_label },
              class: "btn composer__send-btn flex-item-no-shrink" do %>
          <span aria-hidden="true">Send</span>
          <%= icon_tag "arrow-up-right" %>
        <% end %>
      </div>
    </div>
  </div>
</fieldset>
