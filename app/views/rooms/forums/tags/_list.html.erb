<%# locals: (forum:) %>
<div class="flex flex-column gap-half">
  <% if forum.tags.ordered.any? %>
    <menu id="<%= dom_id(forum, :tags) %>" class="flex flex-column gap-half margin-none pad-none">
      <%= render partial: "rooms/forums/tags/tag", collection: forum.tags.ordered, locals: { forum: forum } %>
    </menu>
  <% else %>
    <p class="txt-small txt-muted margin-none">No tags yet. Add one below.</p>
  <% end %>

  <%= form_with url: rooms_forum_tags_path(forum), method: :post, class: "flex align-center gap" do |form| %>
    <%= form.text_field :name, name: "tag[name]", class: "input txt-small flex-item-grow",
          placeholder: "New tag name", required: true, maxlength: 30, style: "min-width: 0;" %>
    <%= form.color_field :color, name: "tag[color]", class: "input txt-small", title: "Tag color",
          style: "width: 3ch; padding: 0.25rem;" %>
    <%= form.button class: "btn btn--reversed txt-small", type: "submit" do %>
      <%= icon_tag "add" %>
    <% end %>
  <% end %>
</div>
