<% @page_title = room_display_name(@room) %>
<% @body_class = "sidebar" %>

<% content_for :head do %>
  <meta name="current-room-id" content="<%= @room.id %>">
<% end %>

<%= render "rooms/show/nav", room: @room %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% filtering = params[:solved].present? %>
<% populated = @posts.any? || filtering %>

<div class="forum">
  <%= turbo_stream_from @room, :posts %>
  <%# Involvement changes (the nav bell) broadcast to the membership stream —
      subscribe so the button cycles its state, like the chat and post pages. %>
  <%= turbo_stream_from @membership if @membership %>

  <div class="forum__inner flex flex-column gap">
    <%# Toolbar row: filters lead on the left, New post pinned to the right. %>
    <div class="forum__toolbar flex align-center gap flex-wrap">
      <% if populated %>
        <%= render "rooms/forums/filter_bar", forum: @room %>
      <% end %>

      <%# Native <details> disclosure: the summary is the "New post" trigger; the
          controller only focuses the title on open (see forum_compose). Pinned
          right when closed; expands to a full-width row below the filters on open. %>
      <%= tag.details class: "forum-compose", data: {
            controller: "forum-compose", action: "toggle->forum-compose#focus" } do %>
        <summary class="forum-compose__toggle btn btn--reversed">
          <%= icon_tag "add", class: "forum-compose__toggle-icon" %>
          <span>New post</span>
        </summary>
        <%= render "rooms/forums/posts/compose", forum: @room %>
      <% end %>
    </div>

    <% if @posts.any? %>
      <div id="<%= dom_id(@room, :posts) %>" class="forum__list flex flex-column">
        <%= render partial: "rooms/forums/post_card", collection: @posts, as: :post,
              locals: { forum: @room, participants: @participants, viewer: Current.user } %>
        <% unless @page.last? %>
          <%= render "rooms/forums/next_page_container", forum: @room, page: @page.next_param %>
        <% end %>
      </div>
    <% elsif filtering %>
      <%= render "rooms/forums/empty", forum: @room, filtering: true %>
    <% else %>
      <%= render "rooms/forums/empty", forum: @room, filtering: false %>
    <% end %>
  </div>
</div>
