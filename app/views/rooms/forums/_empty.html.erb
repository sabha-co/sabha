<%# locals: (forum:, filtering:) %>
<div class="empty-state">
  <% if filtering %>
    <h2 class="empty-state__title">Nothing solved yet</h2>
    <p class="empty-state__body">No post here has been marked solved. Clear the Solved filter to see the open ones.</p>
  <% else %>
    <h2 class="empty-state__title">No posts yet</h2>
    <p class="empty-state__body">Forums hold one question per post, and each can be marked solved. Start with the thing you actually need answered.</p>
  <% end %>
</div>
