<%# locals: (post:, **rest) %>
<%# The broadcast target for Solved changes (title + tags + badge). **rest
    absorbs the default `thread:` local turbo-rails injects on broadcast. %>
<div id="<%= dom_id(post, :header) %>" class="forum-post-header__main flex flex-column gap-half min-width">
  <h1 class="forum-post-header__title margin-none"><%= post.title %></h1>

  <% tags = post.tags.sort_by { |tag| tag.name.downcase } %>
  <% if post.solved? || tags.any? %>
    <div class="flex align-center gap-half flex-wrap">
      <% if post.solved? %>
        <span class="forum-tag forum-tag--solved"><%= icon_tag "check" %> Solved</span>
      <% end %>
      <% tags.each do |tag| %>
        <span class="forum-tag">
          <% if tag.color.present? %>
            <span class="forum-tag__dot" style="background: <%= tag.color %>"></span>
          <% end %>
          <%= tag.name %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>
