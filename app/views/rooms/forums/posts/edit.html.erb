<%# Inline title edit — renders into the header's title frame so editing happens
    in place (mirroring a message editing inside its own turbo-frame), rather than
    navigating to a separate page. %>
<%= turbo_frame_tag dom_id(@post, :title) do %>
  <%= form_with model: @post, url: rooms_forum_post_path(@forum, @post), scope: :post,
        class: "forum-post-title-edit flex align-center gap-half min-width full-width" do |form| %>
    <%= form.text_field :title, value: @post.title,
          class: "forum-post-header__title input fill-white flex-item-grow min-width",
          required: true, autofocus: true, maxlength: 200, aria: { label: "Post title" },
          style: "--input-border-radius: 0.6rem" %>

    <%= form.button class: "btn btn--reversed flex-item-no-shrink", type: "submit" do %>
      <%= icon_tag "check" %>
      <span class="for-screen-reader">Save title</span>
    <% end %>

    <%= link_to forum_post_path(@post.slug), class: "btn btn--borderless flex-item-no-shrink",
          data: { turbo_frame: dom_id(@post, :title) } do %>
      <%= icon_tag "close" %>
      <span class="for-screen-reader">Cancel</span>
    <% end %>
  <% end %>
<% end %>
