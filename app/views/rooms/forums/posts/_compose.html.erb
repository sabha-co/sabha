<%# locals: (forum:) %>
<%# The inline "New post" compose. Toggled in place by the forum-compose
    Stimulus controller; posts to create with no route change. %>
<%= form_with url: rooms_forum_posts_path(forum), scope: :post, class: "forum-compose__form flex flex-column gap" do |form| %>
  <div class="forum-compose__head flex align-center gap">
    <button type="button" class="btn btn--borderless forum-compose__close" data-action="forum-compose#close" aria-label="Cancel">
      <%= icon_tag "close" %>
    </button>
    <strong>New post</strong>
  </div>

  <%= form.text_field :title, class: "forum-compose__title input", required: true,
        placeholder: "Post title", maxlength: 200, data: { forum_compose_target: "title" } %>

  <%# Same rich Trix editor as the chat/reply composer — the app's input shell and
      @-mention autocomplete — sized for a post body. Submits post[body] normally,
      with no message-send machinery. %>
  <div class="composer__input input input--actor fill-white min-width forum-compose__body" style="--input-border-radius: 1.1rem">
    <%= form.rich_text_area :body,
          class: "input full-width",
          placeholder: "Write your post…",
          aria: { multiline: "true", label: "Post body" },
          data: {
            controller: "rich-autocomplete",
            action: rich_text_data_actions,
            rich_autocomplete_url_value: autocompletable_users_path(room_id: forum.id),
            permitted_attachment_types: "application/vnd.actiontext.opengraph-embed" } %>
  </div>

  <div class="forum-compose__foot flex align-center justify-end gap">
    <%= form.button class: "btn btn--reversed" do %>
      <%= icon_tag "check" %>
      <span>Post</span>
    <% end %>
  </div>
<% end %>
