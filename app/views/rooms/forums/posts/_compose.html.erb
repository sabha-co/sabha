<%# locals: (forum:) %>
<%# The inline "New post" compose form. Rendered inside the gallery's <details>
    disclosure — the <summary> opens/closes it; this is just the fields. Posts to
    create with no route change. %>
<%= form_with url: rooms_forum_posts_path(forum), scope: :post, class: "forum-compose__form flex flex-column gap" do |form| %>
  <%= form.text_field :title, class: "forum-compose__title input fill-white", required: true,
        placeholder: "Post title", maxlength: 200, style: "--input-border-radius: 1.1rem",
        data: { forum_compose_target: "title" } %>

  <%# Same rich editor as the chat composer — @-mention prompt and a rich-text
      toolbar toggle. Like chat, the editor's own file attachments are disabled;
      forum posts are text/rich-text only. Submits post[body] normally; see
      forum_body_controller. %>
  <div class="flex composer__input input input--actor fill-white min-width forum-compose__body"
       data-controller="forum-body" data-forum-body-toolbar-class="composer--rich-text"
       style="--input-border-radius: 1.1rem">
    <div class="flex align-end gap full-width">
      <div class="flex flex-column flex-item-grow min-width gap">
        <%= form.rich_text_area :body,
              class: "input lexxy-content", style: "order: -1",
              placeholder: "Write your post…",
              aria: { multiline: "true", label: "Post body" },
              "permitted-attachment-types": "application/vnd.sabha.mention application/vnd.actiontext.opengraph-embed",
              data: {
                forum_body_target: "text",
                controller: "unfurl",
                action: "#{rich_text_data_actions} lexxy:insert-link->unfurl#unfurl" } do %>
          <%= mention_prompt_tag autocompletable_users_path(room_id: forum.id) %>
        <% end %>
      </div>

      <button type="button" class="btn btn--borderless txt-small flex-item-no-shrink composer__rich-text-btn" data-action="forum-body#toggleToolbar">
        <%= icon_tag "text-options" %>
        <span class="for-screen-reader">Rich text</span>
      </button>
    </div>
  </div>

  <div class="forum-compose__foot flex align-center justify-end gap">
    <%= form.button class: "btn btn--reversed" do %>
      <%= icon_tag "check" %>
      <span>Post</span>
    <% end %>
  </div>
<% end %>
