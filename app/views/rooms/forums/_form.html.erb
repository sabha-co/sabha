<%= form_with model: room, url: rooms_forums_path do |form| %>
  <div class="flex flex-column gap">
    <label class="flex align-center gap input input--actor">
      <%= form.text_field :name, name: "room[name]", class: "input txt-large",
            required: true, autofocus: true, placeholder: "Name the forum",
            data: { action: "keydown.enter->form#submit:prevent" } %>
      <%= icon_tag "board" %>
      <span class="for-screen-reader">Name this forum</span>
    </label>

    <label class="flex align-center gap input input--actor">
      <%= form.text_area :description, name: "room[description]", rows: 1, maxlength: 280, class: "input txt-medium",
            placeholder: "What's this forum about? (optional)" %>
      <span class="for-screen-reader">Forum description</span>
    </label>

    <label class="flex align-center gap input input--actor">
      <%= text_field_tag "room[tags]", nil, class: "input txt-medium",
            placeholder: "Starter tags, comma-separated (optional)" %>
      <span class="for-screen-reader">Starter tags, comma-separated</span>
    </label>
  </div>

  <%= submit_room_button_tag %>
<% end %>
