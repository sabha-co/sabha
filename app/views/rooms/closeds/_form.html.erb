<%= render layout: "rooms/layouts/form", locals: { room: room, type_change_path: type_change_path } do %>
  <menu class="flex flex-column gap margin-none pad overflow-y constrain-height"
        data-controller="user-search"
        data-user-search-url-value="<%= users_rooms_closeds_path %>">

    <%# Selected users header and list %>
    <p data-user-search-target="selectedHeader" class="txt-small txt-deemphasize margin-none" style="<%= selected_users.empty? ? 'display:none' : '' %>">Selected members</p>

    <div data-user-search-target="selected" class="flex flex-column gap">
      <%= render partial: "rooms/closeds/user", collection: selected_users, locals: { room: room, selected: true } %>
    </div>

    <div data-user-search-target="selectedSeparator" style="<%= selected_users.empty? ? 'display:none' : '' %>">
      <hr class="separator full-width" style="--border-style: solid">
    </div>

    <%# Search input %>
    <input type="search"
           id="user-search"
           autocorrect="off"
           autocomplete="off"
           data-1p-ignore="true"
           class="input input--transparent full-width"
           placeholder="Search members to add..."
           data-user-search-target="input"
           data-action="input->user-search#search">

    <%# Search results %>
    <div data-user-search-target="results" class="flex flex-column gap"></div>

    <%# Top members (shown by default) %>
    <% if unselected_users.any? %>
      <div class="flex flex-column gap">
        <%= render partial: "rooms/closeds/user", collection: unselected_users, locals: { room: room, selected: false } %>
      </div>
    <% end %>
  </menu>
<% end %>
