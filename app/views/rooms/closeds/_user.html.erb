<li id="<%= "#{dom_id_prefix}_#{user.id}" if local_assigns[:dom_id_prefix] %>" class="flex align-center gap margin-none" data-filter-target="item" <%= "hidden data-filter-default=hidden" if local_assigns[:default_hidden] %>>
  <figure class="avatar flex-item-no-shrink" style="--avatar-size: 4ch;">
    <%= avatar_link_tag user, loading: :lazy %>
  </figure>

  <div class="min-width">
    <div class="overflow-ellipsis fill-shade"><strong><%= user.name %></strong></div>
  </div>

  <hr class="separator" aria-hidden="true">

  <% if Current.user.can_administer?(room) %>
    <% if user == Current.user && room.new_record? %>
      <%= hidden_field_tag "user_ids[]", user.id, id: nil %>
      <%= icon_tag "check", class: "flex-item-no-shrink" %>
    <% else %>
      <label class="switch flex-item-no-shrink">
        <%= check_box_tag "user_ids[]", user.id, selected, class: "switch__input", id: nil, data: { action: "change->member-toggle#toggle" } %>
        <span class="switch__btn round"></span>
        <span class="for-screen-reader">Give <%= user.name %> access to this room</span>
      </label>
    <% end %>
  <% end %>
</li>
