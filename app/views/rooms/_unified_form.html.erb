<% default_type = local_assigns[:default_type].presence || "open" %>
<% initial_url = { "closed" => closed_url, "forum" => forum_url }[default_type] || open_url %>

<%# Submitting a valid room redirects to it, so the form breaks out of the
    dialog frame to _top and lands on the new room. %>
<%= form_with model: room, url: initial_url,
      data: { turbo_frame: "_top",
              controller: "room-form",
              room_form_open_url_value: open_url,
              room_form_closed_url_value: closed_url,
              room_form_forum_url_value: forum_url } do |form| %>

  <div class="scrim-dialog__body">
    <div class="room-type-grid txt-align-start">
      <label class="room-type-card">
        <input type="radio" name="room_type" value="open" class="for-screen-reader"
               <%= "checked" if default_type == "open" %>
               data-action="change->room-form#selectType">
        <span class="room-type-card__head"># Public</span>
        <span class="room-type-card__blurb">Anyone can find and join</span>
      </label>

      <label class="room-type-card">
        <input type="radio" name="room_type" value="closed" class="for-screen-reader"
               <%= "checked" if default_type == "closed" %>
               data-action="change->room-form#selectType">
        <span class="room-type-card__head"><%= icon_tag "lock", size: 12 %> Private</span>
        <span class="room-type-card__blurb">Invite-only, hidden from browse</span>
      </label>

      <label class="room-type-card">
        <input type="radio" name="room_type" value="forum" class="for-screen-reader"
               <%= "checked" if default_type == "forum" %>
               data-action="change->room-form#selectType">
        <span class="room-type-card__head"><%= icon_tag "message-log", size: 12 %> Forum</span>
        <span class="room-type-card__blurb">Organized discussions, each in its own post</span>
      </label>
    </div>

    <div class="txt-align-start">
      <div class="settings-field">
        <div class="settings-field__label">
          <label for="room_name">Name</label>
        </div>
        <%= form.text_field :name, name: "room[name]", class: "input",
              required: true, autofocus: true, placeholder: "Name the room",
              data: { action: "keydown.enter->form#submit:prevent" } %>
      </div>

      <div class="settings-field">
        <div class="settings-field__label">
          <label for="room_description">Description</label>
        </div>
        <%= form.text_area :description, name: "room[description]", rows: 1, maxlength: 280, class: "input",
              placeholder: "What's this room about? (optional)" %>
      </div>

      <div class="settings-field new-room-autojoin" data-room-form-target="autoJoinOption" <%= "hidden" unless default_type == "open" %>>
        <div class="setting-row">
          <span class="setting-row__text">
            <span class="setting-row__title" id="new_room_autojoin_label">Add new members automatically</span>
            <span class="txt-small txt-muted">Everyone who joins the community lands in this room too.</span>
          </span>
          <label class="switch">
            <%= form.check_box :auto_join, name: "room[auto_join]", class: "switch__input", aria: { labelledby: "new_room_autojoin_label" } %>
            <span class="switch__btn round"></span>
          </label>
        </div>
      </div>
    </div>
  </div>

  <footer class="scrim-dialog__footer">
    <button type="button" class="btn" data-action="dialog#close">Cancel</button>
    <%= submit_room_button_tag "Create room" %>
  </footer>
<% end %>
