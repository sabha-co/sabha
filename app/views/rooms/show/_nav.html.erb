<% dm_members = room.direct? ? room.members_for_display(excluding: Current.user) : [] %>
<% dm_other = dm_members.one? ? dm_members.first : nil %>
<% dm_status = dm_other && direct_member_status(dm_other) %>

<% content_for :nav do %>
  <% if room.thread? %>
    <%= link_back_to_or_referrer room_at_message_path(room.parent_message.room, room.parent_message) %>
  <% elsif room.direct? %>
    <%# The rail replaces this affordance at split widths (CSS hides it) %>
    <span class="dm-back"><%= link_back_to_or_referrer inbox_direct_messages_path %></span>
  <% end %>

  <% unless room.direct? %>
    <span class="navbar-glyph" aria-hidden="true">
      <%= room.thread? ? "🧵" : room_type_indicator(room) %>
    </span>
  <% end %>

  <% if room.direct? %>
    <div class="navbar-dm">
      <span class="avatar navbar-dm__avatar">
        <% if dm_members.many? %>
          <div class="avatar__group">
            <% dm_members.first(4).each do |member| %>
              <span class="avatar"><%= avatar_image_tag(member, size: 20, loading: :lazy) %></span>
            <% end %>
          </div>
        <% else %>
          <%= avatar_image_tag(dm_other || Current.user, size: 30) %>
          <% if dm_status %>
            <span class="status-dot status--<%= dm_status %> navbar-dm__dot" aria-hidden="true"></span>
          <% end %>
        <% end %>
      </span>

      <div class="navbar-dm__text">
        <h1 class="navbar-title">
          <% if dm_other %>
            <%= link_to edit_room_path(room) do %>
              <span class="for-screen-reader">Direct message with</span>
              <%= room_display_name(room) %>
            <% end %>
          <% else %>
            <span class="for-screen-reader">Group conversation with</span>
            <%= room_display_name(room) %>
          <% end %>
        </h1>
        <%# A group's count lives in the "N people" pill (navbar-actions), which
            also opens the participants panel — so no static subline here. %>
        <% if dm_other %>
          <span class="navbar-dm__status"><%= dm_presence_label(dm_status) %></span>
        <% end %>
      </div>
    </div>
  <% else %>
    <h1 class="navbar-title">
      <%= link_to edit_room_path(room) do %>
        <% if room.thread? %>
          <%= room_display_name(room.parent_message.room) %>
        <% else %>
          <%= room_display_name(room) %>
        <% end %>
      <% end %>
    </h1>
  <% end %>

  <% unless room.thread? || room.direct? %>
    <%= link_to account_users_path, class: "navbar-members",
          aria: { label: "#{pluralize(room.active_member_count, "member")} — see everyone in #{Current.account.name}" } do %>
      <%= icon_tag "person" %><%= room.active_member_count %>
    <% end %>
  <% end %>

  <span class="navbar-topic"><%= room.description %></span>

  <% unless hotwire_native_app? %>
    <div class="flex gap-half align-center navbar-actions">
      <% if dm_other %>
        <%= link_to "View profile", user_path(dm_other), class: "btn navbar-view-profile" %>
      <% elsif dm_members.many? %>
        <%= link_to edit_room_path(room), class: "btn navbar-view-profile navbar-people" do %>
          <%= icon_tag "person" %><%= pluralize(room.active_member_count, "person") %>
        <% end %>
      <% end %>

      <% unless room.thread? %>
        <% if room.direct? %>
          <%# DMs have no roster panel, so the toggle rides the bar as an icon
              (its level label is hidden by CSS to spare the mobile header). %>
          <%= turbo_frame_tag dom_id(room, :involvement) do %>
            <%= button_to_change_involvement(room, @membership.involvement) %>
          <% end %>
        <% else %>
          <%# The involvement toggle now lives inside the roster panel. %>
          <%= link_to_room_roster(room) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
