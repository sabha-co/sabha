<% @page_title = @room.thread? ? "🧵 #{room_display_name(@room.parent_message.room)}" : room_display_name(@room) %>
<% @body_class = "sidebar" %>
<% content_for :head do %>
  <%= turbo_exempts_page_from_preview %>
  <meta name="current-room-id" content="<%= @room.id %>">
<% end %>

<%= render "rooms/show/nav", room: @room %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<%# Wide screens dock the roster by default (thread_panel_controller gates on
    viewport width and the reader's sticky dismissal) %>
<% content_for :auto_panel_src, room_roster_path(@room) unless @room.direct? || @room.sub_room? %>

<%= message_area_tag(@room) do %>
  <%= render "messages/template" %>

  <%= messages_tag(@room) do %>
    <%= render "rooms/show/welcome", room: @room %>
    <%= render "rooms/show/block_notice", room: @room %>
    <%= render "messages/message_list", messages: @messages, room: @room, first_unread_message: @first_unread_message %>
  <% end %>

  <%= turbo_stream_from @membership %>
  <%= turbo_stream_from @room, :messages, channel: "RoomStreamsChannel" %>
  <%= turbo_stream_from Current.user, @room, :messages, channel: "RoomStreamsChannel" %>
  <%= button_to_jump_to_newest_message %>
<% end %>

<% if Current.user.blocked_in?(@room) %>
  <%= render "rooms/show/composer_not_allowed", room: @room %>
<% else %>
  <%= render "rooms/show/composer", room: @room %>
<% end %>
