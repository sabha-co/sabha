<% @page_title = "Browse rooms" %>
<% @body_class = "sidebar browse" %>
<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% content_for :nav do %>
  <%= link_back %>
  <h1 class="navbar-title">Browse rooms</h1>
  <span class="navbar-count">Every room you can see, joined or not</span>
  <div class="flex-item-grow"></div>
  <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
    <%= link_to "New room", new_rooms_open_path, class: "btn settings-save flex-item-no-shrink" %>
  <% end %>
<% end %>

<section class="browse-page">
  <% if @rooms.any? %>
    <div id="browsable_rooms" class="browse-card">
      <%= render partial: "rooms/browse/room", collection: @rooms, as: :room %>

      <% unless @page.last? %>
        <%= render partial: "rooms/browse/next_page_container", locals: { page: @page.next_param } %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="empty-state__title">Nothing to browse yet</p>
      <p class="empty-state__body">Rooms you can see appear here — open rooms to join, plus the private ones you're in.</p>
    </div>
  <% end %>
</section>
