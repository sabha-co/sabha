<% @page_title = "Browse rooms" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to root_path %>
  </div>
<% end %>

<section class="panel">
  <header class="settings-header flex align-center justify-between gap">
    <div>
      <h1 class="settings-header__title margin-none" style="font-size: 1.25rem;">Browse rooms</h1>
      <p class="txt-small txt-muted margin-none">Open rooms you haven't joined yet</p>
    </div>
    <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
      <%= link_to new_rooms_open_path, class: "btn settings-save flex-item-no-shrink" do %>
        New room
      <% end %>
    <% end %>
  </header>

  <% if @rooms.any? %>
    <div id="browsable_rooms" class="browse-card">
      <%= render partial: "rooms/browse/room", collection: @rooms, as: :room %>

      <% unless @page.last? %>
        <%= render partial: "rooms/browse/next_page_container", locals: { page: @page.next_param } %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="empty-state__title">You're in every room</p>
      <p class="empty-state__body">Nothing left to browse. Private rooms you haven't been invited to never appear here.</p>
    </div>
  <% end %>
</section>
