<% @page_title = "Settings for #{room_display_name(room)}" %>
<% @body_class = "sidebar room-settings" %>
<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% content_for :nav do %>
  <%= link_back_to room_path(room), label: safe_join([ room_type_indicator(room), room_display_name(room) ], " ") %>
  <h1 class="navbar-title">Room settings</h1>
  <div class="flex-item-grow"></div>
<% end %>

<% membership = @membership %>

<section class="room-settings-page" style="view-transition-name: edit-room-<%= room.id %>"
         data-controller="tabs" <%= tag.attributes("data-tabs-initial-value": params[:tab]) if params[:tab].present? %>>
  <div class="room-tabs" role="tablist">
    <button role="tab" aria-controls="tab-settings" aria-selected="true" tabindex="0"
            data-tabs-target="tab" data-action="click->tabs#select keydown->tabs#keydown">
      Settings
    </button>
    <button role="tab" aria-controls="tab-members" aria-selected="false" tabindex="-1"
            data-tabs-target="tab" data-action="click->tabs#select keydown->tabs#keydown">
      Members (<span id="room_<%= room.id %>_member_count"><%= room.active_member_count %></span>)
    </button>
  </div>

  <div id="tab-settings" role="tabpanel" data-tabs-target="panel">
    <div class="settings-card room-settings-card">
      <%= yield %>
    </div>

    <%= render "rooms/layouts/settings_panel", room: room, membership: membership %>
  </div>

  <div id="tab-members" role="tabpanel" data-tabs-target="panel" hidden>
    <%= render "rooms/layouts/members_panel", room: room %>
  </div>
</section>
