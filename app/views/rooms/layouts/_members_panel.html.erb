<div data-controller="member-editor" data-member-editor-members-url-value="<%= room_members_path(room) %>">
  <% if Current.user.can_administer?(room) && room.is_a?(Rooms::Closed) %>
    <input type="search"
           autocorrect="off"
           autocomplete="off"
           data-1p-ignore="true"
           class="input fill full-width margin-block"
           placeholder="Find people to add or remove"
           data-member-editor-target="input"
           data-action="input->member-editor#search">

    <p class="field-error margin-block-half" data-member-editor-target="error" role="alert" hidden></p>

    <div class="member-tab-list margin-block-half" data-member-editor-target="results" hidden></div>
  <% elsif Current.user.can_administer?(room) && room.is_a?(Rooms::Open) %>
    <p class="txt-small txt-muted margin-block-half">Anyone in the community can join this room, so its members aren't managed here. Make the room private to choose who's in it.</p>
  <% end %>

  <%# Eager, not lazy: this frame starts inside the hidden Members tab panel, so a
      lazy frame never intersects the viewport and never loads. Eager fetches on
      connect regardless of visibility, so the roster is ready by the time the tab
      is opened. %>
  <%= turbo_frame_tag :room_members, src: room_members_path(room), data: { member_editor_target: "roster" } do %>
    <div class="txt-align-center pad"><div class="spinner"></div></div>
  <% end %>
</div>
