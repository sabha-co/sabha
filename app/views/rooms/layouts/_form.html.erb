<%= form_with model: room, data: { controller: "form" } do |form| %>
  <div class="flex flex-column gap">
    <% if Current.user.can_administer?(room) %>
      <div class="flex align-center gap">
        <%= translation_button(:room_name) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_field :name, name: "room[name]", id: "room_name", class: "input txt-large",
                required: true, autofocus: true, placeholder: "Name the room",
                data: { turbo_permanent: true, action: "keydown.enter->form#submit:prevent" } %>
          <%= icon_tag "chat-bubble" %>
        </label>
      </div>

      <div class="flex align-start gap">
        <%= translation_button(:room_description) %>

        <label class="flex align-center gap flex-item-grow input input--actor">
          <%= form.text_area :description, name: "room[description]", rows: 2, maxlength: 280, class: "input txt-medium",
                placeholder: "What's this room about?" %>
        </label>
      </div>

      <%= submit_room_button_tag %>
    <% else %>
      <h1 class="flex-item-grow txt-x-large">
        <%= room.name %>
      </h1>
      <% if room.description.present? %>
        <p class="txt-deemphasize margin-none"><%= room.description %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
