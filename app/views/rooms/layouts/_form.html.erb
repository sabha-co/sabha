<%= form_with model: room, data: { controller: "form", action: "input->form#refreshDirty" } do |form| %>
  <% if Current.user.can_administer?(room) %>
    <div class="settings-field">
      <div class="settings-field__label">
        <label for="room_name">Name</label>
      </div>
      <%= form.text_field :name, name: "room[name]", id: "room_name", class: "input",
            required: true, autofocus: true, placeholder: "Name the room",
            data: { turbo_permanent: true, action: "keydown.enter->form#submit:prevent" } %>
      <% unless room.sub_room? %>
        <p class="settings-field__hint">Renaming posts a line in the room so nobody wonders what happened.</p>
      <% end %>
    </div>

    <div class="settings-field">
      <div class="settings-field__label">
        <label for="room_description">Description</label>
      </div>
      <%= form.text_area :description, name: "room[description]", id: "room_description", rows: 2, maxlength: 280, class: "input",
            placeholder: "What's this room about?" %>
    </div>

    <div class="room-settings-form__submit">
      <%= submit_room_button_tag(dirty_gated: true) %>
    </div>
  <% else %>
    <h1 class="room-settings-form__name"><%= room.name %></h1>
    <% if room.description.present? %>
      <p class="txt-deemphasize margin-none margin-block-half"><%= room.description %></p>
    <% end %>
  <% end %>
<% end %>
