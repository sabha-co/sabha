<% @page_title = "Edit settings for #{room_display_name(room)}" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to_last_room_visited %>
  </div>
<% end %>

<% membership = @membership %>
<% is_muted = membership&.involved_in_nothing? %>
<% is_hidden = membership&.involved_in_invisible? %>

<section class="panel" style="view-transition-name: edit-room-<%= room.id %>">
  <div class="txt-align-center">
    <%= yield %>
  </div>

  <% if membership && !room.thread? %>
    <hr class="margin-block separator full-width" style="--border-style: solid">
    <%= form_with url: room_involvement_path(room, return_to: request.path), method: :put, data: { controller: "form" }, class: "flex align-center gap pad-block" do %>
      <% unmuted_involvement = room.direct? ? "everything" : "mentions" %>
      <%= hidden_field_tag :involvement, is_muted ? unmuted_involvement : "nothing" %>
      <span>Mute notifications</span>
      <hr class="separator" aria-hidden="true">
      <label class="switch">
        <input type="checkbox"
               class="switch__input"
               <%= "checked" if is_muted %>
               data-action="change->form#submit">
        <span class="switch__btn round"></span>
      </label>
    <% end %>

    <% if room.respond_to?(:other_user) && (block_target = room.other_user) %>
      <%= render "blocks/toggle", user: block_target %>
    <% end %>

    <% unless room.direct? %>
      <%= form_with url: room_involvement_path(room, return_to: request.path), method: :put, data: { controller: "form" }, class: "flex align-center gap pad-block" do %>
        <%= hidden_field_tag :involvement, is_hidden ? "mentions" : "invisible" %>
        <span>Hide from sidebar</span>
        <hr class="separator" aria-hidden="true">
        <label class="switch">
          <input type="checkbox"
                 class="switch__input"
                 <%= "checked" if is_hidden %>
                 data-action="change->form#submit">
          <span class="switch__btn round"></span>
        </label>
      <% end %>
    <% end %>
  <% end %>

  <% if room.direct? || (Current.user.can_administer?(room) && !room.original?) %>
    <hr class="margin-block separator full-width" style="--border-style: solid">
    <div class="txt-align-center">
      <%= button_to_delete_room room %>
    </div>
  <% end %>
</section>
