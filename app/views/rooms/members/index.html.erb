<%= turbo_frame_tag :room_members do %>
  <div class="member-tab-list">
    <div id="room_members_list" contents>
      <%= render partial: "rooms/members/member_row", collection: @members, as: :user, locals: { room: @room, editable: @editable } %>
      <%= render "rooms/members/next_page_container", page: @page.next_param unless @page.last? %>
    </div>
  </div>
<% end %>
