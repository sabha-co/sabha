<%# locals: (user:, room:) -%>
<div class="list-row" data-member-id="<%= user.id %>">
  <figure class="list-row__avatar avatar">
    <%= avatar_image_tag user, alt: "" %>
  </figure>

  <div class="list-row__body">
    <span class="list-row__title"><%= user.name %></span>
  </div>

  <div class="list-row__trailing">
    <%= button_tag type: "button", class: "btn settings-chip-btn flex-item-no-shrink",
          data: { action: "member-editor#add", user_id: user.id } do %>
      <%= icon_tag "add" %>
      <span>Add</span>
    <% end %>
  </div>
</div>
