<%= turbo_stream.remove :next_page_container %>

<%= turbo_stream.append :room_members_list do %>
  <%= render partial: "rooms/members/member_row", collection: @members, as: :user, locals: { room: @room, editable: @editable } %>
<% end %>

<% unless @page.last? %>
  <%= turbo_stream.append :room_members_list, partial: "rooms/members/next_page_container", locals: { page: @page.next_param } %>
<% end %>
