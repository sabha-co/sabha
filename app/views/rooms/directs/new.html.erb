<%# The new-message compose screen (Rooms::DirectsController#new): an editable
    To: recipient picker over a first-message composer, filling the DM inbox
    main pane. It writes nothing until you send — sending materializes the
    conversation (#create) and redirects to the real room. Reachable empty (the
    DM index +) or with recipients pre-seeded (a "Message X" link). %>
<% others = @recipients.without(Current.user) %>
<% picked = others.any? %>
<%# The screen's copy, declared once here and handed to the dm-compose controller
    as Stimulus values, so the server-rendered initial state and the client-side
    updates can never drift. Placeholder templates share Ruby's %{…} tokens so
    the same string interpolates on both sides. %>
<% title  = { empty: "Who is this for?", picked: "No messages yet" } %>
<% blurb  = { empty: "Direct messages are private to the people in them. Add one or more people to start.",
              picked: "They'll see this conversation once you send the first message." } %>
<% hint   = { empty: "Add someone above first", one: "Message %{name}", many: "Message %{count} people" } %>
<%# Render the state the recipients already imply (a pre-seeded "Message X" link
    opens with someone chosen), so the screen is correct without JS. %>
<% composer_placeholder =
     if others.one? then hint[:one] % { name: others.first.name.split(" ").first }
     elsif others.many? then hint[:many] % { count: others.size }
     else hint[:empty] end %>
<% @page_title = "New message" %>
<% @body_class = "sidebar" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% content_for :list_rail do %>
  <%= render "inboxes/direct_messages/rail" %>
<% end %>

<% content_for :nav do %>
  <span class="dm-back"><%= link_back_to_or_referrer inbox_direct_messages_path %></span>
  <h1 class="navbar-title">New message</h1>
<% end %>

<div id="message-area" class="message-area" contents>
  <%# Send carries the picked recipients and the first message together, so one
      submit both chooses who and creates the conversation. %>
  <%= form_with url: rooms_directs_path, class: "dm-new",
        data: { controller: "dm-compose", turbo_frame: "_top",
                dm_compose_empty_title_value: title[:empty], dm_compose_picked_title_value: title[:picked],
                dm_compose_empty_blurb_value: blurb[:empty], dm_compose_picked_blurb_value: blurb[:picked],
                dm_compose_empty_hint_value: hint[:empty], dm_compose_one_hint_value: hint[:one],
                dm_compose_many_hint_value: hint[:many] } do |form| %>
    <div class="dm-new__to">
      <label class="dm-new__to-label" for="user_ids_input">To</label>
      <section class="autocomplete__container flex-item-grow">
        <div class="autocomplete__input input input--actor flex flex-wrap align-center position-relative"
            data-controller="autocomplete" data-autocomplete-url-value="<%= autocompletable_users_path %>">
          <%= render "users/autocompletables/user_select", form: form, placeholder: "Search people by name", selected: others %>
        </div>
      </section>
    </div>

    <div class="dm-new__hero">
      <h2 class="dm-new__title" data-dm-compose-target="title"><%= picked ? title[:picked] : title[:empty] %></h2>
      <p class="dm-new__blurb" data-dm-compose-target="blurb"><%= picked ? blurb[:picked] : blurb[:empty] %></p>
    </div>

    <div class="dm-new__composer">
      <input type="text" name="message[body]" class="dm-new__input"
            placeholder="<%= composer_placeholder %>" autocomplete="off"
            data-dm-compose-target="input" data-action="input->dm-compose#refresh">
      <%= button_tag "Send", type: "submit", class: "btn btn--reversed dm-new__send", data: { dm_compose_target: "send" }, disabled: true %>
    </div>
  <% end %>
</div>
