<%# The new-message compose screen (Rooms::DirectsController#new): an editable
    To: recipient picker over a first-message composer, filling the DM inbox
    main pane. It writes nothing until you send — sending materializes the
    conversation (#create) and redirects to the real room. Reachable empty (the
    DM index +) or with recipients pre-seeded (a "Message X" link). %>
<% others = @recipients.without(Current.user) %>
<% picked = others.any? %>
<%# Render the state the recipients already imply (a pre-seeded "Message X"
    link opens with someone chosen), so the screen is correct without JS and the
    dm-compose controller only has to react to later changes. %>
<% composer_placeholder =
     if others.one? then "Message #{others.first.name.split(' ').first}"
     elsif others.many? then "Message #{others.size} people"
     else "Add someone above first" end %>
<% @page_title = "New message" %>
<% @body_class = "sidebar" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% content_for :list_rail, render("inboxes/direct_messages/rail") %>

<% content_for :nav do %>
  <span class="dm-back"><%= link_back_to_or_referrer inbox_direct_messages_path %></span>
  <h1 class="navbar-title">New message</h1>
<% end %>

<div id="message-area" class="message-area" contents>
  <%# Send carries the picked recipients and the first message together, so one
      submit both chooses who and creates the conversation. %>
  <%= form_with url: rooms_directs_path, class: "dm-new",
        data: { controller: "dm-compose", turbo_frame: "_top" } do |form| %>
    <div class="dm-new__to">
      <label class="dm-new__to-label" for="user_ids_input">To</label>
      <section class="autocomplete__container flex-item-grow">
        <div class="autocomplete__input input flex flex-wrap position-relative"
            data-controller="autocomplete" data-autocomplete-url-value="<%= autocompletable_users_path %>">
          <%= render "users/autocompletables/user_select", form: form, placeholder: "Search people by name", selected: others %>
        </div>
      </section>
    </div>

    <div class="dm-new__hero">
      <h2 class="dm-new__title" data-dm-compose-target="title"><%= picked ? "No messages yet" : "Who is this for?" %></h2>
      <p class="dm-new__blurb" data-dm-compose-target="blurb"><%= picked ? "They'll see this conversation once you send the first message." : "Direct messages are private to the people in them. Add one or more people to start." %></p>
    </div>

    <div class="dm-new__composer">
      <input type="text" name="message[body]" class="dm-new__input"
            placeholder="<%= composer_placeholder %>" autocomplete="off"
            data-dm-compose-target="input" data-action="input->dm-compose#refresh">
      <%= button_tag "Send", type: "submit", class: "btn btn--reversed dm-new__send", data: { dm_compose_target: "send" }, disabled: true %>
    </div>
  <% end %>
</div>
