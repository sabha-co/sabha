<%# locals: (recipients:, title:) -%>
<%# The provisional DM header, shown while composing a not-yet-created
    conversation (rooms/directs/new). It names the chosen recipients in the
    redesign navbar but has nothing to edit or follow yet — the live
    conversation's header lives in rooms/show/_nav. %>
<% content_for :nav do %>
  <%# The rail replaces this affordance at split widths (CSS hides it) %>
  <span class="dm-back"><%= link_back_to_or_referrer inbox_direct_messages_path %></span>

  <div class="navbar-dm">
    <span class="avatar navbar-dm__avatar">
      <% if recipients.many? %>
        <div class="avatar__group">
          <% recipients.first(4).each do |recipient| %>
            <span class="avatar"><%= avatar_image_tag(recipient, size: 20, loading: :lazy) %></span>
          <% end %>
        </div>
      <% else %>
        <%= avatar_image_tag(recipients.first, size: 30) %>
      <% end %>
    </span>

    <div class="navbar-dm__text">
      <h1 class="navbar-title">
        <span class="for-screen-reader">Direct message with</span>
        <%= title %>
      </h1>
    </div>
  </div>
<% end %>
