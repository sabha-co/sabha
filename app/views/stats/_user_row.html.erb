<%#
  Renders a user row in stats tables

  Local variables:
  - user: The user to display
  - rank: The rank number to show (optional)
  - count: The count to display (e.g., message_count)
  - from_path: Path for the from parameter in user link (default: "/stats")
  - is_current: Whether this is the current user (optional, auto-detected if not provided)
  - show_separator: Whether to show a separator before this row (default: false)
%>
<% is_current = local_assigns[:is_current].nil? ? user.id == Current.user&.id : is_current %>
<% from_path ||= "/stats" %>
<% show_separator ||= false %>

<% if show_separator %>
  <tr class="separator-row" role="separator" aria-hidden="true">
    <td colspan="3" class="txt-center txt-small txt-faded">
      <div class="separator-line"></div>
    </td>
  </tr>
<% end %>

<tr class="<%= 'current-user' if is_current %>">
  <% if local_assigns[:rank] %>
    <td class="txt-right txt-small txt-faded col-rank"><%= rank %></td>
  <% end %>
  <td>
    <%= link_to user_path(user, from: from_path), class: "user-row" do %>
      <div class="avatar-xs">
        <% if user.avatar.attached? %>
          <%= image_tag user.avatar, alt: user.name, loading: "lazy" %>
        <% else %>
          <%= user.name.first.upcase %>
        <% end %>
      </div>
      <span class="txt-truncate"><%= user.name %></span>
    <% end %>
  </td>
  <td class="txt-right">
    <%= number_with_delimiter(count) %>
  </td>
</tr>
