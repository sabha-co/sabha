<%#
  Renders a CSS-based sparkline chart

  Local variables:
  - stats: Collection of objects with .date and .count attributes
%>
<% return if stats.blank? %>
<% max_count = stats.map(&:count).max %>
<% return if max_count.nil? || max_count == 0 %>

<div class="sparkline" role="img" aria-label="Message activity chart">
  <% stats.each do |stat| %>
    <%
      height_percent = (stat.count.to_f / max_count * 100).round(1)
      # Parse date robustly for tooltip
      date_label = if stat.date.present?
        begin
          Date.parse(stat.date.to_s).strftime("%m/%d")
        rescue ArgumentError
          stat.date.to_s
        end
      else
        ''
      end
      tooltip = "#{date_label}: #{number_with_delimiter(stat.count)}"
    %>
    <div
      class="sparkline__bar"
      style="height: <%= height_percent %>%;"
      data-tooltip="<%= tooltip %>"
      role="presentation"
    ></div>
  <% end %>
</div>
