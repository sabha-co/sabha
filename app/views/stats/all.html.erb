<% @page_title = "All-Time Stats" %>
<% @body_class = "sidebar stats-page" %>

<% content_for :head do %>
  <%= stylesheet_link_tag "application/stats" %>
<% end %>

<% content_for :nav do %>
  <%= account_logo_tag if Current.account.logo.attached? %>
  <%= tag.span class: "btn btn--reversed btn--faux room--current" do %>
    <h1 class="room__contents txt-medium overflow-ellipsis">All-Time Stats</h1>
  <% end %>
  <%= link_to stats_path, class: "btn" do %>
    <%= icon_tag "arrow-left" %>
    <span>Back to Stats</span>
  <% end %>
  <%= link_to stats_all_path, class: "btn d-hotwire-native-none" do %>
    <%= icon_tag "refresh" %>
    <span class="for-screen-reader">Refresh stats</span>
  <% end %>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<section class="full-width">
  <div class="margin-block">
    <div class="card">
      <div class="card-header">
        <h2 class="txt-h3 margin-none">All Time</h2>
      </div>
      <div class="card-body compact">
        <div class="overflow-x-auto">
          <table class="table full-width">
            <tbody>
              <% if @all_time_stats.present? %>
                <% @all_time_stats.each do |user| %>
                  <%= render "stats/user_row", user: user, rank: @precomputed_ranks[user.id], count: user.total_message_count, from_path: "/stats/all" %>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="3" class="txt-center">No messages yet</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
