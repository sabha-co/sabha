<% @page_title = "Monthly Stats" %>
<% @body_class = "sidebar stats-page" %>

<% content_for :head do %>
  <%= stylesheet_link_tag "application/stats" %>
<% end %>

<% content_for :nav do %>
  <%= account_logo_tag if Current.account.logo.attached? %>
  <%= tag.span class: "btn btn--reversed btn--faux room--current" do %>
    <h1 class="room__contents txt-medium overflow-ellipsis">Monthly Stats</h1>
  <% end %>
  <%= link_to stats_path, class: "btn" do %>
    <%= image_tag("arrow-left.svg", aria: { hidden: "true" }, size: 20) %>
    <span>Back to Stats</span>
  <% end %>
  <%= link_to stats_monthly_path, class: "btn d-hotwire-native-none" do %>
    <%= image_tag("refresh.svg", aria: { hidden: "true" }, size: 20) %>
    <span class="for-screen-reader">Refresh stats</span>
  <% end %>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<section class="full-width">
  <%
    # Group months by year
    months_by_year = @months.group_by do |month|
      year, _ = month.split('-')
      year
    end

    # Sort years in descending order
    sorted_years = months_by_year.keys.sort.reverse
  %>

  <% sorted_years.each do |year| %>
    <h2 class="section-heading"><%= year %></h2>
    <div class="stats-grid margin-block" style="margin-bottom: 2rem;">
      <%
        # Sort months within year in descending order (December to January)
        months_in_year = months_by_year[year].sort.reverse
      %>
      <% months_in_year.each do |month| %>
        <% year, month_num = month.split('-') %>
        <% month_name = Date.new(year.to_i, month_num.to_i, 1).strftime("%B %Y") %>
        <div class="card grid-card">
          <div class="card-header">
            <h2 class="txt-h3 margin-none"><%= month_name %></h2>
          </div>
          <div class="card-body compact">
            <div class="overflow-x-auto">
              <table class="table full-width">
                <tbody>
                  <% if @monthly_stats[month].present? %>
                    <% @monthly_stats[month].each_with_index do |user, index| %>
                      <%= render "stats/user_row", user: user, rank: index + 1, count: user.message_count, from_path: "/stats/monthly" %>
                    <% end %>
                  <% else %>
                    <tr>
                      <td colspan="3" class="txt-center">No messages yet</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
