<% content_for :title, "Signed out" %>

<section class="auth-card">
  <header class="auth-card__header">
    <%= link_to root_path, class: "auth-card__logo" do %>
      <%= image_tag fresh_account_logo_path, alt: Branding.contextual_app_name %>
    <% end %>
    <div>
      <h1 class="auth-card__title">You're signed out of <%= Branding.contextual_app_name %></h1>
      <p class="auth-card__blurb">Your session on this device has ended. Other devices you signed in on are unaffected.</p>
    </div>
  </header>

  <%= link_to "Sign in again", sso_handshake_path, class: "btn auth-card__submit" %>
</section>
