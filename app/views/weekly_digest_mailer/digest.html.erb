<p>Here's what happened this week in <strong><%= @workspace_name %></strong>.</p>

<% if @everyone_mentions.any? %>
  <p style="margin-top: 24px; font-weight: 600;">Announcements you missed</p>
  <ul style="padding-left: 20px; margin: 8px 0 0;">
    <% @everyone_mentions.each do |message| %>
      <li style="margin-bottom: 8px;">
        <strong><%= sender_for(message) %></strong>
        in <strong><%= message.room.name %></strong>:
        <span style="color: #6b6b6b;"><%= preview_for(message) %></span>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @active_rooms.any? %>
  <p style="margin-top: 24px; font-weight: 600;">Rooms with activity</p>
  <ul style="padding-left: 20px; margin: 8px 0 0;">
    <% @active_rooms.each do |room, count| %>
      <li style="margin-bottom: 4px;"><strong><%= room.name %></strong> &mdash; <%= pluralize(count, "message") %></li>
    <% end %>
  </ul>
<% end %>

<% if @excerpts.any? %>
  <p style="margin-top: 24px; font-weight: 600;">Recent discussion</p>
  <ul style="padding-left: 20px; margin: 8px 0 0;">
    <% @excerpts.each do |message| %>
      <li style="margin-bottom: 8px;">
        <strong><%= sender_for(message) %></strong>
        in <strong><%= message.room.name %></strong>:
        <span style="color: #6b6b6b;"><%= preview_for(message) %></span>
      </li>
    <% end %>
  </ul>
<% end %>

<p style="margin-top: 32px;">
  <%= link_to "Open Activity", @activity_url, style: "background: #2563eb; color: #ffffff; padding: 10px 16px; border-radius: 6px; text-decoration: none;" %>
</p>

<p style="margin-top: 24px; color: #9b9a97; font-size: 13px;">
  <%= link_to "Manage notification settings", @settings_url, style: "color: #9b9a97;" %>
  &nbsp;·&nbsp;
  <%= link_to "Unsubscribe from the weekly digest", @unsubscribe_url, style: "color: #9b9a97;" %>
</p>
