<%# locals: (message:, thread:, unread: 0, followed:) -%>
<%# A followed thread as a card: the room and who started it on the head row, the
    root message, then the reply facepile with the follow toggle at the end of the
    foot row. Reply count and last-reply ride the embedded messages/threads target,
    so they update live; the "new" badge and follow state reflect page-load state
    (the inbox stream is viewer-less). %>
<div id="<%= dom_id(message) %>" class="thread-card <%= "thread-card--unread" if unread > 0 %>"
     data-message-id="<%= message.id %>"
     data-sort-value="<%= message.created_at.to_fs(:epoch) %>"
     data-search-results-target="message"
     data-inbox-target="message">
  <div class="thread-card__head">
    <%= link_to room_display_name(message.room, for_user: nil), room_path(message.room), class: "thread-card__room" %>
    <span class="thread-card__starter">started by <strong><%= thread.creator.name %></strong></span>
    <% if unread > 0 %>
      <span class="thread-card__new"><%= unread %> new</span>
    <% end %>
  </div>

  <%= link_to rooms_thread_path(thread), class: "thread-card__root", data: { turbo_frame: "thread_panel_frame" } do %>
    <%= truncate(message.plain_text_body, length: 140) %>
  <% end %>

  <div class="thread-card__foot">
    <%= render "messages/threads", message: message %>
    <%= render "rooms/threads/follow_control", thread: thread, followed: followed %>
  </div>
</div>
