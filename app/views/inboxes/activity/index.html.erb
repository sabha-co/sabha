<% @page_title = "Activity" %>
<% mark_all_read = capture do %>
  <div class="navbar-actions">
    <%= button_to "Mark all read", inbox_clearance_path, class: "btn txt-small" %>
  </div>
<% end %>
<%= render "inboxes/nav", title: "Activity",
      count: (@unread_activity_count.to_i.positive? ? "#{@unread_activity_count} unread" : nil),
      actions: mark_all_read do %>
  <%= render "inboxes/activity/filter" %>
<% end %>

<% content_for :messages do %>
  <%= search_results_tag("inbox", inbox_activity_index_url(filter: params[:filter]), highlight_mentions: true, thread_messages: false, active_filter: Inbox::ActivityQuery::FILTERS[params[:filter]]) do %>
    <%= render "notifications/list", notifications: @notifications %>
  <% end %>
  <%= turbo_stream_from Current.user, :inbox_activity %>
<% end %>

<%= render template: "inboxes/show" %>
