<% content_for :nav do %>
  <%= link_back %>

  <h1 class="navbar-title"><%= title %></h1>
  <% if local_assigns[:count] %>
    <span class="navbar-count"><%= count %></span>
  <% end %>

  <%= yield if block_given? %>

  <div class="flex-item-grow"></div>

  <%= local_assigns[:actions] %>
<% end %>
