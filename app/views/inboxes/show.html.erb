<% @page_title ||= "Inbox" %>
<% @body_class = "sidebar inbox" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<%
  empty_state = case @page_title
  when "Activity"
    {
      icon: "mentions",
      headline: "No activity yet",
      description: "Mentions, boosts, and thread replies will appear here."
    }
  when "Direct Messages"
    {
      icon: "messages",
      headline: "No conversations yet",
      description: "Start a conversation by clicking the + DM button in the sidebar."
    }
  when "Threads"
    {
      icon: "threads",
      headline: "No threads yet",
      description: "Replies to messages you've participated in will appear here."
    }
  when "Bookmarks"
    {
      icon: "bookmark",
      headline: "No bookmarks yet",
      description: "Save messages for later by clicking the bookmark icon on any message."
    }
  else
    {
      icon: "messages-outlined",
      headline: "All caught up",
      description: "You don't have any notifications right now."
    }
  end
%>

<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <div class="message-area--empty__content center pad">
      <figure class="message-area--empty__figure">
        <%= icon_tag empty_state[:icon] %>
      </figure>

      <div class="message-area--empty__text">
        <h2 class="txt-large"><%= empty_state[:headline] %></h2>
        <p class="txt-muted"><%= empty_state[:description] %></p>
      </div>
    </div>
  </div>

  <%= yield :messages %>
  <%= turbo_stream_from :inbox %>
  <%= turbo_stream_from Current.user, :inbox %>
</div>

<% content_for :footer do %>
  <div class="margin-block-start">&nbsp;</div>
<% end %>
