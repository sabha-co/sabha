<% @page_title ||= "Inbox" %>
<% @body_class = "sidebar inbox" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<%
  empty_state = case controller_name
  when "activity"
    {
      headline: "Nothing needs you",
      description: "Mentions, replies in threads you follow, and reactions to your messages land here. Everything so far is read."
    }
  when "direct_messages"
    {
      headline: "No conversations yet",
      description: Current.user.can_create_direct_messages? ?
        "Direct messages are private to the people in them. Type a name above to start one." :
        "Direct messages are private to the people in them."
    }
  when "threads"
    {
      headline: "No threads yet",
      description: "Reply in a thread, or start one from any message, and it appears here with its unread count."
    }
  when "bookmarks"
    {
      headline: "No bookmarks yet",
      description: "Save a message from its ⋯ menu and it waits here — private to you, and it never expires."
    }
  else
    {
      headline: "Nothing here yet",
      description: "Messages from the rooms you're in will appear here."
    }
  end
%>

<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <div class="empty-state">
      <h2 class="empty-state__title"><%= empty_state[:headline] %></h2>
      <p class="empty-state__body"><%= empty_state[:description] %></p>
    </div>
  </div>

  <%= yield :messages %>
  <%= turbo_stream_from Current.account, :inbox %>
  <%= turbo_stream_from Current.user, :inbox %>
</div>

<% content_for :footer do %>
  <div class="margin-block-start">&nbsp;</div>
<% end %>
