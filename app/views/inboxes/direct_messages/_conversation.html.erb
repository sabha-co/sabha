<% members = direct_room_members[membership.room_id] || [] %>
<% last_message = membership.room.last_message %>
<%# Broadcast re-renders pass no statuses map — fall back to a single lookup
    so live-updated rows keep their presence dot. %>
<% presence = if members.one?
     statuses = local_assigns[:member_statuses] || User.presence_dots_for([ members.first ])
     statuses[members.first.id]
   end %>
<% notifications_count = membership.unread_notifications_count.to_i %>
<%= link_to room_path(membership.room),
            class: ["list-row", "dm-conversation", "unread": membership.unread?, "dm-conversation--current": local_assigns[:current]],
            id: dom_id(membership.room, :dm_inbox),
            data: { room_id: membership.room_id, dm_list_target: "conversation" } do %>
  <div class="dm-conversation__avatar list-row__avatar">
    <% if members.many? %>
      <div class="avatar__group">
        <% members.first(4).each do |member| %>
          <span class="avatar">
            <%= avatar_image_tag(member, size: 20, loading: :lazy) %>
          </span>
        <% end %>
      </div>
    <% else %>
      <span class="avatar">
        <%= avatar_image_tag(members.first || Current.user, size: 48, loading: :lazy) %>
        <% if presence %>
          <%= presence_dot_tag members.first, presence, surface: :conversation %>
        <% end %>
      </span>
    <% end %>
  </div>

  <div class="dm-conversation__content list-row__body">
    <div class="dm-conversation__names list-row__title">
      <%= members.any? ? members.map(&:name).to_sentence : "Note to self" %>
    </div>

    <% if last_message.present? %>
      <div class="dm-conversation__preview list-row__subtitle">
        <span class="dm-conversation__sender"><%= last_message.creator.name %>:</span>
        <span class="dm-conversation__text"><%= last_message.plain_text_body.truncate(100) %></span>
      </div>
    <% end %>
  </div>

  <div class="dm-conversation__meta list-row__trailing">
    <span class="dm-conversation__time">
      <%= local_datetime_tag membership.room.last_active_at, style: :compact %>
    </span>
    <% if notifications_count > 0 %>
      <span class="dm-conversation__count"><%= unread_badge_count(notifications_count) %></span>
    <% elsif membership.unread? %>
      <span class="dm-conversation__badge"></span>
    <% end %>
  </div>
<% end %>
