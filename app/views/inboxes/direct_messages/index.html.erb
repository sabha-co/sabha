<% @page_title = "Direct Messages" %>
<% @body_class = "sidebar inbox" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% content_for :list_rail, render("inboxes/direct_messages/rail") %>

<%= render layout: "inboxes/nav", locals: { title: tag.span("Direct Messages", class: "hide-on-mobile") + tag.span("DMs", class: "hide-on-desktop") } do %>
  <%= button_to inbox_clearance_path(scope: "direct_messages"), class: "btn", title: "Mark all DMs as read",
      data: { turbo_confirm: "Mark all DMs as read?" } do %>
    <%= icon_tag "check" %>
  <% end %>
<% end %>

<%# Split widths show this beside the rail; below them the rail is the screen %>
<div class="dm-empty-pane">
  <div class="empty-state">
    <h2 class="empty-state__title">Select a conversation</h2>
    <p class="empty-state__body">Direct messages are private to the people in them.</p>
  </div>
</div>
