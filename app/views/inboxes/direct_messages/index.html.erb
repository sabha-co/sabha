<% @page_title = "Direct Messages" %>
<% @body_class = "sidebar inbox" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>
<% content_for :list_rail do %>
  <%= render "inboxes/direct_messages/rail" %>
<% end %>

<% mark_all_read = capture do %>
  <div class="navbar-actions">
    <%= button_to "Mark all read", inbox_clearance_path(scope: "direct_messages"), class: "btn txt-small",
        data: { turbo_confirm: "Mark all DMs as read?" } %>
  </div>
<% end %>

<%= render "inboxes/nav",
      title: tag.span("Direct Messages", class: "hide-on-mobile") + tag.span("DMs", class: "hide-on-desktop"),
      actions: mark_all_read %>

<%# Split widths show this beside the rail; below them the rail is the screen %>
<div class="dm-empty-pane">
  <div class="empty-state">
    <h2 class="empty-state__title">Select a conversation</h2>
    <p class="empty-state__body">Direct messages are private to the people in them.</p>
  </div>
</div>
