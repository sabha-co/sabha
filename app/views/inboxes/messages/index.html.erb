<%= render "inboxes/nav", title: "All Messages" %>

<% content_for :messages do %>
  <%= search_results_tag("inbox", inbox_messages_url, highlight_mentions: true, thread_messages: false) do %>
    <%= render "inboxes/messages/items", messages: @messages %>
  <% end %>
<% end %>

<%= render template: "inboxes/show" %>
