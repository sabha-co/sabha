<% @page_title = "No rooms yet" %>
<% @body_class = "sidebar" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<div id="message-area" class="message-area">
  <div class="message-area--empty">
    <div class="empty-state">
      <h1 class="empty-state__title">Welcome to <%= Branding.contextual_app_name %></h1>
      <p class="empty-state__body">You haven't joined any rooms yet. Join or create one to start chatting.</p>
      <%= link_to "Create a room", new_rooms_open_path, class: "btn empty-state__action" %>
    </div>
  </div>
</div>
