<p>You have new activity in <strong><%= @workspace_name %></strong>.</p>

<% @grouped_items.each do |room, items| %>
  <p style="margin-top: 24px; font-weight: 600;"><%= room_label_for(room) %></p>
  <ul style="padding-left: 20px; margin: 8px 0 0;">
    <% items.each do |item| %>
      <li style="margin-bottom: 8px;">
        <strong><%= sender_for(item) %></strong>
        <span style="color: #6b6b6b;"><%= preview_for(item) %></span>
      </li>
    <% end %>
  </ul>
<% end %>

<p style="margin-top: 32px;">
  <%= link_to "Open Activity", @activity_url, style: "background: #2563eb; color: #ffffff; padding: 10px 16px; border-radius: 6px; text-decoration: none;" %>
</p>

<p style="margin-top: 24px; color: #9b9a97; font-size: 13px;">
  <%= link_to "Manage notification settings", @settings_url, style: "color: #9b9a97;" %>
  &nbsp;·&nbsp;
  <%= link_to "Unsubscribe from these emails", @unsubscribe_url, style: "color: #9b9a97;" %>
</p>
