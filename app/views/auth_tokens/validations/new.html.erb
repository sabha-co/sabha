<% content_for :title, "Enter code" %>
<% turbo_page_requires_reload %>
<% content_for :back_nav do %>
  <%= link_to "← Back", new_session_path, class: "txt-medium txt-muted txt-undecorated" %>
<% end %>

<section class="auth-card <%= "shake" if flash[:alert] %>">
  <header class="auth-card__header">
    <%= link_to root_path, class: "auth-card__logo" do %>
      <%= image_tag fresh_account_logo_path, alt: Branding.contextual_app_name %>
    <% end %>
    <div>
      <h1 class="auth-card__title">Check your email</h1>
      <p class="auth-card__blurb">We sent a code to <strong><%= session[:otp_email_address] || "your email" %></strong>. It expires in 15 minutes and works once.</p>
    </div>
  </header>

  <%= form_with url: auth_tokens_validations_url, html: { autocomplete: "off" } do |form| %>
    <%= render "sessions/code_field", form: form %>
    <%= render "sessions/submit_button", form: form, label: "Verify" %>
  <% end %>

  <p class="auth-card__note">
    Didn't receive it? <%= link_to "Try again", new_session_path %>
  </p>
</section>
