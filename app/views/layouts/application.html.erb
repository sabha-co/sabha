<!DOCTYPE html>
<html lang="en" data-accent="<%= account_accent %>">
  <head>
    <meta charset="utf-8">
    <%= render "layouts/theme_preference" %>

    <%= page_title_tag %>
    <meta name="description" content="<%= Branding.app_description %>">

    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="theme-color" content="<%= Branding.theme_color %>">
    <meta name="mobile-web-app-capable" content="yes">

    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= Branding.app_description %>">
    <meta property="og:image" content="<%= request.base_url %>/sabha-og.jpg">
    <meta property="og:logo" content="<%= request.base_url %>/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= Sabha.saas? ? tenanted_action_cable_meta_tag : signed_action_cable_meta_tag %>
    <%= tag.meta name: "anycable-whisper", content: "true" %>
    <%= current_user_meta_tags %>

    <%= tag.meta name: "vapid-public-key", content: Rails.configuration.x.vapid.public_key %>
    <%= workspace_base_path_meta_tag if Sabha.saas? %>
    <%= tag.meta name: "turbo-prefetch", content: "true" %>

    <%= tag.link rel: "manifest", href: webmanifest_path(format: :json) %>
    <%= tag.link rel: "icon", href: "/icon.svg", type: "image/svg+xml" %>
    <%= tag.link rel: "icon", href: fresh_account_logo_path, type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: fresh_account_logo_path %>

    <%= preload_link_tag "instrument-sans.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "tailwind", *(Stylesheets.from("application") + Stylesheets.vendor_stylesheets), "data-turbo-track": "reload" %>
    <% if hotwire_native_app? %>
      <%= stylesheet_link_tag "native", "data-turbo-track": "reload" %>
    <% end %>
    <%= stylesheet_link_tag "overrides", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

    <%= yield :head %>

    <%= umami_analytics_tag %>
  </head>

  <body class="<%= body_classes %>" data-controller="local-time lightbox page-title theme">
    <% if DemoMode.enabled? %>
      <%= render "shared/top_banner", style: :warning, label: "Demo Mode", text: "This server resets #{DemoMode.reset_interval}. Data is not persisted." %>
    <% end %>

    <% if Sabha.saas? && respond_to?(:show_workspace_selector?) && show_workspace_selector? %>
      <%= render "shared/workspace_selector" %>
      <%= render "shared/workspace_banner" %>
    <% end %>

    <%= render "shared/storage_limit_banner" %>
    <%= render "shared/connection_banner" if signed_in? %>

    <a href="#main-content" class="skip-navigation btn" data-turbo="false">Skip to main content</a>
    <a href="#sidebar-toggle" class="skip-navigation btn" data-turbo="false">Skip to menu</a>

    <nav id="nav">
      <%= yield :nav %>
    </nav>

    <% if notice = flash[:notice] || flash[:alert] %>
      <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
        <div class="flash__inner" style="<%= "--flash-background: var(--color-negative)" if flash[:alert] %>">
          <% if flash[:alert] %>
            <%= icon_tag "alert" %>
          <% else %>
            <%= icon_tag "check" %>
          <% end %>
          <span><%= notice %></span>
        </div>
        <span class="for-screen-reader" role="alert" aria-atomic="true"><%= notice %></span>
      </div>
    <% end %>

    <% if content_for?(:list_rail) %>
      <aside id="list-rail" aria-label="Conversations">
        <%= yield :list_rail %>
      </aside>
    <% end %>

    <main id="main-content" tabindex="-1">
      <%= yield %>

      <footer id="footer">
        <%= yield :footer %>
      </footer>
    </main>

    <div class="thread-panel-controller" data-controller="thread-panel"
         data-action="keydown@document->thread-panel#closeOnEscape turbo:before-visit@document->thread-panel#closeOnNavigation turbo:before-cache@document->thread-panel#closeOnNavigation">
      <aside id="thread-panel" hidden aria-label="Thread" data-thread-panel-target="panel">
        <%# A deep-linked post (gallery visited as ?post=<slug>) eager-loads its
            panel here; the frame-load opens the panel over the gallery. %>
        <%= turbo_frame_tag "thread_panel_frame",
              src: (@deep_linked_post && rooms_post_path(@deep_linked_post, message_id: params[:message_id])),
              data: { thread_panel_target: "frame" } %>
      </aside>
      <button type="button" class="thread-panel__scrim" aria-label="Close panel"
              data-action="click->thread-panel#close"></button>
    </div>

    <aside id="sidebar" data-contrast="true" data-controller="toggle-class" data-toggle-class-toggle-class="open" data-toggle-class-close-on-escape-value="true" data-toggle-class-focus-trap-value="true" data-toggle-class-initial-focus-selector-value="#room-search">
      <%= yield :sidebar %>
    </aside>

    <%= render "layouts/lightbox" %>
    <%= render "layouts/reaction_picker" %>
    <%= render "layouts/search_palette" if Current.user %>
    <%= render "rooms/new_room_dialog" if Current.user %>
  </body>
</html>
