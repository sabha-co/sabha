<% @page_title = "Set up #{Branding.app_name}" %>
<% @body_class = "signup" %>

<div class="auth-ground">
  <section class="auth-card">
    <header class="auth-card__header">
      <span class="auth-card__logo">
        <%= image_tag "icons/sabha-icon.svg", alt: "" %>
      </span>
      <div>
        <h1 class="auth-card__title">Set up your community</h1>
        <p class="auth-card__blurb">One form, once. The community is named from your deployment config.</p>
      </div>
    </header>

    <%= form_with model: @user, url: first_run_path do |form| %>
      <div class="auth-card__avatar-row" data-controller="upload-preview">
        <%= image_tag "default-avatar.svg", data: { upload_preview_target: "image" }, aria: { hidden: true } %>
        <span class="auth-card__avatar-copy">
          <strong>Your avatar</strong>
          <span>Add one now, or replace it whenever.</span>
        </span>
        <label class="btn auth-card__chip-btn">
          Upload
          <%= form.file_field :avatar, accept: "image/*",
                data: { upload_preview_target: "input", action: "upload-preview#previewImage" } %>
          <span class="for-screen-reader">Add your avatar</span>
        </label>
      </div>

      <div class="auth-card__field">
        <div class="auth-card__label">
          <label for="user_name">Your name</label>
        </div>
        <%= form.text_field :name, class: "input", autocomplete: "name", placeholder: "How you want to be known", autofocus: true, required: true,
              data: { "1p-ignore": true } %>
      </div>

      <div class="auth-card__field">
        <div class="auth-card__label">
          <label for="user_email_address">Email</label>
        </div>
        <%= form.email_field :email_address, class: "input", autocomplete: "username", placeholder: "you@example.com", required: true %>
      </div>

      <div class="auth-card__field">
        <div class="auth-card__label">
          <label for="user_password">Password</label>
        </div>
        <%= form.password_field :password, class: "input", autocomplete: "new-password",
              placeholder: "At least #{User::MINIMUM_PASSWORD_LENGTH} characters",
              required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72 %>
      </div>

      <%= form.button class: "btn auth-card__submit", type: "submit" do %>
        Create the community
      <% end %>
    <% end %>

    <p class="auth-card__note">This account becomes the first administrator, and a <%= FirstRun::FIRST_ROOM_NAME %> room is created with everyone auto-joined.</p>
  </section>
</div>
