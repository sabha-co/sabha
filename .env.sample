# ============================================
# BRANDING CONFIGURATION
# ============================================
# These variables control how your community appears to users

# Application Identity
APP_NAME="Sabha"
APP_SHORT_NAME="Sabha"
APP_DESCRIPTION="A community chat platform powered by Sabha"
APP_HOST="chat.example.com"

# Contact & Support
SUPPORT_EMAIL="support@example.com"
MAILER_FROM_NAME="Sabha"
MAILER_FROM_EMAIL="noreply@example.com"

# Visual Branding (PWA colors)
THEME_COLOR="#1d4ed8"
BACKGROUND_COLOR="#ffffff"

# Analytics (optional — Umami)
# UMAMI_WEBSITE_ID=
# Self-hosted Umami instance (default: cloud.umami.is)
# UMAMI_HOST=cloud.umami.is

# Security - Frame ancestors for Content Security Policy
# Comma-separated list of allowed domains
CSP_FRAME_ANCESTORS=

# ============================================
# RAILS CORE CONFIGURATION
# ============================================

# Rails Master Key (from config/master.key or generate with: rails secret)
RAILS_MASTER_KEY=

# Secret Key Base (generate with: rails secret)
SECRET_KEY_BASE=

# ============================================
# NOTIFICATIONS
# ============================================

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================
# EMAIL CONFIGURATION
# ============================================

# Resend API key for sending emails
RESEND_API_KEY=

# ============================================
# AUTHENTICATION
# ============================================

# Authentication method: "password" or "otp"
# password: Email + password login
# otp: Passwordless login via email code
# Default: password
AUTH_METHOD=password

# ============================================
# OPTIONAL FEATURES
# ============================================

# AnyCable (high-performance WebSocket server) — required
ANYCABLE_SECRET=
# Optional: a distinct client-facing secret for JWT identity + signed streams,
# kept separate from the RPC/broadcast ANYCABLE_SECRET. Both fall back to
# ANYCABLE_SECRET when unset. Set on the web and anycable roles together.
# ANYCABLE_JWT_SECRET=
# ANYCABLE_STREAMS_SECRET=

# DiceBear Avatar Service (for generated default avatars)
# Enabled by default using public API (api.dicebear.com)
# Set to "false" to use initials monogram instead
DICEBEAR_ENABLED=true
# Self-host for commercial use: docker run -p 3001:3000 dicebear/api:3
# Default: https://api.dicebear.com
DICEBEAR_HOST=
# Avatar style (thumbs, bottts, avataaars, shapes, etc.)
# See: https://www.dicebear.com/styles/
DICEBEAR_STYLE=bottts-neutral

# Cloudflare Turnstile CAPTCHA (optional)
# Get keys from: https://dash.cloudflare.com/turnstile
# CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cookie domain (for session cookies)
# Leave blank for local development (localhost)
# Set to your domain for production (e.g., yourdomain.com)
COOKIE_DOMAIN=

# Error tracking (optional - Sentry DSN)
# SENTRY_DSN=

# ============================================
# DEPLOYMENT INFO
# ============================================


