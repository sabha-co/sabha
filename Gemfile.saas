# frozen_string_literal: true

# SaaS Gemfile - extends core Gemfile with multi-tenancy dependencies
#
# This file is automatically selected when SAAS=true or tmp/saas.txt exists
# via bin/rails configure_bundle

eval_gemfile "Gemfile"

# Multi-tenancy infrastructure
gem "activerecord-tenanted", "0.7.0"

# PostgreSQL for the shared untenanted database (global identities, workspaces, sessions)
gem "pg"

# AWS SES email delivery (alternative to Resend, set EMAIL_PROVIDER=ses)
gem "aws-sdk-sesv2"

# S3-compatible storage for workspace backups (Cloudflare R2)
gem "aws-sdk-s3"

# Email validation with disposable domain blocking
gem "valid_email2"

# Safe PostgreSQL migrations — catches dangerous operations at development time
gem "online_migrations"

# SaaS engine
gem "sabha-saas", path: "saas"
