web: bin/rails s -b 0.0.0.0 -p ${PORT:-3000}
anycable: anycable-go --port=8080 --http_broadcast_port=8080 --rpc_host=http://localhost:3000/_anycable --broadcast_adapter=http --secret=${ANYCABLE_SECRET:-development-secret-change-in-production} --jwt_secret=${ANYCABLE_JWT_SECRET:-${ANYCABLE_SECRET:-development-secret-change-in-production}} --streams_secret=${ANYCABLE_JWT_SECRET:-${ANYCABLE_SECRET:-development-secret-change-in-production}} --broker=memory --presence_ttl=45 --streams_whisper --log_level=info
