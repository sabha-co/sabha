web: bin/rails s -b 0.0.0.0 -p ${PORT:-3000}
css: pnpm exec tailwindcss -i app/javascript/entrypoints/application.css -o app/assets/builds/tailwind.css --watch
anycable: anycable-go --port=8080 --http_broadcast_port=8080 --rpc_host=http://localhost:3000/_anycable --broadcast_adapter=http --secret=${ANYCABLE_SECRET:-development-secret-change-in-production} --jwt_secret=${ANYCABLE_JWT_SECRET:-${ANYCABLE_SECRET:-development-secret-change-in-production}} --streams_secret=${ANYCABLE_JWT_SECRET:-${ANYCABLE_SECRET:-development-secret-change-in-production}} --broker=memory --streams_whisper --log_level=info
