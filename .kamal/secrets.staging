# Secrets for staging.sabha.co deployment (self-hosted single-tenant)
#
# Local deploy: set -a && source .env.staging && set +a && kamal deploy -d staging
# In CI these values come from the `staging` GitHub environment instead.

# Deployment Configuration
SERVER_IP=$SERVER_IP
PROXY_HOST=$PROXY_HOST

# Deployment Info
APP_VERSION=$(git rev-parse --short HEAD 2>/dev/null || echo "dev")
LAST_DEPLOY=$(date +%s)

# Registry
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails Core
SECRET_KEY_BASE=$SECRET_KEY_BASE

# AnyCable (required)
ANYCABLE_SECRET=$ANYCABLE_SECRET

# Cookie domain
COOKIE_DOMAIN=$COOKIE_DOMAIN

# Push Notifications (optional — leave blank to disable)
VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY

# Email (optional — leave blank to disable)
RESEND_API_KEY=$RESEND_API_KEY

# Branding
APP_NAME=$APP_NAME
APP_SHORT_NAME=$APP_SHORT_NAME
APP_DESCRIPTION=$APP_DESCRIPTION
APP_HOST=$APP_HOST
SUPPORT_EMAIL=$SUPPORT_EMAIL
MAILER_FROM_NAME=$MAILER_FROM_NAME
MAILER_FROM_EMAIL=$MAILER_FROM_EMAIL
THEME_COLOR=$THEME_COLOR
BACKGROUND_COLOR=$BACKGROUND_COLOR
UMAMI_WEBSITE_ID=$UMAMI_WEBSITE_ID
UMAMI_HOST=$UMAMI_HOST
CSP_FRAME_ANCESTORS=$CSP_FRAME_ANCESTORS

# Cloudflare Turnstile (optional — leave blank to disable)
CLOUDFLARE_TURNSTILE_SITE_KEY=$CLOUDFLARE_TURNSTILE_SITE_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=$CLOUDFLARE_TURNSTILE_SECRET_KEY
