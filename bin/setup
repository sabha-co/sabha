#!/usr/bin/env bash
set -eo pipefail

app_root="$(cd "$(dirname "$0")/.."; pwd)"
app_name=sabha

# Use application binstubs
export PATH="$app_root/bin:$PATH"

# Configure SaaS mode via Gemfile selection
if [ "$SAAS" = "true" ] || [ -f "$app_root/tmp/saas.txt" ]; then
  export BUNDLE_GEMFILE="${BUNDLE_GEMFILE:-$app_root/Gemfile.saas}"
fi

if [ "$RAILS_ENV" == "production" ]; then
  echo "RAILS_ENV is production; bailing out"
  exit
fi

# Install gum if needed
if ! command -v gum &>/dev/null; then
  echo
  echo "▸ Installing gum"
  if command -v brew &>/dev/null; then
    brew install gum
  elif command -v pacman &>/dev/null; then
    sudo pacman -S --noconfirm gum
  else
    echo "Please install gum: https://github.com/charmbracelet/gum"
    exit 1
  fi
  echo
fi

# Install mise if needed
if ! command -v mise &>/dev/null; then
  echo
  echo "▸ Installing mise"
  if command -v brew &>/dev/null; then
    brew install mise
  elif command -v pacman &>/dev/null; then
    sudo pacman -S --noconfirm mise
  else
    echo "Please install mise: https://mise.jdx.dev/installing-mise.html"
    exit 1
  fi

  if ! command -v mise &>/dev/null; then
    echo "mise installation failed"
    exit 1
  fi
  echo
fi

# Install gh if needed
if ! command -v gh &>/dev/null; then
  echo
  echo "▸ Installing GitHub CLI"
  if command -v brew &>/dev/null; then
    brew install gh
  elif command -v pacman &>/dev/null; then
    sudo pacman -S --noconfirm github-cli
  else
    echo "Please install GitHub CLI: https://github.com/cli/cli#installation"
    exit 1
  fi
  echo
fi

# Install anycable-go if needed. AnyCable is required to run Sabha locally
# (bin/dev boots it alongside Rails). It's not in most Linux package repos, so
# fall back to a pointer rather than failing setup — bin/dev preflights for it.
if ! command -v anycable-go &>/dev/null; then
  echo
  echo "▸ Installing anycable-go"
  if command -v brew &>/dev/null; then
    brew install anycable-go
  else
    echo "Please install anycable-go: https://docs.anycable.io/anycable-go/getting_started"
    echo "(AnyCable is required to run Sabha locally via bin/dev.)"
  fi
  echo
fi

step() {
  local step_name="$1"
  shift

  gum style --foreground 135 --bold "▸ $step_name"
  gum style --foreground 240 "$*"

  "$@"

  local exit_code=$?
  echo
  return $exit_code
}

echo
gum style --foreground 214 --bold "  ╔═══════════════╗  "
gum style --foreground 214 --bold "  ║    𝓈𝒶𝒷𝒽𝒶     ║  "
gum style --foreground 214 --bold "  ╚═══════════════╝  "
echo

# Install system packages
if command -v brew &>/dev/null; then
  packages=(sqlite3 ffmpeg vips gitleaks)
  if [ "$SAAS" = "true" ] || [ -f "$app_root/tmp/saas.txt" ]; then
    packages+=(libpq)
  fi
  missing_packages=()
  for pkg in "${packages[@]}"; do
    if ! brew list "$pkg" &>/dev/null; then
      missing_packages+=("$pkg")
    fi
  done
  if [ ${#missing_packages[@]} -gt 0 ]; then
    step "Installing packages" brew install "${missing_packages[@]}"
  fi
elif command -v pacman &>/dev/null; then
  packages=(sqlite ffmpeg libvips gitleaks)
  if [ "$SAAS" = "true" ] || [ -f "$app_root/tmp/saas.txt" ]; then
    packages+=(postgresql-libs)
  fi
  if ! pacman -Q "${packages[@]}" &>/dev/null; then
    step "Installing packages" sudo pacman -S --noconfirm --needed "${packages[@]}"
  fi
elif command -v apt-get &>/dev/null; then
  step "Installing packages" sudo apt-get install --no-install-recommends -y libsqlite3-0 ffmpeg libvips42
fi

step "Installing tools" mise install --yes
eval "$(mise hook-env -s bash)"

step "Installing RubyGems" bundle install

if command -v pnpm &>/dev/null; then
  step "Installing Node.js dependencies" pnpm install
elif command -v bun &>/dev/null; then
  step "Installing Node.js dependencies" bun install
else
  echo "Warning: pnpm not found. Install pnpm: npm install -g pnpm"
fi

step "Building CSS" pnpm run build:css

if [[ $* == *--reset* ]]; then
  rm -rf ./storage/{db,files,workspaces,untenanted}
  if [ "$SAAS" = "true" ] || [ -f "$app_root/tmp/saas.txt" ]; then
    step "Resetting database" rails db:drop db:create db:migrate
    step "Setting up SaaS" rails saas:setup
  else
    step "Resetting database" rails db:migrate:reset
  fi
else
  step "Preparing database" rails db:prepare
  if [ "$SAAS" = "true" ] || [ -f "$app_root/tmp/saas.txt" ]; then
    step "Setting up SaaS" rails saas:setup
  fi
fi

step "Cleaning up" rails log:clear tmp:clear
step "Restarting services" rails restart

if [ -d "$HOME/.puma-dev" ]; then
  gum style --foreground 135 --bold "▸ Configuring puma-dev"
  ln -nfs "$app_root" "$HOME/.puma-dev/$app_name"
  echo
fi

gum style --foreground 46 "✓ Done (${SECONDS}s)"
