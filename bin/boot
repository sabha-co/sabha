#!/usr/bin/env ruby

# Minimal process supervisor for running multiple services in a single container.
# Reads Procfile and spawns all defined processes (web, redis, workers).
# Restarts a process that dies (with crash-loop protection) so one crashing
# worker doesn't take the whole container down; forwards INT/TERM for graceful
# shutdown. Similar to Foreman/Overmind but simpler.

env = ENV["RAILS_ENV"]

# Pre-boot: prepare the database before spawning processes — workers need the
# Solid Queue tables before they start. Runs in every deployed env (production,
# performance, staging, …), not just production; skipped only in dev/test where
# bin/boot isn't the entrypoint. Absorbs what was previously bin/configure.
unless %w[development test].include?(env)
  # In SaaS mode, verify the storage volume is mounted before proceeding.
  # Without this check, tenant SQLite databases get written to ephemeral
  # container storage and are lost when the container is replaced.
  if ENV["SAAS"] == "true" && !system("mountpoint -q storage")
    abort "FATAL: storage/ is not a mounted volume. Tenant databases would be written to ephemeral container storage. Aborting."
  end

  system("mkdir -p storage/logs")
  abort("db:prepare failed") unless system("./bin/rails db:prepare")
end

require "yaml"

class MonitoredProcess
  # If a process crashes more than MAX_RESTARTS times within RESTART_WINDOW
  # seconds, stop restarting it and let the container exit so the orchestrator
  # (Docker/Kamal restart policy) replaces it — rather than spinning forever.
  MAX_RESTARTS = 5
  RESTART_WINDOW = 60

  attr_reader :name, :pid

  def initialize(name, cmd)
    @name, @cmd = name, cmd
    @restart_times = []
    @stopping = false
  end

  def start
    @pid = Process.spawn(@cmd)
  end

  def stop
    @stopping = true
    Process.kill("TERM", @pid) if @pid
  rescue Errno::ESRCH
    nil
  end

  # Called after @pid has exited. Returns true if restarted, false if it should
  # be given up on (intentional shutdown or crash loop).
  def restart
    return false if @stopping

    now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    @restart_times.reject! { |t| now - t > RESTART_WINDOW }
    @restart_times << now

    if @restart_times.size > MAX_RESTARTS
      warn "[boot] #{@name} crashed #{@restart_times.size} times in #{RESTART_WINDOW}s — giving up"
      return false
    end

    warn "[boot] #{@name} exited; restarting (#{@restart_times.size}/#{MAX_RESTARTS} within #{RESTART_WINDOW}s)"
    start
    true
  end
end

class ProcessMonitor
  def initialize(procfile)
    @procs = process_list(procfile)
    @stopping = false
    handle_signals
    @procs.each(&:start)
    supervise
  end

  private
    def process_list(procfile)
      config = YAML.load_file(procfile)

      # Skip workers process when SOLID_QUEUE_IN_PUMA=true (runs in Puma threads instead)
      config.delete("workers") if ENV["SOLID_QUEUE_IN_PUMA"] == "true"

      config.map { |name, cmd| MonitoredProcess.new(name, cmd) }
    end

    def handle_signals
      # Only real termination signals shut us down. A child death is handled by
      # the supervise loop (which restarts it) — NOT by tearing everything down,
      # which was the old SIGCHLD-trap cascade that killed the box when a single
      # process died under load.
      %w[INT TERM].each do |signal|
        Signal.trap(signal) do
          @stopping = true
          @procs.each(&:stop)
        end
      end
    end

    def supervise
      loop do
        begin
          pid = Process.wait
        rescue Errno::ECHILD
          break # no children left (finished shutting down)
        end

        proc = @procs.find { |p| p.pid == pid }
        next unless proc          # already reaped/unknown
        next if @stopping         # shutting down: keep reaping until ECHILD

        unless proc.restart
          # Crash loop or unrestartable: stop the rest and exit non-zero so the
          # orchestrator replaces the container instead of running degraded.
          @stopping = true
          @procs.each(&:stop)
          exit 1
        end
      end
    end
end

ProcessMonitor.new("Procfile")
