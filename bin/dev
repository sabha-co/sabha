#!/usr/bin/env sh

# Configure SaaS mode via Gemfile selection
if [ "$SAAS" = "true" ] || [ -f "tmp/saas.txt" ]; then
  export BUNDLE_GEMFILE="${BUNDLE_GEMFILE:-Gemfile.saas}"

  # Auto-load .env.multitenant if present (SaaS-only env like SSO_*).
  # Existing exports win; the file fills gaps only.
  if [ -f .env.multitenant ]; then
    set -a
    . ./.env.multitenant
    set +a
  fi
fi

# Auto-load .env.multitenant if present (used for SaaS-mode env like
# SSO_PROVIDER_CLIENTS). Existing exports win; the file fills gaps only.
if [ -f .env.multitenant ]; then
  set -a
  . ./.env.multitenant
  set +a
fi

export PORT="${PORT:-3000}"
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

# AnyCable is required: bin/dev boots anycable-go via Procfile.dev, so the binary
# must be on PATH. Fail fast with an actionable message instead of a cryptic
# foreman "command not found" and a half-broken real-time layer.
if ! command -v anycable-go >/dev/null 2>&1; then
  echo "anycable-go is not installed, but AnyCable is required to run Sabha locally."
  echo
  echo "Install it:"
  echo "  macOS:  brew install anycable-go"
  echo "  other:  https://docs.anycable.io/anycable-go/getting_started"
  echo
  echo "Then re-run bin/dev. (bin/setup installs it automatically on macOS.)"
  exit 1
fi

# Push gating reads presence over anycable-go's HTTP API, which first shipped in
# 1.6.9. Older binaries start fine and serve WebSockets fine — they just 404
# every presence read, so Rails falls back to the connected_at column and pushes
# members who are sitting in the room reading. Nothing raises, so preflight it.
ANYCABLE_MINIMUM_VERSION="1.6.9"
anycable_version="$(anycable-go --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"

if [ -z "$anycable_version" ]; then
  echo "Could not determine the anycable-go version; expected at least $ANYCABLE_MINIMUM_VERSION."
  echo "Continuing — presence-gated push will silently fall back if it's older."
elif [ "$(printf '%s\n' "$ANYCABLE_MINIMUM_VERSION" "$anycable_version" | sort -V | head -1)" != "$ANYCABLE_MINIMUM_VERSION" ]; then
  echo "anycable-go $anycable_version is too old — Sabha needs at least $ANYCABLE_MINIMUM_VERSION."
  echo
  echo "Its HTTP API (which push gating reads presence from) doesn't exist before"
  echo "$ANYCABLE_MINIMUM_VERSION. Real-time would still work, but every presence read would 404 and"
  echo "push would quietly notify people who are already reading the room."
  echo
  echo "Upgrade it:"
  echo "  macOS:  brew upgrade anycable-go"
  echo "  other:  https://docs.anycable.io/anycable-go/getting_started"
  exit 1
fi

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# AnyCable is required: dev always boots anycable-go alongside Rails.
exec foreman start -f Procfile.dev
