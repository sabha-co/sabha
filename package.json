{
  "name": "sabha",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19"
  },
  "scripts": {
    "build:css": "pnpm exec tailwindcss -i app/javascript/entrypoints/application.css -o app/assets/builds/tailwind.css --minify",
    "build:css:watch": "pnpm exec tailwindcss -i app/javascript/entrypoints/application.css -o app/assets/builds/tailwind.css --watch"
  }
}
